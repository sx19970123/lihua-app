import { MineSlice, MineSliceAsync, PrepareEngine, EngineName } from '../interface.uts'

/**
 * 分片挖矿：CryptoKit 实现
 */
export const mineSlice : MineSlice = function (saltHex : string, targetHex : string, start : number, maxTries : number) : number {
    if (targetHex.length * 4 > 32) {
        // UTS 函数类型无 throws 标注，超范围以 -2 哨兵返回（JS 版为 throw，调用方难度恒 ≤8 不可达）
        console.error("POW 难度超出支持范围")
        return -2
    }
    return PowMiner.mineSliceSwift(saltHex = saltHex, targetHex = targetHex, start = start, maxTries = maxTries)
}

/**
 * 后台分片挖矿：后台队列计算，结果回主线程回调
 */
export const mineSliceAsync : MineSliceAsync = function (saltHex : string, targetHex : string, start : number, maxTries : number, onDone : (found : number) => void) : boolean {
    if (targetHex.length * 4 > 32) {
        // 超范围交同步路径按 -2 哨兵处理
        console.error("POW 难度超出支持范围")
        return false
    }
    PowMiner.mineSliceAsyncSwift(saltHex = saltHex, targetHex = targetHex, start = start, maxTries = maxTries, onDone = onDone)
    return true
}

/**
 * 原生引擎恒就绪
 */
export const prepareEngine : PrepareEngine = function () : Promise<boolean> {
    return Promise.resolve(true)
}

export const engineName : EngineName = function () : string {
    return "native"
}
