import { HasNativeMask, ShowMask, SetMaskAlpha, HideMask, MaskStrip } from '../interface.uts'
import { MaskOverlay } from 'uts.sdk.modules.lihuaMask'

export const hasNativeMask : HasNativeMask = function () : boolean {
	return true
}

// 条带数组拍平成 [top, bottom, …]：跨 Kotlin 只传基础类型
export const showMask : ShowMask = function (strips : MaskStrip[], alpha : number, onTap : () => void) : void {
	const rects : number[] = []
	for (let i = 0; i < strips.length; i++) {
		rects.push(strips[i].top, strips[i].bottom)
	}
	MaskOverlay.showKotlin(rects, alpha, function () {
		onTap()
	})
}

export const setMaskAlpha : SetMaskAlpha = function (alpha : number) : void {
	MaskOverlay.setAlphaKotlin(alpha)
}

export const hideMask : HideMask = function () : void {
	MaskOverlay.hideKotlin()
}
