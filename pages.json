	// 底部液态玻璃 tabbar：iOS 26+ 系统 Liquid Glass（15-25 毛玻璃降级，材质随系统版本），
	// 图标仅支持图片（iconfont 不可用）——uni-icons 字形渲染 PNG 明暗/选中四态经 theme.json 切换
	"tabBar": {
		"color": "@tabColor",
		"selectedColor": "@tabSelectedColor",
		"backgroundColor": "@tabBgColor",
		"borderStyle": "@tabBorderStyle",
		"glassEffect": true,
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页",
				"iconPath": "@tabHomeIcon",
				"selectedIconPath": "@tabHomeIconSel"
			},
			{
				"pagePath": "pages/mine/mine",
				"text": "我的",
				"iconPath": "@tabMineIcon",
				"selectedIconPath": "@tabMineIconSel"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "@navTxtStyle",
		"navigationBarTitleText": "uni-app x",
		"navigationBarBackgroundColor": "@navBgColor",
		"backgroundColorContent": "@bgColor"
	},
	"uniIdRouter": {}
}
