{
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://doc.dcloud.net.cn/uni-app-x/collocation/pagesjson.html
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "首页"
			}
		},
		{
			"path": "pages/mine/mine",
			"style": {
				"navigationBarTitleText": "我的"
			}
		},
		{
			"path": "pages/login/Login",
			"style": {
				"navigationStyle": "custom",
				"disableScroll": true
			}
		},
		{
			"path": "pages/login/Register",
			"style": {
				"navigationStyle": "custom",
				"disableScroll": true
			}
		},
		{
			"path": "pages/user-setup/UserSetup",
			"style": {
				"navigationStyle": "custom",
				"disableScroll": true,
				"disableSwipeBack": true
			}
		},
		{
			"path": "pages/component/menu",
			"style": {
				"navigationBarTitleText": "组件"
			}
		},
		{
			"path": "pages/component/card",
			"style": {
				"navigationBarTitleText": "app-card"
			}
		},
		{
			"path": "pages/component/input",
			"style": {
				"navigationBarTitleText": "app-input"
			}
		},
		{
			"path": "pages/component/checkbox",
			"style": {
				"navigationBarTitleText": "app-checkbox"
			}
		},
		{
			"path": "pages/component/checkbox-group",
			"style": {
				"navigationBarTitleText": "app-checkbox-group"
			}
		},
		{
			"path": "pages/component/segmented",
			"style": {
				"navigationBarTitleText": "app-segmented"
			}
		},
		{
			"path": "pages/component/list",
			"style": {
				"navigationBarTitleText": "app-list"
			}
		},
		{
			"path": "pages/component/swipe-action",
			"style": {
				"navigationBarTitleText": "app-swipe-action"
			}
		},
		{
			"path": "pages/component/tree",
			"style": {
				"navigationBarTitleText": "app-tree"
			}
		},
		{
			"path": "pages/component/steps",
			"style": {
