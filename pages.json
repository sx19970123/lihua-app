		{
			"path": "pages/component/captcha",
			"style": {
				"navigationBarTitleText": "captcha"
			}
		},
		{
			"path": "pages/component/mask",
			"style": {
				"navigationBarTitleText": "app-mask"
			}
		},
		{
			"path": "pages/component/sheet",
			"style": {
				"navigationBarTitleText": "app-sheet"
			}
		},
		{
			"path": "pages/protocol/UserAgreement",
			"style": {
				"navigationBarTitleText": "用户协议"
			}
		},
		{
			"path": "pages/protocol/PrivacyPolicy",
			"style": {
				"navigationBarTitleText": "隐私政策"
			}
		}
