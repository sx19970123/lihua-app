<template>
	<!-- 无导航栏（各步自带大标题）；安全区由 .safe-top 让位，步进轨道占余下满高 -->
	<view class="setup-page safe-top">
		<!-- 步骤挂载门闩：initUserInfo 完成后再渲染步骤（默认部门步依赖的 deptTrees 尚未就绪） -->
		<AppSteps v-if="initialized" :current="current" :count="steps.length">
			<view v-for="step in steps" :key="step" class="setup-step-slot" :style="slotStyle">
				<UserSetupStart v-if="step === 'start'" @next="handleNext(step)" @go-login="handleGoLogin" />
				<UserSetupResetPassword v-else-if="step === 'UserSetupResetPassword'" @next="handleNext(step)" @prev="handlePrev" />
				<UserSetupUserBasics v-else-if="step === 'UserSetupUserBasics'" @next="handleNext(step)" @prev="handlePrev" />
				<UserSetupDefaultDept v-else-if="step === 'UserSetupDefaultDept'" @next="handleNext(step)" @skip="handleNext(step)" @prev="handlePrev" />
				<UserSetupComplete v-else-if="step === 'complete'" @complete="handleFinish" @prev="handlePrev" />
				<view class="setup-bottom-safe" />
			</view>
		</AppSteps>
	</view>
</template>

<script setup lang="ts">
	// 登录后初始设置向导（postLoginCheck 待补全项驱动，步骤常驻挂载=回退已填内容保留）
	import { useUserStore } from '@/stores/user'
	import { toastRequestError } from '@/utils/toast'
	import { getData, removeDataItem, clearData } from '@/helpers/user-setup'
	import type { UserSetupItem } from '@/helpers/user-setup'
	import AppSteps from '@/components/app-steps/app-steps.uvue'
	import UserSetupStart from '@/components/user-setup/UserSetupStart.uvue'
	import UserSetupResetPassword from '@/components/user-setup/UserSetupResetPassword.uvue'
	import UserSetupUserBasics from '@/components/user-setup/UserSetupUserBasics.uvue'
	import UserSetupDefaultDept from '@/components/user-setup/UserSetupDefaultDept.uvue'
	import UserSetupComplete from '@/components/user-setup/UserSetupComplete.uvue'

	const userStore = useUserStore()

	// 已知待补全项（后端值域；未知值剔除，防后端新增类型时旧版卡在无渲染步骤）
	const KNOWN_ITEMS: UserSetupItem[] = ['UserSetupResetPassword', 'UserSetupUserBasics', 'UserSetupDefaultDept']

	/**
	 * 步骤编排：序列固定首尾 + 暂存中的待补全项，按钮是唯一驱动方式
	 */
	const initSteps = () => {
		// 登录成功时写入暂存，杀 App 重启后恢复剩余步骤
		const steps = ['start', ...getData().filter(item => KNOWN_ITEMS.includes(item as UserSetupItem)), 'complete']

		// 当前步骤下标（受控）
		const current = ref<number>(0)

		// 轨道单步槽位宽（count 固定，一次性计算）
		const slotStyle = { width: (100 / steps.length) + '%' }

		// 前进（skip 复用）：内容步先从暂存剔除，杀 App 重启后不重复已完成步骤
		const handleNext = (step: string) => {
			if (KNOWN_ITEMS.includes(step as UserSetupItem)) {
				removeDataItem(step)
			}
			current.value += 1
		}

		// 后退（步骤常驻挂载，已填内容保留）
		const handlePrev = () => {
			current.value = Math.max(0, current.value - 1)
		}

		return { steps, current, slotStyle, handleNext, handlePrev }
	}

	const { steps, current, slotStyle, handleNext, handlePrev } = initSteps()

	/**
	 * 生命周期：用户信息初始化门闩 + 返回拦截
	 */
	const initLifecycle = () => {
		const initialized = ref<boolean>(false)

		onLoad(async () => {
			try {
				await userStore.initUserInfo()
			} catch (err) {
				// 失败不阻断：空部门树仍可走其余步骤，返回登录可离场；登录态异常由 401 拦截兜底
				console.error("向导页用户信息初始化失败", err)
				toastRequestError(err)
			}
			initialized.value = true
		})

		// 拦截物理返回/侧滑，流程只能前进或经「返回登录」离场
		onBackPress(() => true)

		return { initialized }
	}

	const { initialized } = initLifecycle()

	/**
	 * 完成与离场
	 */
	const initFinish = () => {
		// 完成进入系统：清暂存（向导已 initUserInfo，首页守卫懒加载项待后续迁移补齐：
		// S1-08 webSocket.connect / S2-02 未读数拉取 + initDict("sys_notice_type")）
		const handleFinish = () => {
			clearData()
			uni.reLaunch({ url: "/pages/index/index" })
		}

		// 退出登录离场：清暂存防残留（token 清理与回登录页由 store 完成）
		const handleGoLogin = async () => {
			clearData()
			await userStore.handleLogout()
		}

		return { handleFinish, handleGoLogin }
	}

	const { handleFinish, handleGoLogin } = initFinish()
</script>

<style lang="scss">
@import "@/styles/user-setup.scss";
</style>
