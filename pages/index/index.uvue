<template>
	<view class="page-padding">
		<text class="title">P0 尖峰验证</text>
		<view class="card">
			<text class="label">V1 · Pinia（npm 依赖 + 组合式 store）</text>
			<text class="value">count = {{ counter.count }}</text>
			<button class="btn" type="primary" @tap="counter.increment">count + 1</button>
		</view>
		<view class="card">
			<text class="label">V2 · 编译期环境变量（process.env 注入）</text>
			<text class="value">BASE_API = {{ baseUrl }}</text>
			<text class="value">NODE_ENV = {{ nodeEnv }}</text>
		</view>
		<view class="card">
			<text class="label">导航 · 登录页跳转（③ 联调入口）</text>
			<button class="btn" type="primary" @tap="goLogin">前往登录页</button>
		</view>
		<view class="card">
			<text class="label">导航 · 初始设置向导（S2-11 测试入口）</text>
			<button class="btn" type="primary" @tap="goUserSetupTest">呼出向导（预写全量待补全项）</button>
		</view>
		<view class="card">
			<text class="label">POW · UTS 原生挖矿端到端（④ 尖峰：对拍→取码→挖矿→提交）</text>
			<text class="value">状态：{{ powState }}</text>
			<text class="value">引擎：{{ powEngine }}</text>
			<text class="value">进度：{{ powProgress }}</text>
			<text class="value">耗时：{{ powTiming }}</text>
			<text class="value">对拍：{{ powCrossCheck }}</text>
			<button class="btn" type="primary" :loading="powRunning" :disabled="powRunning" @tap="runPow">取码→挖矿→提交</button>
		</view>
		<view class="card">
			<text class="label">WS · 连接测试（S1-08 尖峰：连接/状态三态/通知接收）</text>
			<text class="value">状态：{{ wsStatus }}</text>
			<text class="value">最近通知：{{ wsNotice }}</text>
			<button class="btn" type="primary" @tap="wsConnect">连接</button>
			<button class="btn" @tap="wsManualReconnect">手动重连</button>
			<button class="btn" @tap="wsClose">主动关闭</button>
		</view>
		<view class="card">
			<text class="label">液态玻璃 · glass-effect-view（iOS 26+ 液态玻璃、iOS 15-25 降级系统毛玻璃；Web/安卓/微信官方未支持——本卡无条件编译，直接观察各端表现）</text>
			<text class="value">interactive：{{ glassInteractive ? '开' : '关' }}　tint：{{ glassTintName }}　点击计数：{{ glassTaps }}</text>
			<view class="glass-stage">
				<view class="glass-stage-body">
					<text class="glass-caption">GLASS · regular / clear / tint / radius / 嵌套</text>
					<view class="glass-panel-row">
						<glass-effect-view class="glass-panel" glass-style="regular" :interactive="glassInteractive" :tint-color="glassTint" @click="onGlassTap">
							<view class="glass-panel-inner">
								<text class="glass-panel-title">regular</text>
								<text class="glass-panel-detail">tint：{{ glassTintName }}</text>
								<glass-effect-view class="glass-chip" glass-style="clear">
									<text class="glass-chip-text">嵌套玻璃</text>
								</glass-effect-view>
							</view>
						</glass-effect-view>
						<glass-effect-view class="glass-panel glass-panel-r" glass-style="clear" :interactive="glassInteractive" :tint-color="glassTint">
							<view class="glass-panel-inner">
								<text class="glass-panel-title">clear</text>
								<text class="glass-panel-detail">tint：{{ glassTintName }}</text>
							</view>
						</glass-effect-view>
					</view>
					<view class="glass-shape-row">
						<glass-effect-view class="glass-shape-circle" glass-style="regular" :interactive="glassInteractive"></glass-effect-view>
						<glass-effect-view class="glass-shape-pill" glass-style="clear" :interactive="glassInteractive"></glass-effect-view>
						<glass-effect-view class="glass-shape-rect" glass-style="regular" :interactive="glassInteractive"></glass-effect-view>
					</view>
				</view>
			</view>
			<view class="glass-stage glass-drag-stage" ref="dragStageEl" @touchstart="onDragStart" @touchmove.stop.prevent="onDragMove">
				<glass-effect-view class="glass-ball" glass-style="clear" :interactive="glassInteractive" :style="dragStyle"></glass-effect-view>
				<text class="glass-hint">按住任意位置拖动圆片（transform 直绑玻璃自身）</text>
			</view>
			<view class="glass-controls">
				<button class="btn glass-ctl-btn" @tap="toggleInteractive">interactive 开/关</button>
				<button class="btn glass-ctl-btn glass-ctl-btn-r" @tap="cycleTint">切换 tint</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
import { useCounterStore } from '@/stores/counter'
import { BASE_API, IS_DEV } from '@/utils/env'
import { getCaptchaData, check } from '@/api/system/captcha/captcha'
import { sha256Hex, mineSlice as mineSliceJs, prngHex } from '@/components/captcha/pow/sha256'
import { mineSlice, prepareEngine, engineName } from '@/uni_modules/lihua-pow'
import { webSocket, wsStatus } from '@/utils/web-socket'
import { setData as setUserSetupData, goUserSetup } from '@/helpers/user-setup'

const counter = useCounterStore()
const baseUrl = BASE_API
const nodeEnv = IS_DEV ? 'development' : 'production'


const goLogin = () => {
	uni.navigateTo({ url: '/pages/login/Login' })
}

// ---------- WS 连接测试 ----------
const wsNotice = ref('—')
webSocket.addEventListener('WS_NOTICE', (data: any) => {
	wsNotice.value = JSON.stringify(data).slice(0, 60)
})
const wsConnect = () => {
	webSocket.connect()
}
const wsManualReconnect = () => {
	webSocket.manualReconnect()
}
const wsClose = () => {
	webSocket.closeConnect()
}

// 向导测试入口：预写全量待补全项，向导恒显五步（未登录时向导 initUserInfo 会 401 跳回登录页）
const goUserSetupTest = () => {
	setUserSetupData(['UserSetupResetPassword', 'UserSetupUserBasics', 'UserSetupDefaultDept'])
	goUserSetup()
}

// ---------- POW 端到端 ----------
const powState = ref('未执行')
const powProgress = ref('—')
const powTiming = ref('—')
const powCrossCheck = ref('—')
const powEngine = ref('—')
const powRunning = ref(false)
const SLICE_TRIES = 50000

// ASCII 串转字节（POW 输入恒为 ASCII，sha256Hex 收 Uint8Array）
const asciiBytes = (s : string) : Uint8Array => {
	const bytes = new Uint8Array(s.length)
	for (let i = 0; i < s.length; i++) {
		bytes[i] = s.charCodeAt(i)
	}
	return bytes
}

const runPow = async () => {
	if (powRunning.value) {
		return
	}
	powRunning.value = true
	powState.value = '引擎准备...'
	powProgress.value = '—'
	powTiming.value = '—'
	powCrossCheck.value = '—'
	powEngine.value = '—'
	try {
		// 引擎准备：App=原生恒就绪；Web/微信=wasm 可用则加速，否则纯 JS 回退
		await prepareEngine()
		powEngine.value = engineName()

		// 对拍：以真实摘要构造必然命中的 target，JS/UTS 两引擎必须返回同一 nonce
		const probeSalt = 'e5f60718a1b2c3d4'
		const probeNonce = 12345
		const probeTarget = sha256Hex(asciiBytes(probeSalt + probeNonce)).slice(0, 4)
		const jsNonce = mineSliceJs(probeSalt, probeTarget, 0, 20000)
		const probeStart = Date.now()
		const utsNonce = mineSlice(probeSalt, probeTarget, 0, 20000)
		const probeMs = Date.now() - probeStart
		if (jsNonce !== probeNonce || utsNonce !== probeNonce) {
			powCrossCheck.value = `不一致：JS=${jsNonce} UTS=${utsNonce} 期望=${probeNonce}`
			powState.value = '对拍失败 ✗'
			return
		}
		powCrossCheck.value = `JS=${jsNonce} UTS=${utsNonce} ✓（UTS 探针 ${probeMs}ms/2 万次）`

		// 取验证码（后台需将验证码类型设为 POW）
		powState.value = '请求验证码...'
		const resp = await getCaptchaData()
		if (resp.code !== 200 || !resp.data) {
			powState.value = `获取失败 code=${resp.code}`
			return
		}
		const captchaId = resp.data.id
		const powParam = resp.data.data?.POW
		if (resp.data.type !== 'POW' || !powParam) {
			powState.value = `非 POW 类型（${resp.data.type ?? '未知'}），后台需切换验证码类型`
			return
		}
		const [difficulty, saltLen, num] = powParam
		const startTime = Date.now()
		// 与后端 CapPowVerifier 同款派生：salt=prng(token+(i+1))、target=prng(token+(i+1)+"d")
		const solutions : number[] = []
		let solved = 0
		let totalTries = 0
		const miningStart = Date.now()
		for (let i = 0; i < num; i++) {
			const saltHex = prngHex(`${captchaId}${i + 1}`, saltLen)
			const targetHex = prngHex(`${captchaId}${i + 1}d`, difficulty)
			let cursor = 0
			while (true) {
				const found = mineSlice(saltHex, targetHex, cursor, SLICE_TRIES)
				if (found >= 0) {
					solutions.push(found)
					totalTries += found - cursor + 1
					solved++
					powProgress.value = `${solved}/${num}`
					break
				}
				cursor += SLICE_TRIES
				totalTries += SLICE_TRIES
				// 片间让出主线程，进度可见
				await new Promise((r) => setTimeout(r, 0))
			}
		}
		const miningMs = Date.now() - miningStart
		powTiming.value = `${miningMs}ms（≈${(totalTries / 1000).toFixed(0)}k 次哈希，${(totalTries / miningMs).toFixed(0)} kH/s）`

		// 提交校验（占位轨迹+固定宽高为后端公共前置校验要求，nonce 串在 data 字段）
		powState.value = '提交校验...'
		const checkResp = await check({
			id: captchaId,
			data: {
				bgImageWidth: 318,
				bgImageHeight: 180,
				startTime: startTime,
				stopTime: Date.now(),
				trackList: [{ x: 0, y: 0, type: '', t: 0 }],
				data: solutions.join('-')
			}
		})
		if (checkResp.code === 200 && checkResp.success) {
			powState.value = '验证通过 ✓'
		} else {
			powState.value = `验证失败 code=${checkResp.code} msg=${checkResp.msg}`
		}
	} catch (err) {
		console.error('POW 测试异常', err)
		powState.value = `异常：${err}`
	} finally {
		powRunning.value = false
	}
}

// ---------- 液态玻璃 demo ----------
const glassInteractive = ref(false)
const glassTaps = ref(0)
const glassTints = ['transparent', 'rgba(255, 59, 48, 0.25)', 'rgba(0, 122, 255, 0.25)', 'rgba(52, 199, 89, 0.25)']
const glassTintNames = ['无', '红', '蓝', '绿']
const glassTintIndex = ref(0)
const glassTint = computed(() : string => glassTints[glassTintIndex.value])
const glassTintName = computed(() : string => glassTintNames[glassTintIndex.value])
const toggleInteractive = () => {
	glassInteractive.value = !glassInteractive.value
}
const cycleTint = () => {
	glassTintIndex.value = (glassTintIndex.value + 1) % glassTints.length
}
const onGlassTap = () => {
	glassTaps.value++
}

// 拖拽圆片：transform 直绑玻璃元素，位置钳制在拖拽区内
const DRAG_BALL_SIZE = 64
const dragStageEl = ref<UniElement | null>(null)
const dragX = ref(90)
const dragY = ref(56)
const dragStyle = computed(() : string => `transform: translate(${dragX.value}px, ${dragY.value}px)`)
let dragRect : DOMRect | null = null
let grabDX = 0
let grabDY = 0

const onDragStart = (e : TouchEvent) => {
	try {
		dragRect = dragStageEl.value?.getBoundingClientRect() ?? null
	} catch (err) {
		dragRect = null
	}
	if (dragRect == null) {
		return
	}
	const t = e.touches[0]
	grabDX = t.clientX - dragRect.left - dragX.value
	grabDY = t.clientY - dragRect.top - dragY.value
}

const onDragMove = (e : TouchEvent) => {
	const rect = dragRect
	if (rect == null) {
		return
	}
	const t = e.touches[0]
	dragX.value = Math.min(Math.max(t.clientX - rect.left - grabDX, 0), rect.width - DRAG_BALL_SIZE)
	dragY.value = Math.min(Math.max(t.clientY - rect.top - grabDY, 0), rect.height - DRAG_BALL_SIZE)
}
</script>

<style>
	.title {
		font-size: 18px;
		font-weight: bold;
		color: #333333;
	}

	.card {
		margin-top: 12px;
		padding: 12px;
		background-color: #f5f5f5;
		border-radius: 6px;
	}

	.label {
		font-size: 13px;
		color: #999999;
	}

	.value {
		margin-top: 6px;
		font-size: 14px;
		color: #333333;
	}

	.btn {
		margin-top: 8px;
	}

	.glass-stage {
		position: relative;
		margin-top: 10px;
		border-radius: 12px;
		background-image: linear-gradient(to right, #ff453a, #ffd60a, #30d158, #0a84ff, #bf5af2);
	}

	.glass-drag-stage {
		height: 190px;
		background-image: linear-gradient(to right, #ff9f0a, #ff375f, #bf5af2, #64d2ff, #32d74b);
	}

	.glass-stage-body {
		padding: 12px;
	}

	.glass-caption {
		font-size: 13px;
		font-weight: bold;
		color: #ffffff;
		margin-bottom: 10px;
	}

	.glass-panel-row {
		flex-direction: row;
	}

	.glass-panel {
		flex: 1;
		height: 130px;
		border-radius: 20px;
	}

	.glass-panel-r {
		margin-left: 12px;
	}

	.glass-panel-inner {
		flex: 1;
		align-items: center;
		justify-content: center;
	}

	.glass-panel-title {
		font-size: 20px;
		font-weight: bold;
		color: #111111;
	}

	.glass-panel-detail {
		margin-top: 4px;
		font-size: 12px;
		color: #222222;
	}

	.glass-chip {
		margin-top: 8px;
		width: 96px;
		height: 28px;
		border-radius: 14px;
	}

	.glass-chip-text {
		font-size: 12px;
		color: #222222;
	}

	.glass-shape-row {
		flex-direction: row;
		margin-top: 12px;
		align-items: center;
	}

	.glass-shape-circle {
		width: 56px;
		height: 56px;
		border-radius: 28px;
	}

	.glass-shape-pill {
		width: 130px;
		height: 44px;
		border-radius: 22px;
		margin-left: 14px;
	}

	.glass-shape-rect {
		width: 90px;
		height: 56px;
		border-radius: 14px;
		margin-left: 14px;
	}

	.glass-ball {
		position: absolute;
		left: 0;
		top: 0;
		width: 64px;
		height: 64px;
		border-radius: 32px;
	}

	.glass-hint {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 8px;
		text-align: center;
		font-size: 12px;
		color: #ffffff;
	}

	.glass-controls {
		flex-direction: row;
		margin-top: 10px;
	}

	.glass-ctl-btn {
		flex: 1;
	}

	.glass-ctl-btn-r {
		margin-left: 8px;
	}

</style>
