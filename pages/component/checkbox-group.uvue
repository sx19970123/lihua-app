<template>
	<view class="page-padding">
		<app-card>
			<text class="demo-label">受控模式（v-model 值集合）</text>
			<view class="demo-row">
				<app-checkbox-group v-model="groupValues">
					<app-checkbox value="a" label="选项 A" />
					<app-checkbox value="b" label="选项 B" />
					<app-checkbox value="c" label="选项 C（disabled）" disabled />
				</app-checkbox-group>
			</view>
			<text class="demo-value">selected = {{ groupValuesText }}</text>
		</app-card>

		<app-card class="demo-card">
			<text class="demo-label">组级 size：子项未传时沿用组，子项自传优先</text>
			<view class="demo-row">
				<app-checkbox-group v-model="smallValues" size="small">
					<app-checkbox value="a" label="小号 A" />
					<app-checkbox value="b" label="小号 B" />
				</app-checkbox-group>
			</view>
			<view class="demo-row">
				<app-checkbox-group v-model="largeValues" size="large">
					<app-checkbox value="a" label="大号 A" />
					<app-checkbox value="b" label="大号 B（子项自传 small）" size="small" />
				</app-checkbox-group>
			</view>
			<text class="demo-value">small = {{ smallText }} / large = {{ largeText }}</text>
		</app-card>
	</view>
</template>

<script setup lang="ts">
	import AppCard from '@/components/app-card/app-card.uvue'
	import AppCheckbox from '@/components/app-checkbox/app-checkbox.uvue'
	import AppCheckboxGroup from '@/components/app-checkbox-group/app-checkbox-group.uvue'

	// group 受控模式（c 项 disabled 不可勾选）
	const groupValues = ref<string[]>([])
	// 组级 size 两组
	const smallValues = ref<string[]>(['a'])
	const largeValues = ref<string[]>([])

	const joinText = (values : string[]) : string => values.length > 0 ? values.join(', ') : '（空）'
	const groupValuesText = computed(() : string => joinText(groupValues.value))
	const smallText = computed(() : string => joinText(smallValues.value))
	const largeText = computed(() : string => joinText(largeValues.value))
</script>

<style lang="scss">
	@import '@/styles/demo.scss';
</style>
