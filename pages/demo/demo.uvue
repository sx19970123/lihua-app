<template>
	<view class="page-padding">
		<text class="title">组件示例</text>

		<app-card class="demo-card" title="卡片标题" extra="附加信息" footer="底部说明">
			<text class="demo-body-text">三区完整卡片：header（title + extra）/ body / footer，区间自带分隔线</text>
		</app-card>

		<app-card class="demo-card">
			<text class="demo-body-text">纯内容卡（title/extra/footer 全空自动省略头脚与分隔线），app-tree 即此形态</text>
		</app-card>

		<app-card class="demo-card" title="可点击卡片" hover @click="onCardClick">
			<text class="demo-body-text">hover 开启按压反馈，click = {{ cardClickCount }}</text>
		</app-card>

		<app-card class="demo-card">
			<text class="label">app-checkbox · 独立模式（v-model:checked）</text>
			<view class="row">
				<app-checkbox v-model:checked="single" label="记住账号" />
			</view>
			<text class="value">checked = {{ single }}</text>
		</app-card>

		<app-card class="demo-card">
			<text class="label">app-checkbox-group · 受控模式（v-model 值集合）</text>
			<app-checkbox-group v-model="groupValues">
				<app-checkbox value="a" label="选项 A" />
				<app-checkbox value="b" label="选项 B" />
				<app-checkbox value="c" label="选项 C（disabled）" disabled />
			</app-checkbox-group>
			<text class="value">selected = {{ groupValuesText }}</text>
		</app-card>

		<app-card class="demo-card">
			<text class="label">app-input · 基础（v-model + clearable）</text>
			<view class="row">
				<app-input v-model="inputText" placeholder="请输入内容" clearable />
			</view>
			<text class="value">value = {{ inputText || '（空）' }}</text>
		</app-card>

		<app-card class="demo-card">
			<text class="label">app-input · 密码（maxlength + showCount + showStrength）</text>
			<view class="row">
				<app-input v-model="inputPwd" password maxlength="12" showCount showStrength placeholder="密码（≤12 位）" />
			</view>
			<text class="value">length = {{ inputPwd.length }}</text>
		</app-card>

		<app-card class="demo-card">
			<text class="label">app-input · 密码 + blur 事件（失焦回显次数）</text>
			<view class="row">
				<app-input v-model="inputBlur" password placeholder="密码（失焦触发 blur）" @blur="onInputBlur" />
			</view>
			<text class="value">blur count = {{ inputBlurCount }}</text>
		</app-card>

		<text class="label demo-tree-label">app-tree · 带检索（filterable + defaultExpandAll + @select）</text>
		<app-tree :data="demoTree" v-model:current="treeCurrent" default-expand-all filterable
			@select="onTreeSelect" />
		<text class="value">current = {{ treeCurrent || '（未选）' }}</text>

		<text class="label demo-tree-label">app-tree · 无检索（defaultExpandAll + @select）</text>
		<app-tree :data="demoTree" v-model:current="treeCurrent2" default-expand-all @select="onTreeSelect2" />
		<text class="value">current = {{ treeCurrent2 || '（未选）' }}</text>

		<app-card class="demo-card">
			<text class="label">Captcha · 弹窗验证码（ref.open + @success）</text>
			<view class="row">
				<button type="primary" @click="openCaptcha">打开验证码</button>
			</view>
			<text class="value">result = {{ captchaResult }}</text>
			<!-- proxy 模式挂载：App/Web 开 dialogPage，微信直渲，业务方无感 -->
			<Captcha ref="captchaRef" themeLight="#b48d4d" themeDark="#9a7a40" @success="onCaptchaSuccess" />
		</app-card>
	</view>
</template>

<script setup lang="ts">
import AppCard from '@/components/app-card/app-card.uvue'
import AppCheckbox from '@/components/app-checkbox/app-checkbox.uvue'
import AppCheckboxGroup from '@/components/app-checkbox-group/app-checkbox-group.uvue'
import AppInput from '@/components/app-input/app-input.uvue'
import AppTree from '@/components/app-tree/app-tree.uvue'
import Captcha from '@/components/captcha/captcha.uvue'

// app-card hover 点击计数
const cardClickCount = ref<number>(0)
const onCardClick = () => {
	cardClickCount.value++
}

// 独立模式
const single = ref<boolean>(false)

// group 受控模式（c 项 disabled 不可勾选）
const groupValues = ref<string[]>([])

const groupValuesText = computed(() => groupValues.value.length > 0 ? groupValues.value.join(', ') : '（空）')

// input 基础
const inputText = ref<string>('')
const inputPwd = ref<string>('')
const inputBlur = ref<string>('')
const inputBlurCount = ref<number>(0)

const onInputBlur = () => {
	inputBlurCount.value++
}

// app-tree 示例数据（key 全树唯一——组件契约，重复 key 致过滤失效/diff 崩溃）
const demoTree = [
	{
		key: 'hq', title: '狸花猫科技', children: [
			{
				key: 'hq-rd', title: '研发部', children: [
					{ key: 'hq-rd-fe', title: '前端组' },
					{ key: 'hq-rd-be', title: '后端组' }
				]
			},
			{ key: 'hq-pd', title: '产品部' },
			{ key: 'hq-hr', title: '人事部' }
		]
	},
	{
		key: 'sh', title: '上海分公司', children: [
			{
				key: 'sh-rd', title: '研发部', children: [
					{ key: 'sh-rd-fe', title: '前端组' }
				]
			},
			{ key: 'sh-sale', title: '销售部' }
		]
	}
]
const treeCurrent = ref<string>('')
const onTreeSelect = (key : string) => {
	treeCurrent.value = key
}
const treeCurrent2 = ref<string>('')
const onTreeSelect2 = (key : string) => {
	treeCurrent2.value = key
}

// captcha 弹窗（proxy 模式：open 触发，success 回执校验通过的后端 id）
const captchaRef = ref<any>(null)
const captchaResult = ref<string>('（未验证）')
const openCaptcha = () => {
	captchaRef.value?.open()
}
const onCaptchaSuccess = (id : string) => {
	captchaResult.value = `验证成功，id=${id}`
}
</script>

<style>
	.title {
		font-size: 18px;
		font-weight: bold;
		color: var(--lh-emphasis-color);
	}

	/* 外部 class 落 app-card 根（隔离 2.0 单根组件），间距归消费方 */
	.demo-card {
		margin-top: 16px;
	}

	.demo-body-text {
		font-size: 14px;
		line-height: var(--lh-leading-normal);
		color: var(--lh-emphasis-color);
	}

	.label {
		font-size: 13px;
		color: var(--lh-tertiary-color);
	}

	.row {
		margin-top: 12px;
	}

	.value {
		margin-top: 8px;
		font-size: 14px;
		color: var(--lh-emphasis-color);
	}

	/* 树示例不套外卡（自带卡片壳），标签直接落页面：与上方卡片的间距+与树的间距 */
	.demo-tree-label {
		margin-top: 16px;
		margin-bottom: 12px;
	}
</style>
