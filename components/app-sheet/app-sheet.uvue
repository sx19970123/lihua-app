<template>
	<view class="app-sheet">
		<!-- 遮罩与面板同父兄弟、同为 fixed，层序靠显式 z-index（面板高于 app-mask 的 999） -->
		<app-mask v-if="overlay" ref="maskEl" @click="onMaskClick" @backpress="onMaskClick" />
		<!-- 面板与淡入层取元素：小程序不用模板 ref（真机上带 ref 的元素逐帧改样式会中断拖动），位移走 :style 载体；App 用模板 ref，Web 按 id 取 -->
		<!-- #ifdef MP-WEIXIN -->
		<!-- 小程序：面板内的触摸移动在面板根就地拦下（catch），页面不跟着滚、外层滚动条不出现；面板自身的手势照常在这里处理。
			 子级 scroll-view 自己接管内部滚动，不受影响 -->
		<view :id="panelId" class="app-sheet-panel" :class="panelCls" :style="panelStyle"
			@touchstart="onTouchStart" @touchmove.stop="onTouchMove" @touchend="onTouchEnd" @touchcancel="onTouchCancel">
		<!-- #endif -->
		<!-- #ifndef MP-WEIXIN -->
		<view ref="panelEl" :id="panelId" class="app-sheet-panel" :class="panelCls" :style="panelStyle"
			@touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd" @touchcancel="onTouchCancel">
		<!-- #endif -->
			<!-- 内容在露头模式或首次打开时挂载，之后常驻；头部在上，内容区在下 -->
			<!-- 内容主体只占可见高度：底部让出面板多出的那一截 -->
			<view v-if="mounted" class="app-sheet-body" :style="{ bottom: reserve + 'px' }">
					<!-- 头部（整条是拖动热区）：把手行与标题行按 head 显示；标题行里左右槽等宽、标题居中。
						触摸移动就地处理，不冒泡、不带动页面滚动（小程序端靠修饰符编译成 catch） -->
					<view class="app-sheet-header" @touchstart="onHeaderTouchStart" @touchmove.stop.prevent="onTouchMove">
					<!-- 把手：停在关闭位时点击展开 -->
					<view v-if="showHandle" class="app-sheet-handle" @touchstart="onHandleTouchStart">
						<view class="app-sheet-handle-bar" />
					</view>
					<view v-if="showHeader" class="app-sheet-row">
						<view class="app-sheet-side">
							<view class="app-sheet-side-fill" :style="sideStyle">
								<view class="app-sheet-side-inner">
									<slot name="left" />
								</view>
							</view>
						</view>
						<view class="app-sheet-title">
							<slot name="title" :close="close">
								<text v-if="(title ?? '') !== ''" class="app-sheet-title-text">{{ title }}</text>
							</slot>
						</view>
						<view class="app-sheet-side app-sheet-side--end">
							<view class="app-sheet-side-fill app-sheet-side-fill--end" :style="sideStyle">
								<view class="app-sheet-side-inner">
									<slot name="right" :close="close">
										<view v-if="showClose" class="app-sheet-close"
											:hover-class="themeStore.isDark ? 'app-pressed-inset-dark' : 'app-pressed-inset'"
											:hover-stay-time="100" @click="close">
											<uni-icons class="app-sheet-close-icon" type="closeempty" />
										</view>
									</slot>
								</view>
							</view>
						</view>
					</view>
				</view>
				<!-- 内容区：铺满头部下方 -->
				<view class="app-sheet-main">
					<!-- 内置滚动：默认插槽 -->
					<scroll-view v-if="!isBare" class="app-sheet-scroll" direction="vertical" :bounces="false"
						@scroll="onBodyScroll">
						<!-- 内容层：内距写在内容上（scroll-view 自身 padding 不生效） -->
						<!-- #ifdef MP-WEIXIN -->
						<!-- 小程序：滚动区把内部的触摸移动截住不往外传，面板收不到。内容层绑滚动守卫（视图层 wxs：到边后仍朝外的移动不带动页面）；
							守卫拦下的移动不再冒泡，手势跟踪绑在它内侧的一层才收得到 -->
						<view class="app-sheet-content" @touchstart="guard.start" @touchmove="guard.move">
							<view @touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd"
								@touchcancel="onTouchCancel">
						<!-- #endif -->
						<!-- #ifndef MP-WEIXIN -->
						<view class="app-sheet-content">
						<!-- #endif -->
							<slot />
							<view class="app-sheet-bottom-safe" />
						<!-- #ifdef MP-WEIXIN -->
							</view>
						<!-- #endif -->
						</view>
					</scroll-view>
					<!-- 裸内容：调用方自带滚动容器 -->
					<view v-else class="app-sheet-bare">
						<slot name="body" />
					</view>
					<!-- 内容淡入层：与面板同底色，盖在内容区上；透明度随展开进度归零，完全展开后不渲染 -->
					<!-- #ifdef MP-WEIXIN -->
					<view v-if="fading" :id="fadeId" class="app-sheet-fade" :style="fadeStyle" />
					<!-- #endif -->
					<!-- #ifndef MP-WEIXIN -->
					<view v-if="fading" ref="fadeEl" :id="fadeId" class="app-sheet-fade" :style="fadeStyle" />
					<!-- #endif -->
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	// 底部抽屉：面板在关闭位与全开之间滑动，位移全 JS 驱动（进场与入场走定时曲线，松手回位走物理弹簧或缓出补间），遮罩用 app-mask；头部在内容区上方。
	// 手势仲裁：头部（含把手）的纵向拖动带动面板；默认插槽的内容在顶部时下拉也带动面板，其余交给原生滚动；#body 模式不碰内容区手势。
	// 内容到边后不带动页面：Web 靠样式表的 overscroll-behavior；小程序的滚动区会把内部的触摸移动截住不外传，手势跟踪与滚动守卫都绑在滚动区内部（见模板与 app-sheet-guard.wxs）。
	// 高度：默认占满内容区（或 height）；auto-height 时面板高度=头部+默认插槽内容的自然高度，封顶内容区，内容超高时在滚动区内滚动。
	// 平台分叉（第 3 级，因小程序端元素引用无 .style）：写层 App/Web 走 setProperty 直驱，小程序走 :style 载体。

	import AppMask from '@/components/app-mask/app-mask.uvue'
	import { useThemeStore } from '@/stores/theme'
	import { rubber } from '@/utils/damping'
	import { domElementById } from '@/utils/dom'
	import { createSpringControl } from '@/utils/spring'
	import { getUUID } from '@/utils/uuid'

	// 可选布尔属性不传即为 false，默认开的开关须在 withDefaults 里显式给
	const props = withDefaults(defineProps<{
		// 显示（v-model:visible）
		visible?: boolean
		// 头部标题（#title 插槽的默认内容）
		title?: string
		// 可关闭：显示关闭钮，遮罩点击、返回键和下拉都能关；false 时只能由外部改 visible 关闭。露头模式停在关闭位时不显示关闭钮
		closable?: boolean
		// 可拖动：拖头部带动面板，内容在顶部时下拉也带动；closable=false 时恒不可拖
		draggable?: boolean
		// 内容在顶部时下拉带动面板（收起方向）；false 时只能拖头部
		closeOnContentDrag?: boolean
		// 是否带遮罩（返回键只在带遮罩时被拦截）
		overlay?: boolean
		// 面板高度：不传=占满页面内容区；0~1=内容区高度的比例；大于 1=像素（超过内容区高度时取内容区高度）
		height?: number
		// 自动高度：面板高度按头部+默认插槽内容的自然高度，封顶页面内容区；忽略 height，#body 裸内容不适用
		autoHeight?: boolean
		// 露头：关闭位不是完全隐藏，而是露出头部和内容区顶部的一截（关闭位高度=头部高度+底部安全区）；面板与内容在挂载时就创建
		peek?: boolean
		// 头部形态：handle=只有把手，header=只有标题行，both=两者都有，none=都没有。不传时露头模式为 handle，否则为 header
		head?: string
	}>(), {
		closable : true,
		draggable : true,
		closeOnContentDrag : true,
		overlay : true
	})

	const emit = defineEmits<{
		(e : 'update:visible', value : boolean) : void
		(e : 'open') : void
		(e : 'close') : void
	}>()

	// 头部三槽作用域给 close；自定义标题内容超长时的省略由调用方处理
	defineSlots<{
		default() : any
		left(props : { close : () => void }) : any
		title(props : { close : () => void }) : any
		right(props : { close : () => void }) : any
		body() : any
	}>()

	// 松手后展开还是收起：速度超过 FLING_V（px/ms）顺速度方向，否则取离得近的一端；松手前超过 V_STALE（ms）没有移动视为停住
	const FLING_V = 0.4
	const V_STALE = 100
	// 速度采样的最大间隔（ms）：与上一采样相隔更久（按住停顿）时上一采样不作数
	const V_GAP = 40
	// 帧间隔（ms）
	const FRAME_MS = 16
	// 入场时长（ms）：非露头模式从关闭位滑到展开位，行程较短时等比缩短（下限四分之一）；露头面板进场固定用全长
	const ENTER_MS = 360
	// 到位判定：距目标的位移不超过该值（px）视为已到达
	const SETTLE_X = 0.5
	// 内容淡入：超出关闭位的露出高度到达全开的该比例时内容完全显示
	const FADE_AT = 0.85
	// 头部各行高度（px，须与 .app-sheet-handle / .app-sheet-row 的样式同值）；量测后以量测值为准
	const HANDLE_H = 48
	const HEADER_H = 56
	// 露头模式到头拖动的橡皮筋：越过展开位或关闭位后，视觉越界的渐近幅度（px）；上侧还受面板顶到内容区顶的距离限制。
	// 面板底部同时多留同高度的延长段在屏幕外：露头拖动或弹簧过冲使面板向上越界时，由它补位
	const OVER_MAX = 40
	// 头部带动面板的起拖阈值（px）：纵向位移超过它才算拖动
	const CLAIM_SLOP = 3
	// 内容区带动面板的锁定阈值（px）：内容在顶部时下拉超过它才接管，接管点之前的位移不带动面板
	const LOCK = 8
	// 点击容差（px）：带动面板后位移仍在容差内且不算快甩的，按点击处理
	const TAP_SLOP = 8
	// 松手回位照搬侧滑：带速度松手（速度超过 SPRING_V，px/ms）走物理弹簧，停顿后松手走缓出补间；程序开合沿用浮动面板曲线。
	// 补间与程序开合时长同为 PANEL_MS（ms）
	const SPRING_V = 0.3
	const PANEL_MS = 300
	const PANEL_AX = 0.22
	const PANEL_AY = 0.8
	const PANEL_BX = 0.28
	const PANEL_BY = 1

	// #ifdef APP
	// 宿主页：面板顶部对齐其内容区
	const page = getCurrentInstance()?.proxy?.$page
	// #endif
	// 组件实例（头部量测用）
	const owner = getCurrentInstance()?.proxy
	// 面板与淡入层的元素 id（同页多个抽屉须互不相同）
	const nodeKey = getUUID()
	const panelId = `app-sheet-panel-${nodeKey}`
	const fadeId = `app-sheet-fade-${nodeKey}`
	// 页面内容区的底部安全区高度（px），与样式变量 --uni-safe-area-inset-bottom 同值
	const safeBottom = () : number => {
		// #ifdef APP
		return page?.safeAreaInsets.bottom ?? 0
		// #endif
		// #ifndef APP
		return uni.getWindowInfo().safeAreaInsets.bottom ?? 0
		// #endif
	}

	const themeStore = useThemeStore()
	themeStore.init()

	const slots = useSlots()
	// 裸内容模式：调用方自带滚动容器
	const isBare = computed<boolean>(() => !!slots.body)
	// 自动高度：按默认插槽内容的自然高度定面板高度（忽略 height）；裸内容由调用方定高，不参与
	const autoFit = computed<boolean>(() => props.autoHeight === true && !isBare.value)
	const canDrag = computed<boolean>(() => props.closable === true && props.draggable === true)
	// 露头模式：关闭位露出头部
	const peek = computed<boolean>(() => props.peek === true)
	// 头部形态：把手行 / 标题行是否显示
	const showHandle = computed<boolean>(() => props.head == 'handle' || props.head == 'both' || (props.head == null && peek.value))
	const showHeader = computed<boolean>(() => props.head == 'header' || props.head == 'both' || (props.head == null && !peek.value))

	const maskEl = ref<any>(null)
	// #ifndef MP-WEIXIN
	// 面板与淡入层的元素引用（App 写层用；Web 按 id 取元素，不用它们）
	const panelEl = ref<any>(null)
	const fadeEl = ref<any>(null)
	// #endif
	// 小程序端的逐帧位移载体；Web 的载体只放几何（位移进载体会被重渲染贴回）；安卓的载体另带落点 landedY
	const carrierY = ref<number>(0)
	// #ifdef APP-ANDROID
	// 载体里的位移落点：安卓的面板节点到显示时才实例化，挂载期写下的位移留不下，落点随几何一并写进载体。
	// 只收静止位（由 writeY 同步）；动画与拖动中的逐帧位移仍走 setProperty
	const landedY = ref<number>(0)
	// #endif
	// 面板几何（页面内容区坐标）：panelTop=面板顶；panelH=面板可见高度（关闭位的位移量）。
	// 面板实际高度多出 reserve：向上越界（露头拖动、弹簧过冲）时面板抬起，多出的这截从屏幕底补进来，底部不留空
	const panelTop = ref<number>(0)
	const panelH = ref<number>(1)
	const reserve = computed<number>(() => OVER_MAX)
	// 内容淡入层：是否渲染 + 小程序端的透明度载体
	const fading = ref<boolean>(false)
	const fadeOpacity = ref<number>(1)

	// ---------- 写层 ----------
	// 面板位移与淡入层透明度两端相反：小程序没有 element.style，且真机上逐帧改带 ref 的元素会中断拖动，只能走 :style 载体；
	// App/Web 反过来，逐帧位移不进载体（重渲染会把旧值贴回），取到元素后 setProperty 直驱。平台分叉只在这里与面板样式载体两处。
	let writer : any = null
	// #ifdef MP-WEIXIN
	writer = {
		panelStyle: () : any => {
			return { top: panelTop.value + 'px', height: (panelH.value + reserve.value) + 'px', transform: `translate3d(0, ${carrierY.value}px, 0)` }
		},
		fadeStyle: () : any => {
			return { opacity: fadeOpacity.value }
		},
		move: (y : number) => {
			carrierY.value = y
		},
		fade: (opacity : number) => {
			fadeOpacity.value = opacity
		},
		dropFadeNode: () => {},
		rewriteAfterMount: (_rewrite : () => void) => {}
	}
	// #endif
	// #ifndef MP-WEIXIN
	let panelNode : any = null
	let fadeNode : any = null
	// 面板元素：App 每次取模板 ref 的当前值（挂载后引用会被重新赋值，不缓存），Web 按 id 取 DOM、首次取到后缓存
	const panelNodeOf = () : any => {
		// #ifdef APP
		panelNode = panelEl.value
		// #endif
		// #ifdef WEB
		if (panelNode == null) {
			panelNode = domElementById(panelId)
		}
		// #endif
		return panelNode
	}
	// 淡入层元素：随显示才创建，不显示后丢弃；取法同面板
	const fadeNodeOf = () : any => {
		// #ifdef APP
		fadeNode = fadeEl.value
		// #endif
		// #ifdef WEB
		if (fadeNode == null) {
			fadeNode = domElementById(fadeId)
		}
		// #endif
		return fadeNode
	}
	writer = {
		panelStyle: () : any => {
			return { top: panelTop.value + 'px', height: (panelH.value + reserve.value) + 'px' }
		},
		fadeStyle: () : any => {
			return {}
		},
		move: (y : number) => {
			const node : any = panelNodeOf()
			if (node != null) {
				// #ifdef APP-IOS
				node.style.setProperty('transform', 'translate3d(0, ' + y + 'px, 0)')
				// #endif
				// #ifdef APP-ANDROID
				// 安卓蒸汽端不应用 translate3d，只认 2D 形式
				node.style.setProperty('transform', 'translateY(' + y + 'px)')
				// #endif
				// #ifdef WEB
				node.style.setProperty('transform', 'translate3d(0, ' + y + 'px, 0)')
				// #endif
			}
		},
		fade: (opacity : number) => {
			if (fading.value) {
				const node : any = fadeNodeOf()
				if (node != null) {
					node.style.setProperty('opacity', String(opacity))
				}
			}
		},
		dropFadeNode: () => {
			fadeNode = null
		},
		rewriteAfterMount: (rewrite : () => void) => {
			// 挂载时元素可能还没登记：按当前位移重写，取不到元素就稍后重试
			let tries = 0
			const run = () => {
				rewrite()
				if (panelNode == null && tries < 3) {
					tries++
					setTimeout(run, 32)
				}
			}
			setTimeout(run, 0)
		}
	}
	// #endif
	// 模板用的两个样式载体：形状由写层按平台给出
	const panelStyle = computed<any>(() => {
		const style : any = writer.panelStyle()
		// #ifdef APP-ANDROID
		style.transform = 'translateY(' + landedY.value + 'px)'
		// #endif
		return style
	})
	const fadeStyle = computed<any>(() => writer.fadeStyle())

	// 可用高度（px）：自动高度封顶与 height 按比例换算时用
	let areaH = 1
	// 页面内容区顶（px）：面板顶让出的导航区高度，自动高度重算面板顶时用
	let insetTop = 0
	// 露头时关闭位的高度（px）=头部行高+底部安全区：初值按形态取样式常量，量测后更新
	let headH = 1
	const resetHeadH = () => {
		const rows = (showHandle.value ? HANDLE_H : 0) + (showHeader.value ? HEADER_H : 0)
		headH = Math.max(1, peek.value && rows > 0 ? rows + safeBottom() : rows)
	}
	resetHeadH()
	// 关闭位的露出高度（px）：露头时为头部高度，否则为 0
	let closedH = 0
	const syncClosed = () : boolean => {
		const next = peek.value ? Math.max(0, Math.min(headH, panelH.value - 1)) : 0
		if (next === closedH) {
			return false
		}
		closedH = next
		return true
	}
	syncClosed()
	// 当前目标：true=全开，false=关闭位
	const opened = ref<boolean>(false)
	// 默认关闭钮：有标题行才显示；露头且停在关闭位时不显示
	const showClose = computed<boolean>(() => props.closable === true && showHeader.value && !(peek.value && !opened.value))

	// 关闭位的面板位移；全开的位移恒为 0
	const yClosed = () : number => panelH.value - closedH

	// 量几何：top=面板顶让出的高度（导航栏或状态栏），areaH=可用高度；每次打开前调用
	const measure = () => {
		const win = uni.getWindowInfo()
		let top = 0
		areaH = 1
		// #ifdef WEB
		// Web 的导航栏与 tabBar 是页内元素：面板让出导航栏，tabBar 页再让出 tabBar；windowHeight 已不含两者，勿再扣
		top = Math.max(win.windowTop ?? 0, win.statusBarHeight ?? 0)
		areaH = Math.max(1, win.windowHeight)
		// #endif
		// #ifdef MP-WEIXIN
		// 小程序页面内容区本就从导航栏下方起算
		areaH = Math.max(1, win.windowHeight)
		// #endif
		// #ifndef WEB || MP-WEIXIN
		// App：面板顶让出「状态栏高 − 内容区顶」；自定义导航页的内容区从屏幕顶起算
		const body = page?.pageBody
		const bodyTop = body == null ? 0 : body.top
		top = Math.max(0, (win.statusBarHeight ?? 0) - bodyTop)
		areaH = Math.max(1, win.windowHeight - top)
		// #endif
		insetTop = top
		const h = props.height
		// 自动高度先按内容区高度给临时几何：面板停在关闭位（屏幕外或只露头部），量定内容高度后再改
		const ph = autoFit.value ? areaH : h == null || h <= 0 ? areaH : h <= 1 ? Math.round(areaH * h) : Math.min(h, areaH)
		panelH.value = Math.max(1, ph)
		panelTop.value = insetTop + (areaH - panelH.value)
		syncClosed()
	}

	// closed 停在关闭位 / enter 展开中（外部触发） / open 停在展开位 / drag 拖动中 / settle 吸附中 / leave 收起中
	type Phase = 'closed' | 'enter' | 'open' | 'drag' | 'settle' | 'leave'
	let phase : Phase = 'closed'
	let sheetY = panelH.value
	// 当前跟踪的触点标识；null=没有。标识由系统分配、可为任意整数（iOS Safari 为负数），不能拿具体数值表示「没有」
	let dragTouchId : number | null = null
	// none=还没带动面板 / sheet=抽屉拖动中
	let mode : 'none' | 'sheet' = 'none'
	const shown = ref<boolean>(false)
	const mounted = ref<boolean>(false)
	// 面板修饰类：未显示时隐藏；露头模式面板浮在页面上，带顶边阴影与细线
	const panelCls = computed<string>(() => {
		if (!shown.value) {
			return 'app-sheet-panel-hide'
		}
		return peek.value ? 'app-sheet-panel-float' : ''
	})

	// 内置滚动区是否在顶部：内容区下拉能否带动面板的判定用
	const atTop = ref<boolean>(true)
	// 守卫判到边的容差（px），与 app-sheet-guard.wxs 的 EDGE 同值
	const GUARD_EDGE = 1
	// 小程序端滚动守卫的回传（经 wxs 的 callMethod 调到；其余端没有守卫，恒为 -1）：本次手势按下时量到的内容位置。
	// 内容是否在顶部除滚动事件外另以它为准：滚动事件成批节流，到顶后的最后一条可能送不到逻辑层
	let guardTop = -1
	const onGuardStart = (top : number) => {
		guardTop = top
	}
	// 守卫在顶边拦下移动：此刻内容必在顶部
	const onGuardTop = () => {
		guardTop = 0
	}
	const contentAtTop = () : boolean => {
		return atTop.value || (guardTop >= 0 && guardTop <= GUARD_EDGE)
	}

	const onBodyScroll = (e : UniScrollEvent) => {
		const top = e.detail.scrollTop <= 0
		if (top !== atTop.value) {
			atTop.value = top
		}
		// 内容离开顶部后，本次手势早先量到的「在顶部」不再作数
		if (e.detail.scrollTop > GUARD_EDGE) {
			guardTop = -1
		}
	}

	let animTimer : number | null = null
	// 松手回位的物理弹簧：与侧滑惯性收起同一引擎、同一参数，初速承接松手末速度；springing=弹簧在跑
	const settleSpring = createSpringControl()
	let springing = false
	// 是否有动画在跑（补间、进场或弹簧）
	const animating = () : boolean => animTimer != null || springing
	// 唯一写口：面板位移、遮罩进度（=关闭位到展开位之间的展开比例）与内容淡入层透明度同帧下发
	const writeY = (y : number) => {
		sheetY = y
		writer.move(y)
		// #ifdef APP-ANDROID
		// 静止位才同步给载体：此刻既没有动画在跑，也不在拖动中
		if (!animating() && mode !== 'sheet') {
			landedY.value = y
		}
		// #endif
		const beyond = panelH.value - y - closedH
		const span = panelH.value - closedH
		const p = span > 0 ? Math.max(0, Math.min(1, beyond / span)) : 1
		maskEl.value?.setProgress(p)
		// 淡入层：超出关闭位的露出高度到达全开的 FADE_AT 倍时透明度归零，之后不再渲染。
		// 露头模式停在关闭位时内容区就露出一截，不盖
		const cover = peek.value || span <= 0 ? 0 : 1 - Math.min(1, beyond / (span * FADE_AT))
		fading.value = cover > 0
		writer.fade(cover)
	}

	const stopAnims = () => {
		settleSpring.cancel()
		springing = false
		if (animTimer != null) {
			clearInterval(animTimer)
			animTimer = null
		}
	}

	// 帧循环：各段动画共用一个定时器，每帧送入自首帧起流逝的毫秒数（首帧记 FRAME_MS）
	const startFrames = (frame : (ms : number) => void) => {
		stopAnims()
		let t0 = -1
		animTimer = setInterval(() => {
			const now = Date.now()
			if (t0 < 0) {
				t0 = now - FRAME_MS
			}
			frame(now - t0)
		}, FRAME_MS)
	}

	// 缓动曲线 cubic-bezier(ax, ay, bx, by)：入参为时间比例，返回走过的行程比例。
	// 贝塞尔的横坐标不是时间：先用牛顿迭代由横坐标反解参数，再取纵坐标
	const ease = (x : number, ax : number, ay : number, bx : number, by : number) : number => {
		let t = x
		for (let i = 0; i < 4; i++) {
			const o = 1 - t
			const cx = 3 * o * o * t * ax + 3 * o * t * t * bx + t * t * t - x
			const dx = 3 * o * o * ax + 6 * o * t * (bx - ax) + 3 * t * t * (1 - bx)
			if (dx == 0) {
				break
			}
			t = t - cx / dx
		}
		t = Math.max(0, Math.min(1, t))
		const o = 1 - t
		return 3 * o * o * t * ay + 3 * o * t * t * by + t * t * t
	}

	// 停顿后松手的补间（侧滑同款缓出）：入参为时间比例，返回剩余行程比例
	const tweenRest = (x : number) : number => (1 - x) * (1 - x)

	// 入场曲线：速度线性升到峰值后按平方衰减；入参为时间比例，返回剩余行程比例
	const enterRest = (x : number) : number => (1 - x) * (1 - x) * (1 - x) * (1 + 3 * x)

	// 是否正从关闭位展开 / 正收回关闭位（到位时发 open / close）
	let pendingOpen = false
	let pendingClose = false

	// 到达展开位
	const finishOpen = () => {
		phase = 'open'
		// 动画期间的内容变化收尾后补量
		if (fitPending) {
			fitPending = false
			fitLayout()
		}
		if (pendingOpen) {
			pendingOpen = false
			emit('open')
		}
	}

	// 到达关闭位并通知外部；露头模式面板常驻
	const finishClose = () => {
		writeY(yClosed())
		pendingOpen = false
		phase = 'closed'
		if (!peek.value) {
			fading.value = false
			shown.value = false
			// 面板已隐藏：按住未松的触摸不再带动面板
			dragTouchId = null
			mode = 'none'
		}
		// 动画期间的内容变化收尾后补量；收起后隐藏的面板不量
		if (fitPending) {
			fitPending = false
			if (peek.value) {
				fitLayout()
			}
		}
		if (pendingClose) {
			pendingClose = false
			emit('close')
		}
	}

	// 物理弹簧走到 to：v0=初速（px/s）。面板越过展开位的量不超过延长段（否则底部露空）；终帧落到位再收尾
	const springTo = (to : number, v0 : number, done : () => void) => {
		stopAnims()
		springing = true
		const cap = -reserve.value
		settleSpring.run(sheetY, to, v0, (x : number) => {
			writeY(x < cap ? cap : x)
		}, () => {
			springing = false
			writeY(to)
			done()
		})
	}

	// 面板走到展开位或关闭位。带速度松手走物理弹簧，停顿后松手走缓出补间（回位照搬侧滑）；
	// 程序开合（按钮、外部改 visible、点按回到当前目标）走浮动面板曲线。
	// enter=非露头模式从关闭位的入场，走入场曲线（行程越短越快，下限 ENTER_MS/4）。已在目标则直接收尾
	const slideTo = (open : boolean, enter : boolean = false, v : number = 0, handOff : boolean = false) => {
		stopAnims()
		const to = open ? 0 : yClosed()
		const from = sheetY
		if (!open) {
			phase = 'leave'
			// 已在关闭位或更靠下（拖出屏外）直接收尾
			if (from >= to - SETTLE_X) {
				finishClose()
				return
			}
		} else {
			phase = enter ? 'enter' : 'settle'
			if (Math.abs(from - to) <= SETTLE_X) {
				writeY(to)
				finishOpen()
				return
			}
		}
		const done = () => {
			if (open) {
				finishOpen()
			} else {
				finishClose()
			}
		}
		if (enter && !peek.value) {
			const ms = Math.max(ENTER_MS / 4, ENTER_MS * Math.abs(from - to) / panelH.value)
			startFrames((t : number) => {
				const x = Math.min(1, t / ms)
				if (x >= 1) {
					stopAnims()
					writeY(to)
					done()
					return
				}
				writeY(to + (from - to) * enterRest(x))
			})
			return
		}
		if (handOff && Math.abs(v) > SPRING_V) {
			springTo(to, v * 1000, done)
			return
		}
		startFrames((t : number) => {
			const x = Math.min(1, t / PANEL_MS)
			if (x >= 1) {
				stopAnims()
				writeY(to)
				done()
				return
			}
			writeY(to + (from - to) * (handOff ? tweenRest(x) : 1 - ease(x, PANEL_AX, PANEL_AY, PANEL_BX, PANEL_BY)))
		})
	}

	// 露头面板进场：整块面板从屏幕外升到关闭位，走入场曲线、时长用全长；期间仍是关闭态
	const slideIn = () => {
		const from = sheetY
		const to = yClosed()
		if (from <= to) {
			writeY(to)
			return
		}
		startFrames((t : number) => {
			const x = Math.min(1, t / ENTER_MS)
			if (x >= 1) {
				stopAnims()
				writeY(to)
				return
			}
			writeY(to + (from - to) * enterRest(x))
		})
	}

	// 切换目标并通知外部；返回是否有变化
	const setOpened = (next : boolean) : boolean => {
		if (next === opened.value) {
			return false
		}
		const wasClosed = !opened.value
		opened.value = next
		if (wasClosed) {
			pendingOpen = true
			if (props.visible !== true) {
				emit('update:visible', true)
			}
		} else {
			pendingClose = true
			emit('update:visible', false)
		}
		return true
	}

	// ---------- 布局量测 ----------
	// 两槽统一的最小宽度（px）：初值取标准控件宽，量测后取两槽自然宽的较宽者（不低于标准控件宽）；标题在等宽的两槽之间居中
	const SIDE_MIN = 44
	const sideW = ref<number>(SIDE_MIN)
	const sideStyle = computed<any>(() => ({ minWidth: sideW.value + 'px' }))

	// 关闭位变化后重新对位：静止的直接落到当前目标，运动中的从当前位置重走
	const realign = () => {
		if (phase === 'closed') {
			// 关闭位恒为 yClosed（含自动高度量取中：此时 opened 已置真，但面板仍在关闭位等入场）
			if (!animating()) {
				writeY(yClosed())
			} else {
				// 进场中：从当前位置改指向新的关闭位
				slideIn()
			}
		} else if (phase === 'open') {
			writeY(0)
		} else if (phase === 'enter' || phase === 'settle' || phase === 'leave') {
			slideTo(opened.value)
		}
	}

	// 默认插槽内容的自然高度（px，含底部安全区）；-1=还没量到
	let contentH = -1
	// 动画/拖动中收到的内容变化：收尾后再补量
	let fitPending = false

	// 应用自动高度：面板高度=头部实高+内容自然高度，封顶内容区；面板底边不动，顶边随高度上移
	const applyFitHeight = (headPx : number) => {
		const total = Math.max(1, Math.min(areaH, headPx + Math.max(0, contentH)))
		if (total === panelH.value) {
			return
		}
		panelH.value = total
		panelTop.value = insetTop + (areaH - total)
		syncClosed()
		realign()
	}

	// 量头部实高、左右槽自然宽与（自动高度时）默认插槽内容的自然高度；
	// force 用于刚打开/刚挂载（此时动画可能在跑），tries 为布局未就绪时的重量次数
	const fitLayout = (force : boolean = false, done : (() => void) | null = null, tries : number = 0) : void => {
		const finish = () => {
			if (done != null) {
				done()
			}
		}
		if (!shown.value) {
			finish()
			return
		}
		if (!force && (animating() || phase === 'drag')) {
			if (autoFit.value) {
				fitPending = true
			}
			return
		}
		const query = uni.createSelectorQuery().in(owner)
		if (query == null) {
			finish()
			return
		}
		query.select('.app-sheet-header').boundingClientRect()
		if (autoFit.value) {
			query.select('.app-sheet-content').boundingClientRect()
		}
		query.selectAll('.app-sheet-side-inner').boundingClientRect().exec((ret) => {
			const head = ret[0] as { height : number } | null
			let idx = 1
			let body : { height : number } | null = null
			if (autoFit.value) {
				body = ret[1] as { height : number } | null
				idx = 2
			}
			const rects = ret[idx] as Array<{ width : number }> | null
			// 元素还没登记或布局未就绪：稍后重量，最多三次；仍量不到就按现有几何打开，不阻断
			const hasHead = showHandle.value || showHeader.value
			const headBad = hasHead && (head == null || head.height <= 0)
			const bodyBad = autoFit.value && body == null
			if (headBad || bodyBad) {
				if (force && tries < 3) {
					setTimeout(() => {
						fitLayout(true, done, tries + 1)
					}, 32)
					return
				}
				finish()
				return
			}
			if (rects != null) {
				let w = 0
				for (let i = 0; i < rects.length; i++) {
					if (rects[i].width > w) {
						w = rects[i].width
					}
				}
				sideW.value = Math.max(SIDE_MIN, Math.ceil(w))
			}
			const rows = (showHandle.value ? HANDLE_H : 0) + (showHeader.value ? HEADER_H : 0)
			const headPx = head != null && head.height > 0 ? Math.ceil(head.height) : rows
			// 头部实高与常量不一致时，按实高修正关闭位（露头时再加底部安全区）
			let closedChanged = false
			if (peek.value && head != null && head.height > 0) {
				const real = Math.round(head.height) + safeBottom()
				if (real != headH) {
					headH = Math.max(1, real)
					closedChanged = syncClosed()
				}
			}
			if (autoFit.value && body != null) {
				contentH = Math.max(0, Math.ceil(body.height))
				applyFitHeight(headPx)
			} else if (closedChanged) {
				realign()
			}
			finish()
		})
	}

	// 重新量取并应用自动高度；打开后默认插槽内容变了，由调用方在 nextTick 后调
	const fit = () => {
		if (autoFit.value && shown.value) {
			fitLayout()
		}
	}

	// 展开到全开；从关闭位展开时按入场处理
	const open = () => {
		if (phase === 'drag') {
			return
		}
		// 自动高度量取中：本次打开已受理，等量完再入场
		if (opened.value && phase === 'closed') {
			return
		}
		const enter = phase === 'closed'
		if (enter) {
			measure()
			writeY(yClosed())
			mounted.value = true
			shown.value = true
		}
		if (phase === 'open' && opened.value) {
			return
		}
		setOpened(true)
		if (enter) {
			if (autoFit.value) {
				// 先量内容再入场：面板此时停在关闭位，量定高度后从这里展开
				nextTick(() => {
					fitLayout(true, () => {
						if (!opened.value || !shown.value) {
							return
						}
						writeY(yClosed())
						slideTo(true, true)
					})
				})
				return
			}
			nextTick(() => {
				fitLayout(true)
			})
			slideTo(true, true)
			return
		}
		slideTo(true, false)
	}

	// 收起到关闭位
	const close = () => {
		if (!opened.value && (phase === 'closed' || phase === 'leave')) {
			return
		}
		// 拖动中被外部收起：先结束这次拖动
		if (phase === 'drag') {
			dragTouchId = null
			mode = 'none'
		}
		setOpened(false)
		slideTo(false)
	}

	// ---------- 手势 ----------
	let startY = 0
	let baseY = 0
	// 起拖时的露出高度：松手时据此判断这次触摸有没有真的拖动面板
	let baseH = 0
	// 起拖时面板是否停在关闭位
	let fromClosed = false
	let fromHeader = false
	let fromHandle = false
	// 头部、把手自身的 touchstart 先于面板触发，用它们标记触点起点
	let headerTouched = false
	let handleTouched = false
	// 松手速度：按下起全程统计，取最近两段位移的平均速度（px/ms，正值向下），用来选目标与吸附时长
	let carryMs = 0
	let trackY = 0
	let trackT = 0
	let prevY = 0
	let prevT = 0
	// 内容在顶部时手指的位置：内容区的下拉从这里起算；-1=内容不在顶部
	let topX = 0
	let topY = -1

	// 事件时刻（ms）。小程序端逻辑层的触摸事件成批送达：按处理时刻取时间会把一批事件算成同一时刻，松手速度丢失，
	// 改用事件自带的时间戳；其余端沿用处理时刻
	const stampOf = (e : TouchEvent) : number => {
		// #ifdef MP-WEIXIN
		return typeof e.timeStamp === 'number' && e.timeStamp > 0 ? e.timeStamp : Date.now()
		// #endif
		// #ifndef MP-WEIXIN
		return Date.now()
		// #endif
	}

	const findTouch = (e : TouchEvent, id : number) : Touch | null => {
		for (let i = 0; i < e.changedTouches.length; i++) {
			if (e.changedTouches[i].identifier === id) {
				return e.changedTouches[i]
			}
		}
		for (let i = 0; i < e.touches.length; i++) {
			if (e.touches[i].identifier === id) {
				return e.touches[i]
			}
		}
		return null
	}

	// 速度采样：取最近两段位移的平均速度（px/ms，正值向下）；同一时刻的多次移动并作一次。
	// limit=采样间隔上限（ms）：相隔更久（按住停顿）时速度记 0
	const sample = (p : Touch, now : number, limit : number = V_GAP) => {
		if (now == trackT) {
			trackY = p.screenY
			return
		}
		const dt = now - trackT
		const inst = dt <= limit ? (p.screenY - trackY) / dt : 0
		carryMs = prevT > 0 && now - prevT <= limit ? (p.screenY - prevY) / (now - prevT) : inst
		prevY = trackY
		prevT = trackT
		trackY = p.screenY
		trackT = now
	}

	const onHeaderTouchStart = () => {
		headerTouched = true
	}

	const onHandleTouchStart = () => {
		handleTouched = true
	}

	// 松手后展开还是收起。v=松手速度（px/ms，正值向下）
	const pickOpen = (v : number) : boolean => {
		// 到头拖动的越界段：回到被越过的那一端
		if (sheetY <= 0) {
			return true
		}
		const bottom = yClosed()
		if (sheetY >= bottom) {
			return false
		}
		// 快甩：顺速度方向
		if (Math.abs(v) > FLING_V) {
			return v < 0
		}
		// 其余：离得近的一端
		const h = panelH.value - sheetY
		return h - closedH > panelH.value - h
	}

	// 带动面板：冻结在途动画，冻结位即起拖基准，此后面板位移=手指相对 originY 的位移
	const claim = (originY : number) => {
		stopAnims()
		baseY = sheetY
		baseH = panelH.value - baseY
		fromClosed = phase === 'closed'
		startY = originY
		prevT = 0
		phase = 'drag'
		mode = 'sheet'
	}

	const onTouchStart = (e : TouchEvent) => {
		fromHeader = headerTouched
		fromHandle = handleTouched
		headerTouched = false
		handleTouched = false
		// 露头模式面板常驻，收起过程中也能接住；其余情况的关闭位与收起过程中不接触摸
		if (dragTouchId != null || (phase === 'leave' && !peek.value) || (phase === 'closed' && !peek.value)) {
			return
		}
		// 进场中触摸：面板先落到关闭位，这次触摸按停在关闭位处理
		if (animating() && phase === 'closed') {
			stopAnims()
			writeY(yClosed())
		}
		const t = e.changedTouches.length > 0 ? e.changedTouches[0] : e.touches[0]
		if (t == null) {
			return
		}
		dragTouchId = t.identifier
		startY = t.screenY
		fromClosed = phase === 'closed'
		topX = t.screenX
		// 新手势开始：上一次手势的守卫回传作废（本次的回传晚于按下事件到达）
		guardTop = -1
		topY = contentAtTop() ? t.screenY : -1
		trackY = t.screenY
		trackT = stampOf(e)
		carryMs = 0
		prevT = 0
		mode = 'none'
	}

	const onTouchMove = (e : TouchEvent) => {
		const id = dragTouchId
		if (id == null) {
			return
		}
		const p = findTouch(e, id)
		if (p == null) {
			return
		}
		// #ifdef MP-WEIXIN
		// 带动面板之前的移动也采样：逻辑层收到的移动事件少，一甩可能只有一两个样本
		sample(p, stampOf(e))
		// #endif
		if (mode === 'none') {
			if (!canDrag.value) {
				return
			}
			if (fromHeader) {
				// 头部：纵向位移超过起拖阈值就带动，位移从按下点起算
				if (Math.abs(p.screenY - startY) < CLAIM_SLOP) {
					return
				}
				claim(startY)
			} else {
				// 内容区：须为内置滚动、允许内容带动，且内容在顶部（不在顶部时交给原生滚动）。
				// 以内容在顶部时的手指位置为基准，下拉超过锁定阈值且纵向为主才接管；接管点之前的位移不带动面板
				if (isBare.value || props.closeOnContentDrag !== true || !contentAtTop()) {
					topY = -1
					return
				}
				if (topY < 0) {
					topX = p.screenX
					topY = p.screenY
				}
				const pull = p.screenY - topY
				if (pull < LOCK || pull <= Math.abs(p.screenX - topX)) {
					return
				}
				claim(topY + LOCK)
			}
		}
		// 抽屉拖动全程拦截默认行为：内容滚动区不参与这次手势
		e.preventDefault()
		const top = 0
		const bottom = yClosed()
		const raw = baseY + (p.screenY - startY)
		let y = raw
		if (!peek.value) {
			y = Math.max(top, Math.min(bottom, raw))
		} else if (raw < top) {
			y = top - rubber(top - raw, Math.min(OVER_MAX, panelTop.value))
		} else if (raw > bottom) {
			y = bottom + rubber(raw - bottom, OVER_MAX)
		}
		writeY(y)
		sample(p, stampOf(e))
	}

	const onTouchEnd = (e : TouchEvent) => {
		headerTouched = false
		handleTouched = false
		if (dragTouchId == null) {
			return
		}
		// #ifdef MP-WEIXIN
		// 松手事件带着手指的最后位置，补一次采样：最后一段位移可能没有单独的移动事件。
		// 逻辑层收到的移动事件稀疏，这段的间隔上限放宽到 V_STALE
		const last = findTouch(e, dragTouchId)
		if (last != null) {
			sample(last, stampOf(e), V_STALE)
		}
		// #endif
		dragTouchId = null
		const wasSheet = mode === 'sheet'
		mode = 'none'
		const v = (stampOf(e) - trackT < V_STALE) ? carryMs : 0
		// 没带动面板，或带动后位移仍在点击容差内且不算快甩：这次触摸是点击
		const still = !wasSheet || (Math.abs(panelH.value - sheetY - baseH) < TAP_SLOP && Math.abs(v) <= FLING_V)
		// 停在关闭位时点击把手展开（没有把手时点标题行）
		if (still && fromClosed && (fromHandle || (!showHandle.value && fromHeader))) {
			if (wasSheet) {
				writeY(yClosed())
				phase = 'closed'
			}
			open()
			return
		}
		if (!wasSheet) {
			return
		}
		// 点击：回当前目标；拖动：按松手位置与速度选展开或收起，带速度松手由弹簧承接
		setOpened(still ? opened.value : pickOpen(v))
		slideTo(opened.value, false, still ? 0 : v, !still)
	}

	// 系统打断（来电等）：回到当前目标
	const onTouchCancel = () => {
		headerTouched = false
		handleTouched = false
		if (dragTouchId == null) {
			return
		}
		dragTouchId = null
		if (mode === 'sheet') {
			mode = 'none'
			slideTo(opened.value)
		}
		mode = 'none'
	}

	// 遮罩点击与返回键：可关闭则关闭
	const onMaskClick = () => {
		if (props.closable === true) {
			close()
		}
	}

	watch(() => props.visible, (v : boolean) => {
		if (v) {
			open()
		} else {
			close()
		}
	})

	// 头部形态变化：关闭位高度随之变化，重新对位，再量布局
	watch(() => props.head, () => {
		resetHeadH()
		if (syncClosed()) {
			realign()
		}
		nextTick(() => {
			fitLayout(true)
		})
	})

	// 淡入层不再渲染：丢弃缓存的元素
	watch(fading, (v : boolean) => {
		if (!v) {
			writer.dropFadeNode()
		}
	})

	onMounted(() => {
		measure()
		// 露头模式：面板与内容随挂载创建，整块面板先落在屏幕外，再升到关闭位
		if (peek.value) {
			mounted.value = true
			shown.value = true
			// 自动高度等打开前再量（打开流程会等量定高度再入场），其余模式挂载即量头部
			if (!autoFit.value) {
				nextTick(() => {
					fitLayout(true)
				})
			}
			writeY(panelH.value + reserve.value)
			slideIn()
		} else {
			writeY(yClosed())
		}
		// 挂载时元素可能还没登记（Web 按 id 查询）：延后按当前位移重写
		writer.rewriteAfterMount(() => {
			writeY(sheetY)
		})
		if (props.visible === true) {
			open()
		}
	})

	// 插槽内容变化后重量布局（自动高度时含内容自然高度）
	onUpdated(() => {
		fitLayout()
	})

	onUnmounted(() => {
		stopAnims()
	})

	// onGuardStart、onGuardTop 供小程序端滚动守卫经 callMethod 调用；fit 供内容变化未触发更新时主动重量
	defineExpose({ close, fit, onGuardStart, onGuardTop })
</script>

<!-- #ifdef MP-WEIXIN -->
<!-- 内容区滚动守卫（视图层）：小程序的滚动区会把内部的触摸移动截住不外传，守卫绑在滚动区的内容层上 -->
<script src="./app-sheet-guard.wxs" module="guard" lang="wxs"></script>
<!-- #endif -->

<style lang="scss">
	/* 按压类（styles/press.scss）：关闭钮 */
	@import '@/styles/press.scss';

	/* 面板：几何由 JS 下发（top/height），位移由 JS 逐帧写入；层序须高于 app-mask 的 999 */
	.app-sheet-panel {
		position: fixed;
		left: 0;
		right: 0;
		z-index: 1000;
		overflow: hidden;
		border-radius: var(--std-radius) var(--std-radius) 0 0;
		background-color: var(--std-emphasis-bg);
		/* #ifndef APP */
		will-change: transform;
		/* #endif */
	}

	.app-sheet-panel-hide {
		display: none;
	}

	/* 露头模式：面板浮在页面内容上，顶边向上投影；细线用于底色相近或暗色时勾出边界 */
	.app-sheet-panel-float {
		border-top: 1px solid var(--std-border-color);
		box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
	}

	/* 主体：铺满面板，头部在上、内容区在下 */
	.app-sheet-body {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
	}

	/* 内容区：铺满头部下方 */
	.app-sheet-main {
		flex: 1;
		position: relative;
	}

	.app-sheet-scroll {
		flex: 1;
	}

	/* #ifdef WEB */
	/* 内容滚到边后不把余量传给页面（触摸与鼠标滚轮）。Web 的 scroll-view 根节点不滚动，滚动的是运行时内建的 .uni-scroll-view 层，
	   须穿透组件样式作用域；小程序由 app-sheet-guard.wxs 在视图层拦，App 的滚动区默认不带动页面 */
	.app-sheet-scroll :deep(.uni-scroll-view) {
		overscroll-behavior: contain;
	}
	/* #endif */

	.app-sheet-bottom-safe {
		height: var(--uni-safe-area-inset-bottom);
	}

	/* 裸内容容器：调用方的滚动容器在其中撑满 */
	.app-sheet-bare {
		flex: 1;
	}

	/* 内容淡入层：铺满内容区、与面板同底色，压在内容之上 */
	.app-sheet-fade {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		background-color: var(--std-emphasis-bg);
	}

	/* 头部：把手行、标题行按 head 显示 */
	.app-sheet-header {
		flex-direction: column;
	}

	/* 把手行 */
	.app-sheet-handle {
		height: 48px;
		align-items: center;
		justify-content: center;
	}

	.app-sheet-handle-bar {
		width: 36px;
		height: 4px;
		border-radius: 2px;
		background-color: var(--std-fourth-color);
	}

	/* 标题行 */
	.app-sheet-row {
		height: 56px;
		flex-direction: row;
		align-items: center;
	}

	/* 左右槽：内距取页面边距，不参与压缩；两槽等宽（宽度由 fitLayout 量得），标题因此居中 */
	.app-sheet-side {
		flex-shrink: 0;
		height: 44px;
		padding: 0 var(--std-page-margin-x);
		flex-direction: row;
		align-items: center;
	}

	.app-sheet-side--end {
		justify-content: flex-end;
	}

	/* 占位层：最小宽度=两槽统一宽度；内层包插槽内容，保持自然宽供量测 */
	.app-sheet-side-fill {
		flex-direction: row;
		align-items: center;
	}

	.app-sheet-side-fill--end {
		justify-content: flex-end;
	}

	.app-sheet-side-inner {
		flex-direction: row;
		align-items: center;
	}

	/* 标题：占满两槽之间，内容居中，超出裁剪 */
	.app-sheet-title {
		flex: 1;
		min-width: 0;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		overflow: hidden;
	}

	/* 标题文字：超长时收缩到可用宽度，尾部省略 */
	.app-sheet-title-text {
		flex-shrink: 1;
		min-width: 0px;
		white-space: nowrap;
		text-overflow: ellipsis;
		overflow: hidden;
		font-weight: 600;
		font-size: var(--std-text-lg);
		line-height: var(--std-leading-lg);
		color: var(--std-emphasis-color);
	}

	/* 关闭钮：圆形，热区 44 */
	.app-sheet-close {
		width: 44px;
		height: 44px;
		border-radius: var(--std-radius-full);
		background-color: var(--std-secondary-bg);
		justify-content: center;
		align-items: center;
	}

	.app-sheet-close-icon {
		font-size: 18px;
		color: var(--std-emphasis-color);
	}
</style>
