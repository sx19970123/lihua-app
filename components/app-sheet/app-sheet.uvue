<template>
	<view class="app-sheet">
		<!-- 遮罩与面板同父兄弟、同为 fixed，层序靠显式 z-index（面板高于 app-mask 的 999） -->
		<app-mask v-if="overlay" ref="maskEl" @click="onMaskClick" @backpress="onMaskClick" />
		<!-- 面板与淡入层按 id 取元素，不用模板 ref：小程序真机上带 ref 的元素逐帧改样式会中断拖动 -->
		<view :id="panelId" class="app-sheet-panel" :class="panelCls" :style="panelStyle"
			@touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd" @touchcancel="onTouchCancel">
			<!-- 内容在露头模式或首次打开时挂载，之后常驻；头部在上，内容区在下 -->
			<!-- 内容主体只占可见高度：底部让出面板多出的那一截 -->
			<view v-if="mounted" class="app-sheet-body" :style="{ bottom: reserve + 'px' }">
					<!-- 头部（整条是拖动热区）：把手行与标题行按 head 显示；标题行里左右槽等宽、标题居中。
						触摸移动就地处理，不冒泡、不带动页面滚动（小程序端靠修饰符编译成 catch） -->
					<view class="app-sheet-header" @touchstart="onHeaderTouchStart" @touchmove.stop.prevent="onTouchMove">
					<!-- 把手：停在关闭位时点击展开 -->
					<view v-if="showHandle" class="app-sheet-handle" @touchstart="onHandleTouchStart">
						<view class="app-sheet-handle-bar" />
					</view>
					<view v-if="showHeader" class="app-sheet-row">
						<view class="app-sheet-side">
							<view class="app-sheet-side-fill" :style="sideStyle">
								<view class="app-sheet-side-inner">
									<slot name="left" />
								</view>
							</view>
						</view>
						<view class="app-sheet-title">
							<slot name="title" :close="close">
								<text v-if="(title ?? '') !== ''" class="app-sheet-title-text">{{ title }}</text>
							</slot>
						</view>
						<view class="app-sheet-side app-sheet-side--end">
							<view class="app-sheet-side-fill app-sheet-side-fill--end" :style="sideStyle">
								<view class="app-sheet-side-inner">
									<slot name="right" :close="close">
										<view v-if="showClose" class="app-sheet-close"
											:hover-class="themeStore.isDark ? 'app-pressed-inset-dark' : 'app-pressed-inset'"
											:hover-stay-time="100" @click="close">
											<uni-icons class="app-sheet-close-icon" type="closeempty" />
										</view>
									</slot>
								</view>
							</view>
						</view>
					</view>
				</view>
				<!-- 内容区：铺满头部下方 -->
				<view class="app-sheet-main">
					<!-- 内置滚动：默认插槽 -->
					<scroll-view v-if="!isBare" class="app-sheet-scroll" direction="vertical" :bounces="false"
						@scroll="onBodyScroll">
						<!-- 内距层：scroll-view 自身 padding 不生效 -->
						<view>
							<slot />
							<view class="app-sheet-bottom-safe" />
						</view>
					</scroll-view>
					<!-- 裸内容：调用方自带滚动容器 -->
					<view v-else class="app-sheet-bare">
						<slot name="body" />
					</view>
					<!-- 内容淡入层：与面板同底色，盖在内容区上；透明度随展开进度归零，完全展开后不渲染 -->
					<view v-if="fading" :id="fadeId" class="app-sheet-fade" :style="fadeStyle" />
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	// 底部抽屉：面板在若干悬停点之间滑动，位移全 JS 驱动（入场曲线与吸附曲线），遮罩用 app-mask；头部在内容区上方。
	// 手势仲裁：头部（含把手）的纵向拖动带动面板；默认插槽的内容在顶部时下拉也带动面板，其余交给原生滚动；#body 模式不碰内容区手势。
	// 平台分叉（第 3 级，因小程序端元素引用无 .style）：写层 App/Web 走 setProperty 直驱，小程序走 :style 载体。

	import AppMask from '@/components/app-mask/app-mask.uvue'
	import { useThemeStore } from '@/stores/theme'
	import { rubber } from '@/utils/damping'
	import { getUUID } from '@/utils/uuid'

	// 可选布尔属性不传即为 false，默认开的开关须在 withDefaults 里显式给
	const props = withDefaults(defineProps<{
		// 显示（v-model:visible）
		visible?: boolean
		// 头部标题（#title 插槽的默认内容）
		title?: string
		// 可关闭：显示关闭钮，遮罩点击、返回键和下拉都能关；false 时只能由外部改 visible 关闭。露头模式停在关闭位时不显示关闭钮
		closable?: boolean
		// 可拖动：拖头部带动面板，内容在顶部时下拉也带动；closable=false 时恒不可拖
		draggable?: boolean
		// 内容在顶部时下拉带动面板（收起方向）；false 时只能拖头部
		closeOnContentDrag?: boolean
		// 是否带遮罩（返回键只在带遮罩时被拦截）
		overlay?: boolean
		// 面板高度：不传=占满页面内容区；0~1=内容区高度的比例；大于 1=像素（超过内容区高度时取内容区高度）
		height?: number
		// 露头：关闭位不是完全隐藏，而是露出头部和内容区顶部的一截（关闭位高度=头部高度+底部安全区）；面板与内容在挂载时就创建，吸附带回弹
		peek?: boolean
		// 头部形态：handle=只有把手，header=只有标题行，both=两者都有，none=都没有。不传时露头模式为 handle，否则为 header
		head?: string
		// 关闭位与全开之间的停靠高度，从小到大；取值同 height。不传=只有全开一档
		anchors?: number[]
		// 打开后停留的悬停序号（v-model:anchor）：0=关闭位，其余依次对应 anchors，最后一档为全开；缺省最高一档
		anchor?: number
	}>(), {
		closable : true,
		draggable : true,
		closeOnContentDrag : true,
		overlay : true
	})

	const emit = defineEmits<{
		(e : 'update:visible', value : boolean) : void
		(e : 'update:anchor', value : number) : void
		(e : 'open') : void
		(e : 'close') : void
	}>()

	// 头部三槽作用域给 close；自定义标题内容超长时的省略由调用方处理
	defineSlots<{
		default() : any
		left(props : { close : () => void }) : any
		title(props : { close : () => void }) : any
		right(props : { close : () => void }) : any
		body() : any
	}>()

	// 松手后停到的悬停点：速度超过 FLING_V（px/ms）顺速度方向取下一档，否则取离得最近的一档；松手前超过 V_STALE（ms）没有移动视为停住
	const FLING_V = 0.4
	const V_STALE = 100
	// 速度采样的最大间隔（ms）：与上一采样相隔更久（按住停顿）时上一采样不作数
	const V_GAP = 40
	// 帧间隔（ms）
	const FRAME_MS = 16
	// 入场时长（ms）：非露头模式从关闭位滑到最高一档，行程较短时等比缩短（下限四分之一）
	const ENTER_MS = 360
	// 到位判定：距目标的位移不超过该值（px）视为已到达
	const SETTLE_X = 0.5
	// 内容淡入：超出关闭位的露出高度到达第一档的该比例时内容完全显示
	const FADE_AT = 0.85
	// 头部各行高度（px，须与 .app-sheet-handle / .app-sheet-row 的样式同值）；量测后以量测值为准
	const HANDLE_H = 48
	const HEADER_H = 56
	// 露头模式到头拖动的橡皮筋：越过最高档或关闭位后，视觉越界的渐近幅度（px）；上侧还受面板顶到内容区顶的距离限制。
	// 面板底部同时多留同高度的延长段在屏幕外，面板向上越界时由它补位
	const OVER_MAX = 40
	// 头部带动面板的起拖阈值（px）：纵向位移超过它才算拖动
	const CLAIM_SLOP = 3
	// 内容区带动面板的锁定阈值（px）：内容在顶部时下拉超过它才接管，接管点之前的位移不带动面板
	const LOCK = 8
	// 点击容差（px）：带动面板后位移仍在容差内且不算快甩的，按点击处理
	const TAP_SLOP = 8
	// 吸附曲线：时长 SNAP_MS（ms）的缓出 cubic-bezier(SNAP_AX, SNAP_AY, SNAP_BX, SNAP_BY)，起步快、收尾速度为零。
	// 松手速度朝向目标且快于曲线起步速度时，改为按起步速度等于松手速度定时长（下限 SNAP_MIN），不减速接上手指
	const SNAP_MS = 300
	const SNAP_MIN = 100
	const SNAP_AX = 0.22
	const SNAP_AY = 0.8
	const SNAP_BX = 0.28
	const SNAP_BY = 1
	// 曲线起步速度（每毫秒走完行程的比例）
	const SNAP_SLOPE = SNAP_AY / SNAP_AX
	// 露头模式吸附的回弹：越过目标一小段再弹回，回弹段在吸附时长之外另加 BOUNCE_MS（ms）；
	// 越过幅度=行程的 BOUNCE_RATIO 倍、不超过 BOUNCE_MAX（px），另加朝向目标的速度项，在最高档上还不超出面板顶到内容区顶的距离
	const BOUNCE_MS = 90
	const BOUNCE_RATIO = 0.06
	const BOUNCE_MAX = 12
	// 回弹从吸附时长的该比例处开始鼓起
	const BOUNCE_AT = 0.6
	// 回弹的速度项：松手速度超出 BOUNCE_V0（px/ms）的部分按 BOUNCE_V_GAIN 折成像素，不超过 BOUNCE_V_MAX（px）
	const BOUNCE_V0 = 0.4
	const BOUNCE_V_GAIN = 8
	const BOUNCE_V_MAX = 24
	// 到头甩出：松手速度背向目标时，面板先顺速度冲出再折回；冲出段占吸附时长的 BOOST_AT，
	// 段内三分之一处冲到最远（BOOST_NORM 为该曲线的归一系数），吸附行程自最远点起算
	const BOOST_AT = 0.35
	const BOOST_NORM = 6.75

	// #ifdef APP
	// 宿主页：面板顶部对齐其内容区
	const page = getCurrentInstance()?.proxy?.$page
	// #endif
	// 组件实例（头部量测用）
	const owner = getCurrentInstance()?.proxy
	// 面板与淡入层的元素 id（同页多个抽屉须互不相同）
	const nodeKey = getUUID()
	const panelId = `app-sheet-panel-${nodeKey}`
	const fadeId = `app-sheet-fade-${nodeKey}`
	// #ifndef MP-WEIXIN
	// 宿主页与取到的元素：元素经宿主页按 id 查询后缓存
	let hostPage : any = null
	let panelNode : any = null
	let fadeNode : any = null
	// 淡入层当前透明度：淡入层元素创建后补写
	let fadeCover = 1
	// #endif
	// 页面内容区的底部安全区高度（px），与样式变量 --uni-safe-area-inset-bottom 同值
	const safeBottom = () : number => {
		// #ifdef APP
		return page?.safeAreaInsets.bottom ?? 0
		// #endif
		// #ifndef APP
		return uni.getWindowInfo().safeAreaInsets.bottom ?? 0
		// #endif
	}

	const themeStore = useThemeStore()
	themeStore.init()

	const slots = useSlots()
	// 裸内容模式：调用方自带滚动容器
	const isBare = computed<boolean>(() => !!slots.body)
	const canDrag = computed<boolean>(() => props.closable === true && props.draggable === true)
	// 露头模式：关闭位露出头部
	const peek = computed<boolean>(() => props.peek === true)
	// 头部形态：把手行 / 标题行是否显示
	const showHandle = computed<boolean>(() => props.head == 'handle' || props.head == 'both' || (props.head == null && peek.value))
	const showHeader = computed<boolean>(() => props.head == 'header' || props.head == 'both' || (props.head == null && !peek.value))

	const maskEl = ref<any>(null)
	// 小程序端的位移载体；App/Web 载体只放几何，位移不进载体（避免重渲染贴回）
	const carrierY = ref<number>(0)
	// 面板几何（页面内容区坐标）：panelTop=面板顶；panelH=面板可见高度（关闭位的位移量）。
	// 露头模式面板实际高度多出 reserve：向上越界时面板抬起，多出的这截从屏幕底补进来，底部不留空
	const panelTop = ref<number>(0)
	const panelH = ref<number>(1)
	const reserve = computed<number>(() => peek.value ? OVER_MAX : 0)
	const panelStyle = computed<any>(() => {
		const style : any = { top: panelTop.value + 'px', height: (panelH.value + reserve.value) + 'px' }
		// #ifdef MP-WEIXIN
		style.transform = `translateY(${carrierY.value}px)`
		// #endif
		return style
	})

	// 内容淡入层：小程序走 :style 载体；App/Web 载体为空，透明度由 writeY 直驱
	const fading = ref<boolean>(false)
	const fadeOpacity = ref<number>(1)
	const fadeStyle = computed<any>(() => {
		// #ifdef MP-WEIXIN
		return { opacity: fadeOpacity.value }
		// #endif
		// #ifndef MP-WEIXIN
		return {}
		// #endif
	})

	// 可用高度（px）：悬停点按比例换算时用
	let areaH = 1
	// 露头时关闭位的高度（px）=头部行高+底部安全区：初值按形态取样式常量，量测后更新
	let headH = 1
	const resetHeadH = () => {
		const rows = (showHandle.value ? HANDLE_H : 0) + (showHeader.value ? HEADER_H : 0)
		headH = Math.max(1, peek.value && rows > 0 ? rows + safeBottom() : rows)
	}
	resetHeadH()
	// 各悬停点的露出高度（px，从小到大）：0 号=关闭位（露头时为头部高度，否则为 0），末位=全开
	let anchorHs : number[] = [0]
	// 当前（目标）悬停序号，0=关闭位
	const anchorIdx = ref<number>(0)
	// 默认关闭钮：有标题行才显示；露头且停在关闭位时不显示
	const showClose = computed<boolean>(() => props.closable === true && showHeader.value && !(peek.value && anchorIdx.value === 0))

	// 悬停点 idx 对应的面板位移；面板位移=面板高度−露出高度
	const yOf = (idx : number) : number => panelH.value - anchorHs[idx]

	// 离露出高度 h 最近的悬停序号
	const nearestIdx = (h : number) : number => {
		let best = 0
		for (let i = 1; i < anchorHs.length; i++) {
			if (Math.abs(anchorHs[i] - h) < Math.abs(anchorHs[best] - h)) {
				best = i
			}
		}
		return best
	}

	// 解析各悬停点的露出高度：关闭位、anchors（夹在关闭位与全开之间，去重升序）、全开；返回与之前相比是否有变化
	const resolveAnchors = () : boolean => {
		const closed = peek.value ? Math.min(headH, panelH.value - 1) : 0
		const list : number[] = []
		const as = props.anchors
		if (as != null) {
			for (let i = 0; i < as.length; i++) {
				const a = as[i]
				const ah = a <= 1 ? Math.round(areaH * a) : a
				if (ah > closed && ah < panelH.value) {
					list.push(ah)
				}
			}
		}
		list.sort((a : number, b : number) : number => a - b)
		const next : number[] = [closed]
		for (let i = 0; i < list.length; i++) {
			if (list[i] - next[next.length - 1] > 1) {
				next.push(list[i])
			}
		}
		next.push(panelH.value)
		let same = next.length == anchorHs.length
		for (let i = 0; same && i < next.length; i++) {
			same = next[i] == anchorHs[i]
		}
		anchorHs = next
		return !same
	}

	// 量几何：top=面板顶让出的高度（导航栏或状态栏），areaH=可用高度；每次打开前调用
	const measure = () => {
		const win = uni.getWindowInfo()
		let top = 0
		areaH = 1
		// #ifdef WEB
		// Web 的导航栏与 tabBar 是页内元素：面板让出导航栏，tabBar 页再让出 tabBar；windowHeight 已不含两者，勿再扣
		top = Math.max(win.windowTop ?? 0, win.statusBarHeight ?? 0)
		areaH = Math.max(1, win.windowHeight)
		// #endif
		// #ifdef MP-WEIXIN
		// 小程序页面内容区本就从导航栏下方起算
		areaH = Math.max(1, win.windowHeight)
		// #endif
		// #ifndef WEB || MP-WEIXIN
		// App：面板顶让出「状态栏高 − 内容区顶」；自定义导航页的内容区从屏幕顶起算
		const body = page?.pageBody
		const bodyTop = body == null ? 0 : body.top
		top = Math.max(0, (win.statusBarHeight ?? 0) - bodyTop)
		areaH = Math.max(1, win.windowHeight - top)
		// #endif
		const h = props.height
		const ph = h == null || h <= 0 ? areaH : h <= 1 ? Math.round(areaH * h) : Math.min(h, areaH)
		panelH.value = Math.max(1, ph)
		panelTop.value = top + (areaH - panelH.value)
		resolveAnchors()
	}

	// closed 停在关闭位 / enter 展开中（外部触发） / open 停在展开位 / drag 拖动中 / settle 吸附中 / leave 收起中
	type Phase = 'closed' | 'enter' | 'open' | 'drag' | 'settle' | 'leave'
	let phase : Phase = 'closed'
	let sheetY = panelH.value
	// 当前跟踪的触点标识；null=没有。标识由系统分配、可为任意整数（iOS Safari 为负数），不能拿具体数值表示「没有」
	let dragTouchId : number | null = null
	// none=还没带动面板 / sheet=抽屉拖动中
	let mode : 'none' | 'sheet' = 'none'
	const shown = ref<boolean>(false)
	const mounted = ref<boolean>(false)
	// 面板修饰类：未显示时隐藏；露头模式面板浮在页面上，带顶边阴影与细线
	const panelCls = computed<string>(() => {
		if (!shown.value) {
			return 'app-sheet-panel-hide'
		}
		return peek.value ? 'app-sheet-panel-float' : ''
	})

	// 内置滚动区是否在顶部：内容区下拉能否带动面板的判定用
	const atTop = ref<boolean>(true)

	const onBodyScroll = (e : UniScrollEvent) => {
		const top = e.detail.scrollTop <= 0
		if (top !== atTop.value) {
			atTop.value = top
		}
	}

	// #ifndef MP-WEIXIN
	// 面板元素：首次向宿主页查询后缓存
	const panelNodeOf = () : any => {
		if (panelNode == null) {
			panelNode = hostPage?.getElementById(panelId) ?? null
		}
		return panelNode
	}
	// 淡入层元素：随显示才创建，取到后补写当前透明度
	const fadeNodeOf = () : any => {
		if (fadeNode == null) {
			fadeNode = hostPage?.getElementById(fadeId) ?? null
			fadeNode?.style.setProperty('opacity', String(fadeCover))
		}
		return fadeNode
	}
	// #endif

	// 唯一写口：面板位移、遮罩进度（=关闭位到最高一档之间的展开比例）与内容淡入层透明度同帧下发
	const writeY = (y : number) => {
		sheetY = y
		// #ifndef MP-WEIXIN
		panelNodeOf()?.style.setProperty('transform', `translateY(${y}px)`)
		// #endif
		// #ifdef MP-WEIXIN
		carrierY.value = y
		// #endif
		const beyond = panelH.value - y - anchorHs[0]
		const span = anchorHs[anchorHs.length - 1] - anchorHs[0]
		const p = span > 0 ? Math.max(0, Math.min(1, beyond / span)) : 1
		maskEl.value?.setProgress(p)
		// 淡入层：超出关闭位的露出高度到达第一档的 FADE_AT 倍时透明度归零，之后不再渲染（停在任何一档内容都已完全显示）。
		// 露头模式停在关闭位时内容区就露出一截，不盖
		const first = anchorHs.length > 1 ? anchorHs[1] - anchorHs[0] : span
		const cover = peek.value || first <= 0 ? 0 : 1 - Math.min(1, beyond / (first * FADE_AT))
		fading.value = cover > 0
		// #ifndef MP-WEIXIN
		fadeCover = cover
		if (fading.value) {
			fadeNodeOf()?.style.setProperty('opacity', String(cover))
		}
		// #endif
		// #ifdef MP-WEIXIN
		fadeOpacity.value = cover
		// #endif
	}

	let animTimer : number | null = null
	const stopAnims = () => {
		if (animTimer != null) {
			clearInterval(animTimer)
			animTimer = null
		}
	}

	// 帧循环：各段动画共用一个定时器，每帧送入自首帧起流逝的毫秒数（首帧记 FRAME_MS）
	const startFrames = (frame : (ms : number) => void) => {
		stopAnims()
		let t0 = -1
		animTimer = setInterval(() => {
			const now = Date.now()
			if (t0 < 0) {
				t0 = now - FRAME_MS
			}
			frame(now - t0)
		}, FRAME_MS)
	}

	// 缓出曲线 cubic-bezier(SNAP_AX, SNAP_AY, SNAP_BX, SNAP_BY)：入参为时间比例，返回走过的行程比例。
	// 贝塞尔的横坐标不是时间：先用牛顿迭代由横坐标反解参数，再取纵坐标
	const easeOut = (x : number) : number => {
		let t = x
		for (let i = 0; i < 4; i++) {
			const o = 1 - t
			const cx = 3 * o * o * t * SNAP_AX + 3 * o * t * t * SNAP_BX + t * t * t - x
			const dx = 3 * o * o * SNAP_AX + 6 * o * t * (SNAP_BX - SNAP_AX) + 3 * t * t * (1 - SNAP_BX)
			if (dx == 0) {
				break
			}
			t = t - cx / dx
		}
		t = Math.max(0, Math.min(1, t))
		const o = 1 - t
		return 3 * o * o * t * SNAP_AY + 3 * o * t * t * SNAP_BY + t * t * t
	}

	// 是否正从关闭位展开 / 正收回关闭位（到位时发 open / close）
	let pendingOpen = false
	let pendingClose = false

	// 到达展开位
	const finishOpen = () => {
		phase = 'open'
		if (pendingOpen) {
			pendingOpen = false
			emit('open')
		}
	}

	// 到达关闭位并通知外部；露头模式面板常驻
	const finishClose = () => {
		writeY(yOf(0))
		pendingOpen = false
		phase = 'closed'
		if (!peek.value) {
			fading.value = false
			shown.value = false
			// 面板已隐藏：按住未松的触摸不再带动面板
			dragTouchId = null
			mode = 'none'
		}
		if (pendingClose) {
			pendingClose = false
			emit('close')
		}
	}

	// 回弹的速度项（px）：速度（px/ms）未超过 BOUNCE_V0 时为 0
	const kickOf = (speed : number) : number => Math.min(BOUNCE_V_MAX, BOUNCE_V_GAIN * Math.max(0, speed - BOUNCE_V0))

	// 面板走到悬停点 idx。enter=从关闭位的入场：非露头模式走入场曲线（行程越短越快，下限 ENTER_MS/4）；
	// 其余走吸附曲线，v=松手速度（px/ms，正值向下）：朝向目标时缩短时长、加大回弹；背向目标时（露头模式在最高档之上甩出）先顺速度冲出再折回。
	// 已在目标则直接收尾
	const slideTo = (idx : number, enter : boolean = false, v : number = 0) => {
		stopAnims()
		const to = yOf(idx)
		const from = sheetY
		const dist = Math.abs(from - to)
		if (idx === 0) {
			phase = 'leave'
			// 已在关闭位或更靠下（拖出屏外）直接收尾
			if (from >= to - SETTLE_X) {
				finishClose()
				return
			}
		} else {
			phase = enter ? 'enter' : 'settle'
			if (dist <= SETTLE_X) {
				writeY(to)
				finishOpen()
				return
			}
		}
		if (enter && !peek.value) {
			const ms = Math.max(ENTER_MS / 4, ENTER_MS * dist / panelH.value)
			startFrames((t : number) => {
				const x = Math.min(1, t / ms)
				if (x >= 1) {
					stopAnims()
					writeY(to)
					finishOpen()
					return
				}
				// 曲线：速度线性升到峰值后按平方衰减；r 为剩余行程比例
				const r = (1 - x) * (1 - x) * (1 - x) * (1 + 3 * x)
				writeY(to + (from - to) * r)
			})
			return
		}
		const toward = v * (to - from) > 0 ? Math.abs(v) : 0
		const away = v * (to - from) < 0 ? Math.abs(v) : 0
		const ms = toward > 0 ? Math.max(SNAP_MIN, Math.min(SNAP_MS, dist * SNAP_SLOPE / toward)) : SNAP_MS
		// 露头模式带回弹：越过目标 over 再弹回，吸附总时长加长到 k 倍
		let over = 0
		if (peek.value) {
			over = Math.min(BOUNCE_MAX, BOUNCE_RATIO * dist) + kickOf(toward)
			// 最高档上不超出面板顶到内容区顶的距离
			if (idx === anchorHs.length - 1) {
				over = Math.min(over, panelTop.value)
			}
		}
		// 到头甩出的冲出量：冲出量与松手时的越界量合计不超过到头拖动的越界上限
		let boost = 0
		if (peek.value && idx === anchorHs.length - 1 && away > 0) {
			boost = Math.max(0, Math.min(Math.min(OVER_MAX, panelTop.value) - dist, kickOf(away)))
		}
		const k = over > 0 ? (SNAP_MS + BOUNCE_MS) / SNAP_MS : 1
		// 冲出时吸附行程顺延：过最远点起算，总时长相应多出这一段
		const peak = boost > 0 ? BOOST_AT / 3 : 0
		const span = k + peak
		const dir = to > from ? 1 : -1
		startFrames((t : number) => {
			const x = Math.min(1, t / (ms * span))
			if (x >= 1) {
				stopAnims()
				writeY(to)
				if (idx === 0) {
					finishClose()
				} else {
					finishOpen()
				}
				return
			}
			// 吸附行程按原时长走完；回弹从吸附时长的 BOUNCE_AT 处按正弦平方鼓起，到总时长末尾归零
			const at = x * span
			const run = at > peak ? at - peak : 0
			let step = dist * easeOut(Math.min(1, run))
			const u = (run - BOUNCE_AT) / (k - BOUNCE_AT)
			if (over > 0 && u > 0) {
				const s = Math.sin(Math.PI * u)
				step = step + over * s * s
			}
			// 冲出段：吸附时长的 BOOST_AT 之内背离目标冲出 boost，再收回
			if (boost > 0 && at < BOOST_AT) {
				const w = at / BOOST_AT
				step = step - boost * BOOST_NORM * w * (1 - w) * (1 - w)
			}
			writeY(from + dir * step)
		})
	}

	// 切换目标悬停点并通知外部；返回是否有变化
	const setAnchor = (idx : number) : boolean => {
		if (idx === anchorIdx.value) {
			return false
		}
		const wasClosed = anchorIdx.value === 0
		anchorIdx.value = idx
		emit('update:anchor', idx)
		if (wasClosed) {
			pendingOpen = true
			if (props.visible !== true) {
				emit('update:visible', true)
			}
		} else if (idx === 0) {
			pendingClose = true
			emit('update:visible', false)
		}
		return true
	}

	// ---------- 头部量测 ----------
	// 两槽统一的最小宽度（px）：初值取标准控件宽，量测后取两槽自然宽的较宽者（不低于标准控件宽）；标题在等宽的两槽之间居中
	const SIDE_MIN = 44
	const sideW = ref<number>(SIDE_MIN)
	const sideStyle = computed<any>(() => ({ minWidth: sideW.value + 'px' }))
	// 布局未就绪时的重量次数
	let fitRetry = 0

	// 悬停点变化后重新对位：静止的直接落到当前目标，运动中的从当前位置重走
	const realign = () => {
		anchorIdx.value = Math.min(anchorIdx.value, anchorHs.length - 1)
		const idx = anchorIdx.value
		if (phase === 'closed' || phase === 'open') {
			writeY(yOf(idx))
		} else if (phase === 'enter' || phase === 'settle' || phase === 'leave') {
			slideTo(idx)
		}
	}

	// 量头部高度（露头时作为关闭位）与标题行左右槽的自然宽；force 用于刚打开或刚挂载时（此时动画可能在跑）
	const fitHead = (force : boolean = false) : void => {
		if (!shown.value || (!force && (animTimer != null || phase === 'drag'))) {
			return
		}
		uni.createSelectorQuery().in(owner)?.select('.app-sheet-header')?.boundingClientRect()?.selectAll('.app-sheet-side-inner')?.boundingClientRect()?.exec((ret) => {
			const head = ret[0] as { height : number } | null
			const rects = ret[1] as Array<{ width : number }> | null
			if (head == null || rects == null) {
				return
			}
			// 没有头部可量
			if (!showHandle.value && !showHeader.value) {
				return
			}
			// 头部还没排出布局：稍后重量，最多三次
			if (head.height <= 0) {
				if (force && fitRetry < 3) {
					fitRetry++
					setTimeout(() => {
						fitHead(true)
					}, 32)
				}
				return
			}
			fitRetry = 0
			let w = 0
			for (let i = 0; i < rects.length; i++) {
				if (rects[i].width > w) {
					w = rects[i].width
				}
			}
			sideW.value = Math.max(SIDE_MIN, Math.ceil(w))
			// 头部实高与常量不一致时，按实高修正关闭位（露头时再加底部安全区）
			if (peek.value) {
				const real = Math.round(head.height) + safeBottom()
				if (real != headH) {
					headH = Math.max(1, real)
					resolveAnchors()
					realign()
				}
			}
		})
	}

	// 展开到悬停点：anchor 指定的序号（v-model:anchor），缺省最高一档；从关闭位展开时按入场处理
	const open = () => {
		if (phase === 'drag') {
			return
		}
		const enter = phase === 'closed'
		if (enter) {
			measure()
			writeY(yOf(0))
			mounted.value = true
			shown.value = true
			fitRetry = 0
			nextTick(() => {
				fitHead(true)
			})
		}
		const a = props.anchor
		const idx = a != null && a > 0 ? Math.min(Math.floor(a), anchorHs.length - 1) : anchorHs.length - 1
		if (phase === 'open' && anchorIdx.value === idx) {
			return
		}
		setAnchor(idx)
		slideTo(idx, enter)
	}

	// 收起到关闭位
	const close = () => {
		if (anchorIdx.value === 0 && (phase === 'closed' || phase === 'leave')) {
			return
		}
		// 拖动中被外部收起：先结束这次拖动
		if (phase === 'drag') {
			dragTouchId = null
			mode = 'none'
		}
		setAnchor(0)
		slideTo(0)
	}

	// ---------- 手势 ----------
	let startY = 0
	let baseY = 0
	// 起拖时的露出高度：松手时据此判断这次触摸有没有真的拖动面板
	let baseH = 0
	// 起拖时面板是否停在关闭位
	let fromClosed = false
	let fromHeader = false
	let fromHandle = false
	// 头部、把手自身的 touchstart 先于面板触发，用它们标记触点起点
	let headerTouched = false
	let handleTouched = false
	// 松手速度：按下起全程统计，取最近两段位移的平均速度（px/ms，正值向下），用来选目标悬停点和吸附时长
	let carryMs = 0
	let trackY = 0
	let trackT = 0
	let prevY = 0
	let prevT = 0
	// 内容在顶部时手指的位置：内容区的下拉从这里起算；-1=内容不在顶部
	let topX = 0
	let topY = -1

	const findTouch = (e : TouchEvent, id : number) : Touch | null => {
		for (let i = 0; i < e.changedTouches.length; i++) {
			if (e.changedTouches[i].identifier === id) {
				return e.changedTouches[i]
			}
		}
		for (let i = 0; i < e.touches.length; i++) {
			if (e.touches[i].identifier === id) {
				return e.touches[i]
			}
		}
		return null
	}

	const onHeaderTouchStart = () => {
		headerTouched = true
	}

	const onHandleTouchStart = () => {
		handleTouched = true
	}

	// 松手后停在哪个悬停点。v=松手速度（px/ms，正值向下）
	const pickAnchor = (v : number) : number => {
		const last = anchorHs.length - 1
		// 到头拖动的越界段：回到被越过的那一档
		if (sheetY <= yOf(last)) {
			return last
		}
		if (sheetY >= yOf(0)) {
			return 0
		}
		const h = panelH.value - sheetY
		// 快甩：顺速度方向取越过当前位置的第一档
		if (Math.abs(v) > FLING_V) {
			if (v < 0) {
				for (let i = 0; i <= last; i++) {
					if (anchorHs[i] > h) {
						return i
					}
				}
			} else {
				for (let i = last; i >= 0; i--) {
					if (anchorHs[i] < h) {
						return i
					}
				}
			}
		}
		// 其余：离得最近的一档
		return nearestIdx(h)
	}

	// 带动面板：冻结在途动画，冻结位即起拖基准，此后面板位移=手指相对 originY 的位移
	const claim = (originY : number) => {
		stopAnims()
		baseY = sheetY
		baseH = panelH.value - baseY
		fromClosed = phase === 'closed'
		startY = originY
		prevT = 0
		phase = 'drag'
		mode = 'sheet'
	}

	const onTouchStart = (e : TouchEvent) => {
		fromHeader = headerTouched
		fromHandle = handleTouched
		headerTouched = false
		handleTouched = false
		// 露头模式面板常驻，收起过程中也能接住；其余情况的关闭位与收起过程中不接触摸
		if (dragTouchId != null || (phase === 'leave' && !peek.value) || (phase === 'closed' && !peek.value)) {
			return
		}
		const t = e.changedTouches.length > 0 ? e.changedTouches[0] : e.touches[0]
		if (t == null) {
			return
		}
		dragTouchId = t.identifier
		startY = t.screenY
		fromClosed = phase === 'closed'
		topX = t.screenX
		topY = atTop.value ? t.screenY : -1
		trackY = t.screenY
		trackT = Date.now()
		carryMs = 0
		prevT = 0
		mode = 'none'
	}

	const onTouchMove = (e : TouchEvent) => {
		const id = dragTouchId
		if (id == null) {
			return
		}
		const p = findTouch(e, id)
		if (p == null) {
			return
		}
		if (mode === 'none') {
			if (!canDrag.value) {
				return
			}
			if (fromHeader) {
				// 头部：纵向位移超过起拖阈值就带动，位移从按下点起算
				if (Math.abs(p.screenY - startY) < CLAIM_SLOP) {
					return
				}
				claim(startY)
			} else {
				// 内容区：须为内置滚动、允许内容带动，且内容在顶部（不在顶部时交给原生滚动）。
				// 以内容在顶部时的手指位置为基准，下拉超过锁定阈值且纵向为主才接管；接管点之前的位移不带动面板
				if (isBare.value || props.closeOnContentDrag !== true || !atTop.value) {
					topY = -1
					return
				}
				if (topY < 0) {
					topX = p.screenX
					topY = p.screenY
				}
				const pull = p.screenY - topY
				if (pull < LOCK || pull <= Math.abs(p.screenX - topX)) {
					return
				}
				claim(topY + LOCK)
			}
		}
		// 抽屉拖动全程拦截默认行为：内容滚动区不参与这次手势
		e.preventDefault()
		const top = yOf(anchorHs.length - 1)
		const bottom = yOf(0)
		const raw = baseY + (p.screenY - startY)
		let y = raw
		if (!peek.value) {
			y = Math.max(top, Math.min(bottom, raw))
		} else if (raw < top) {
			y = top - rubber(top - raw, Math.min(OVER_MAX, panelTop.value))
		} else if (raw > bottom) {
			y = bottom + rubber(raw - bottom, OVER_MAX)
		}
		writeY(y)
		// 速度采样：同一毫秒内的多次移动并作一次
		const now = Date.now()
		if (now == trackT) {
			trackY = p.screenY
			return
		}
		const dt = now - trackT
		const inst = dt <= V_GAP ? (p.screenY - trackY) / dt : 0
		carryMs = prevT > 0 && now - prevT <= V_GAP ? (p.screenY - prevY) / (now - prevT) : inst
		prevY = trackY
		prevT = trackT
		trackY = p.screenY
		trackT = now
	}

	const onTouchEnd = () => {
		headerTouched = false
		handleTouched = false
		if (dragTouchId == null) {
			return
		}
		dragTouchId = null
		const wasSheet = mode === 'sheet'
		mode = 'none'
		const v = (Date.now() - trackT < V_STALE) ? carryMs : 0
		// 没带动面板，或带动后位移仍在点击容差内且不算快甩：这次触摸是点击
		const still = !wasSheet || (Math.abs(panelH.value - sheetY - baseH) < TAP_SLOP && Math.abs(v) <= FLING_V)
		// 停在关闭位时点击把手展开（没有把手时点标题行）
		if (still && fromClosed && (fromHandle || (!showHandle.value && fromHeader))) {
			if (wasSheet) {
				writeY(yOf(0))
				phase = 'closed'
			}
			open()
			return
		}
		if (!wasSheet) {
			return
		}
		// 点击：回当前目标悬停点；拖动：按松手位置与速度选悬停点
		setAnchor(still ? anchorIdx.value : pickAnchor(v))
		slideTo(anchorIdx.value, false, still ? 0 : v)
	}

	// 系统打断（来电等）：回到当前目标悬停点
	const onTouchCancel = () => {
		headerTouched = false
		handleTouched = false
		if (dragTouchId == null) {
			return
		}
		dragTouchId = null
		if (mode === 'sheet') {
			mode = 'none'
			slideTo(anchorIdx.value)
		}
		mode = 'none'
	}

	// 遮罩点击与返回键：可关闭则关闭
	const onMaskClick = () => {
		if (props.closable === true) {
			close()
		}
	}

	watch(() => props.visible, (v : boolean) => {
		if (v) {
			open()
		} else {
			close()
		}
	})

	watch(() => props.anchor, (v : number) => {
		if (v <= 0) {
			close()
		} else if (v != anchorIdx.value) {
			open()
		}
	})

	// 头部形态变化：关闭位高度随之变化，重新解析并对位，再量头部
	watch(() => props.head, () => {
		resetHeadH()
		if (resolveAnchors()) {
			realign()
		}
		fitRetry = 0
		nextTick(() => {
			fitHead(true)
		})
	})

	// 悬停点配置变化：重新解析并对位
	watch(() => props.anchors, () => {
		if (resolveAnchors()) {
			realign()
		}
	})

	// #ifndef MP-WEIXIN
	// 淡入层不再渲染：丢弃缓存的元素
	watch(fading, (v : boolean) => {
		if (!v) {
			fadeNode = null
		}
	})
	// #endif

	onMounted(() => {
		// #ifndef MP-WEIXIN
		hostPage = owner?.$page ?? null
		// #endif
		measure()
		// 露头模式：面板与内容随挂载创建，停在关闭位
		if (peek.value) {
			mounted.value = true
			shown.value = true
			fitRetry = 0
			nextTick(() => {
				fitHead(true)
			})
		}
		writeY(yOf(0))
		// #ifndef MP-WEIXIN
		// 挂载时还没取到面板元素（宿主页尚未登记）：延后按当前位移重写
		if (panelNode == null) {
			setTimeout(() => {
				writeY(sheetY)
			}, 0)
		}
		// #endif
		if (props.visible === true) {
			open()
		}
	})

	// 插槽内容变化后重量头部
	onUpdated(() => {
		fitHead()
	})

	onUnmounted(() => {
		stopAnims()
	})

	defineExpose({ close })
</script>

<style lang="scss">
	/* 按压类（styles/press.scss）：关闭钮 */
	@import '@/styles/press.scss';

	/* 面板：几何由 JS 下发（top/height），位移由 JS 逐帧写入；层序须高于 app-mask 的 999 */
	.app-sheet-panel {
		position: fixed;
		left: 0;
		right: 0;
		z-index: 1000;
		overflow: hidden;
		border-radius: var(--std-radius) var(--std-radius) 0 0;
		background-color: var(--std-emphasis-bg);
	}

	.app-sheet-panel-hide {
		display: none;
	}

	/* 露头模式：面板浮在页面内容上，顶边向上投影；细线用于底色相近或暗色时勾出边界 */
	.app-sheet-panel-float {
		border-top: 1px solid var(--std-border-color);
		box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
	}

	/* 主体：铺满面板，头部在上、内容区在下 */
	.app-sheet-body {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
	}

	/* 内容区：铺满头部下方 */
	.app-sheet-main {
		flex: 1;
		position: relative;
	}

	.app-sheet-scroll {
		flex: 1;
	}

	.app-sheet-bottom-safe {
		height: var(--uni-safe-area-inset-bottom);
	}

	/* 裸内容容器：调用方的滚动容器在其中撑满 */
	.app-sheet-bare {
		flex: 1;
	}

	/* 内容淡入层：铺满内容区、与面板同底色，压在内容之上 */
	.app-sheet-fade {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		background-color: var(--std-emphasis-bg);
	}

	/* 头部：把手行、标题行按 head 显示 */
	.app-sheet-header {
		flex-direction: column;
	}

	/* 把手行 */
	.app-sheet-handle {
		height: 48px;
		align-items: center;
		justify-content: center;
	}

	.app-sheet-handle-bar {
		width: 36px;
		height: 4px;
		border-radius: 2px;
		background-color: var(--std-fourth-color);
	}

	/* 标题行 */
	.app-sheet-row {
		height: 56px;
		flex-direction: row;
		align-items: center;
	}

	/* 左右槽：内距取页面边距，不参与压缩；两槽等宽（宽度由 fitHead 量得），标题因此居中 */
	.app-sheet-side {
		flex-shrink: 0;
		height: 44px;
		padding: 0 var(--std-page-margin-x);
		flex-direction: row;
		align-items: center;
	}

	.app-sheet-side--end {
		justify-content: flex-end;
	}

	/* 占位层：最小宽度=两槽统一宽度；内层包插槽内容，保持自然宽供量测 */
	.app-sheet-side-fill {
		flex-direction: row;
		align-items: center;
	}

	.app-sheet-side-fill--end {
		justify-content: flex-end;
	}

	.app-sheet-side-inner {
		flex-direction: row;
		align-items: center;
	}

	/* 标题：占满两槽之间，内容居中，超出裁剪 */
	.app-sheet-title {
		flex: 1;
		min-width: 0;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		overflow: hidden;
	}

	/* 标题文字：超长时收缩到可用宽度，尾部省略 */
	.app-sheet-title-text {
		flex-shrink: 1;
		min-width: 0px;
		white-space: nowrap;
		text-overflow: ellipsis;
		overflow: hidden;
		font-weight: 600;
		font-size: var(--std-text-lg);
		line-height: var(--std-leading-lg);
		color: var(--std-emphasis-color);
	}

	/* 关闭钮：圆形，热区 44 */
	.app-sheet-close {
		width: 44px;
		height: 44px;
		border-radius: var(--std-radius-full);
		background-color: var(--std-secondary-bg);
		justify-content: center;
		align-items: center;
	}

	.app-sheet-close-icon {
		font-size: 18px;
		color: var(--std-emphasis-color);
	}
</style>
