<template>
	<view class="app-checkbox-group">
		<slot />
	</view>
</template>

<script setup lang="ts">
// checkbox 组容器：provide 上下文，子 app-checkbox 受控于选中值集合；勾选/取消转为 update:modelValue+change
const props = defineProps<{
	// 选中值集合（v-model，与子项 value 对应）
	modelValue?: string[]
}>()

const emit = defineEmits<{
	(e: 'update:modelValue', value: string[]): void
	(e: 'change', value: string[]): void
}>()

// includes/toggle 闭包读 props，保证子项 computed 的响应性
provide('app-checkbox-group', {
	includes: (value: string) => (props.modelValue ?? []).includes(value),
	toggle: (value: string) => {
		const list = props.modelValue ?? []
		const next = list.includes(value) ? list.filter(v => v !== value) : list.concat([value])
		emit('update:modelValue', next)
		emit('change', next)
	}
})
</script>

<style>
.app-checkbox-group {
	flex-direction: column;
	/* 组首边距（与组尾对称） */
	padding-top: var(--std-gap-sm);
}
</style>
