<template>
	<view ref="rootEl" class="app-mask" :class="rootCls" :style="carrierStyle" @click="onClick" @touchmove="onTouchMove" />
</template>

<script setup lang="ts">
	// 全窗口遮罩：页面内容区由本组件的页面内层压暗。内容区之外在 App 上由原生条带压暗（lihua-mask 插件），两层同值同帧；
	// Web 的导航栏与 tabBar 是页内元素，本层以层序直接盖过；小程序两者皆原生，覆盖不到。
	// 对外只有进度（0~1）和点击；要浮在遮罩上的内容须与其做同父兄弟、同为 fixed、层序大于 999。
	// 平台分叉（第 3 级，因小程序端元素引用无 .style）：写层 App/Web 走 setProperty 直驱，小程序走 :style 载体。

	import { hasNativeMask, showMask, setMaskAlpha, hideMask } from '@/uni_modules/lihua-mask'
	import { STD_MASK_ALPHA } from '@/utils/tokens-std'

	type MaskStrip = { top : number, bottom : number }

	// 可选布尔属性不传即为 false，默认开的开关须在 withDefaults 里显式给
	const props = withDefaults(defineProps<{
		// 显示（切换时按 duration 淡入淡出）
		visible?: boolean
		// 淡入淡出时长（ms），缺省 200；0=瞬变，供外部逐帧驱动 setProgress 的场景
		duration?: number
		// tab 页上是否压暗 tabBar
		coverTabBar?: boolean
	}>(), {
		coverTabBar : true
	})

	const emit = defineEmits<{
		(e : 'click') : void
	}>()

	const nativeReady = hasNativeMask()
	const rootEl = ref<any>(null)

	// 当前进度（0~1）与原生层挂载态：非响应式，逐帧只经写层下发
	let progress = props.visible === true ? 1 : 0
	let nativeOn = false
	// 宿主页隐藏期间原生层被摘掉，回来后重挂
	let nativePaused = false
	let tweenTimer : number | null = null

	// 进度大于 0 才显示；隐藏即 display:none（小程序端 pointer-events 不生效）
	const shown = ref<boolean>(props.visible === true)

	// 不盖 tabBar 时挂修饰类（类定义仅 Web 端有：其余端页面内层本来到不了 tabBar）
	const rootCls = computed<string>(() => {
		if (!shown.value) {
			return 'app-mask-hide'
		}
		return props.coverTabBar ? '' : 'app-mask-uncover-tabbar'
	})

	// 写层：小程序走 :style 载体；App/Web 载体恒为空对象，运行期的值全部 setProperty 直驱
	const carrierOpacity = ref<number>(progress)
	const carrierStyle = computed<any>(() => {
		// #ifdef MP-WEIXIN
		return { opacity: carrierOpacity.value }
		// #endif
		// #ifndef MP-WEIXIN
		return {}
		// #endif
	})

	const write = (p : number) => {
		// #ifndef MP-WEIXIN
		rootEl.value?.style.setProperty('opacity', String(p))
		// #endif
		// #ifdef MP-WEIXIN
		carrierOpacity.value = p
		// #endif
	}

	// 原生条带范围=页面内容区之外的区域：自定义导航页无顶条，非 tab 页无底条
	const buildStrips = () : MaskStrip[] => {
		const win = uni.getWindowInfo()
		const strips : MaskStrip[] = []
		if (win.windowTop > 0) {
			strips.push({ top: 0, bottom: win.windowTop })
		}
		if (props.coverTabBar && win.windowBottom > 0) {
			const top = win.windowTop + win.windowHeight
			strips.push({ top, bottom: top + win.windowBottom })
		}
		return strips
	}

	const onMaskTap = () => {
		emit('click')
	}

	const attachNative = () => {
		showMask(buildStrips(), progress * STD_MASK_ALPHA, onMaskTap)
	}

	// 唯一写口：进度离开 0 即显示并挂原生层，归零即收起并摘原生层
	const apply = (p : number) => {
		const v = Math.max(0, Math.min(1, p))
		progress = v
		const on = v > 0
		if (on !== shown.value) {
			shown.value = on
		}
		write(v)
		if (!nativeReady) {
			return
		}
		const wantNative = on && !nativePaused
		if (wantNative !== nativeOn) {
			nativeOn = wantNative
			if (nativeOn) {
				attachNative()
			} else {
				hideMask()
			}
		} else if (nativeOn) {
			setMaskAlpha(v * STD_MASK_ALPHA)
		}
	}

	const cancelTween = () => {
		if (tweenTimer != null) {
			clearInterval(tweenTimer)
			tweenTimer = null
		}
	}

	// 线性补间到目标进度，从当前进度起算
	const tweenTo = (to : number) => {
		cancelTween()
		const from = progress
		const duration = props.duration ?? 200
		if (duration <= 0 || Math.abs(to - from) < 0.01) {
			apply(to)
			return
		}
		const t0 = Date.now()
		tweenTimer = setInterval(() => {
			const k = Math.min(1, (Date.now() - t0) / duration)
			apply(from + (to - from) * k)
			if (k >= 1) {
				cancelTween()
			}
		}, 16)
	}

	// 外部逐帧驱动：调用后组件不再自行补间
	const setProgress = (p : number) => {
		cancelTween()
		apply(p)
	}

	const onClick = () => {
		emit('click')
	}

	// 遮罩上的触摸不带动宿主页滚动
	const onTouchMove = (e : TouchEvent) => {
		e.preventDefault()
	}

	watch(() => props.visible, (v : boolean) => {
		tweenTo(v ? 1 : 0)
	})

	// 显示中切换 tabBar 覆盖：按新范围重挂条带
	watch(() => props.coverTabBar, () => {
		if (nativeOn) {
			attachNative()
		}
	})

	// 原生层悬在窗口上，不随宿主页一起被盖住：宿主页隐藏时摘掉，回来后按当前进度重挂
	onPageHide(() => {
		if (!nativeOn) {
			return
		}
		nativePaused = true
		nativeOn = false
		hideMask()
	})
	onPageShow(() => {
		if (!nativePaused) {
			return
		}
		nativePaused = false
		if (progress > 0) {
			nativeOn = true
			attachNative()
		}
	})

	onMounted(() => {
		write(progress)
		if (progress > 0 && nativeReady) {
			nativeOn = true
			attachNative()
		}
	})

	onUnmounted(() => {
		cancelTween()
		if (nativeReady) {
			hideMask()
		}
	})

	defineExpose({ setProgress })
</script>

<style lang="scss">
	/* 页面内遮罩层：铺满可覆盖区域，色挂 --std-mask，透明度由 JS 逐帧下发；
	   层序须盖过 Web 导航栏/tabBar 的 998 */
	.app-mask {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 999;
		background-color: var(--std-mask);
	}

	/* #ifdef WEB */
	/* Web：左右边界与框架自身导航栏同口径（宽屏分栏时有左右窗） */
	.app-mask {
		left: var(--window-left, 0px);
		right: var(--window-right, 0px);
	}

	/* Web：不盖 tabBar 时底边上移一个 tabBar 高度 */
	.app-mask-uncover-tabbar {
		bottom: var(--window-bottom, 0px);
	}
	/* #endif */

	.app-mask-hide {
		display: none;
	}
</style>
