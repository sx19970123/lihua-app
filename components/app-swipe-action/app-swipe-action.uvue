<template>
		<view class="app-swipe-action" :class="removing ? 'app-swipe-action-removing' : ''"
			@touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd" @touchcancel="onTouchEnd">
		<!-- 行底分隔线（DOM 序最底；内层 list-item 的上探线会被裁切链裁掉，故侧滑行的线
		     由此提供，消费方内层行 :divider="false"） -->
		<view v-if="divider !== false" class="app-swipe-line app-pressed-row" />
		<!-- 裁切层（absolute 上探 1px 的纯按钮容器）：裁掉初始藏行外的按钮组；顶部探出
		     行界 1px=弹出色块盖住上一行底部分割线——按钮必须在 hidden 内（藏外需要），
		     探出只能由容器自身完成；线/内容挂裁切层外不受其裁切与位移影响 -->
		<view class="app-swipe-clip">
			<!-- 色块（恒宽叠塔）：宽=自身+右侧全部、右缘锚行右界，初始整体藏行右外，
			     拖动中按 d=W_i'×(1-p) 线性滑入（藏外量差=速率不同）；DOM 顺序=层序（最左钮最下层） -->
			<!-- 左组（恒宽叠塔镜像）：锚行左缘藏行左外，数组序=远端→贴内容 -->
			<!-- 元素 ref 只有 app/鸿蒙/H5 用（写层与量测）；MP 写通道是 style 载体，节点不带 ref。
			     属性级无 #ifdef，按钮组按平台分两份，两份只差 ref 属性 -->
			<!-- #ifndef MP-WEIXIN -->
			<view v-for="(action, index) in leftList" :key="action.event" ref="btnElsL" class="app-swipe-btn app-swipe-btn--left"
					:class="action.type === 'danger' ? 'app-swipe-btn-danger' : 'app-swipe-btn-primary'"
					:style="btnStyleL[index]"
					@touchstart="onBtnTouchStart($event, SIDE_L, index)" @click="onActionClick(action, SIDE_L, index)">
				<view class="app-swipe-btn-spinner" :class="spinnerAtL === index ? 'app-swipe-btn-spinner--on' : ''" :style="spinnerStyle">
					<uni-icons class="app-swipe-btn-spinner-icon" type="spinner-cycle" />
				</view>
				<text ref="textElsL" class="app-swipe-btn-text" :style="textStyleL[index]">{{ confirmSide === SIDE_L && confirmIndex === index ? confirmLabel : action.text }}</text>
			</view>
			<!-- 右组（恒宽叠塔）：锚行右缘藏行右外 -->
			<view v-for="(action, index) in rightList" :key="action.event" ref="btnElsR" class="app-swipe-btn"
					:class="action.type === 'danger' ? 'app-swipe-btn-danger' : 'app-swipe-btn-primary'"
					:style="btnStyleR[index]"
					@touchstart="onBtnTouchStart($event, SIDE_R, index)" @click="onActionClick(action, SIDE_R, index)">
				<view class="app-swipe-btn-spinner" :class="spinnerAtR === index ? 'app-swipe-btn-spinner--on' : ''" :style="spinnerStyle">
					<uni-icons class="app-swipe-btn-spinner-icon" type="spinner-cycle" />
				</view>
				<text ref="textElsR" class="app-swipe-btn-text" :style="textStyleR[index]">{{ confirmSide === SIDE_R && confirmIndex === index ? confirmLabel : action.text }}</text>
			</view>
			<!-- #endif -->
			<!-- #ifdef MP-WEIXIN -->
			<view v-for="(action, index) in leftList" :key="action.event" class="app-swipe-btn app-swipe-btn--left"
					:class="action.type === 'danger' ? 'app-swipe-btn-danger' : 'app-swipe-btn-primary'"
					:style="btnStyleL[index]"
					@touchstart="onBtnTouchStart($event, SIDE_L, index)" @click="onActionClick(action, SIDE_L, index)">
				<view class="app-swipe-btn-spinner" :class="spinnerAtL === index ? 'app-swipe-btn-spinner--on' : ''" :style="spinnerStyle">
					<uni-icons class="app-swipe-btn-spinner-icon" type="spinner-cycle" />
				</view>
				<text class="app-swipe-btn-text" :style="textStyleL[index]">{{ confirmSide === SIDE_L && confirmIndex === index ? confirmLabel : action.text }}</text>
			</view>
			<!-- 右组（恒宽叠塔）：锚行右缘藏行右外 -->
			<view v-for="(action, index) in rightList" :key="action.event" class="app-swipe-btn"
					:class="action.type === 'danger' ? 'app-swipe-btn-danger' : 'app-swipe-btn-primary'"
					:style="btnStyleR[index]"
					@touchstart="onBtnTouchStart($event, SIDE_R, index)" @click="onActionClick(action, SIDE_R, index)">
				<view class="app-swipe-btn-spinner" :class="spinnerAtR === index ? 'app-swipe-btn-spinner--on' : ''" :style="spinnerStyle">
					<uni-icons class="app-swipe-btn-spinner-icon" type="spinner-cycle" />
				</view>
				<text class="app-swipe-btn-text" :style="textStyleR[index]">{{ confirmSide === SIDE_R && confirmIndex === index ? confirmLabel : action.text }}</text>
			</view>
			<!-- #endif -->
		</view>
		<!-- 内容层：透明（遮盖式退役——按钮空间与内容互补，不依赖层叠）；流内撑行高 -->
		<!-- #ifndef MP-WEIXIN -->
		<view ref="contentEl" class="app-swipe-content" :style="contentStyle">
			<slot />
		</view>
		<!-- #endif -->
		<!-- #ifdef MP-WEIXIN -->
		<view class="app-swipe-content" :style="contentStyle">
			<slot />
		</view>
		<!-- #endif -->
	</view>
</template>

<script setup lang="ts">
	// 侧滑操作·单核（平台分叉第 3 级）：状态机/样式单份，模板仅按钮组与内容层按平台各出一份
	// （只差元素 ref）；写层、量测、style 载体初值与触摸兜底经 platform/ 适配器分叉
	// （app/鸿蒙/H5=元素 setProperty 直驱，MP=响应式 style 载体）——契约见 swipe-platform.ts
	// 侧滑操作（双侧，恒宽叠塔模型）：actions 单集合按 side 分左右组——彩带宽恒=自身+
	// 靠内容侧全部（右组锚右缘藏右外/左组锚左缘反转渲染序完全镜像），动画只做进入位移
	// d=W_i'×(1-p) 线性跟手；弹簧段可见段平分阻尼行程（width 拉伸）、松手 JS 同帧补间复原；
	// 确认态=彩带自延长盖场（装不下时 item 顺势顶开）；确认执行=现场冻结，去向：删除=remove()
	// 带现场收场；单条操作=完成（loading 撤离/同步未置）自动收起；取消（触摸确认条外）=
	// 保持确认形态整体滑出关行（微信式，不回按钮态）。
	// 直点钮同权：loading 冻结展开档+钮上 spinner，撤离同收；未置 loading 乐观即收。
	// currentX 双向语义：负=右组/正=左组/0=收起；手势 touch+方向判定让位纵滚，位移经适配器写；
	// 动画全面 JS 补间/弹簧驱动（CSS 过渡退役=崩溃病理根除，并发闸与单拖拽限制已随之拆除）

	// #ifdef MP-WEIXIN
	import { createPlatform } from './platform/mp'
	// #endif
	// #ifndef MP-WEIXIN
	import { createPlatform } from './platform/app'
	// #endif
	import { closeOthers, markOpen, clearOpen } from './mutex'
	import { createSpringControl } from '@/utils/spring'
	import { SIDE_L, SIDE_R, estimateWidth } from './swipe-platform'

	type SwipeAction = {
		// 按钮文案
		text : string
		// 事件标识（@action 回传）
		event : string
		// danger=红底（危险操作），默认蓝底
		type ?: string
		// 自定义按钮背景色（优先于 type 配色）
		color ?: string
		// 点击后进确认态（按钮排滑出、确认条滑入），确认后动画播完触发 @action
		confirm ?: boolean
		// 确认条文案
		confirmText ?: string
		// 所属侧：left=左组（右滑展开）；缺省 right=右组（左滑展开）——单集合按业务自由拼装
		side ?: string
		// 业务透传负载（组件不读，@action 原样回传——放 id/record 等，
		// 循环消费免维护 event→业务 的映射）
		data ?: any
	}

	const props = defineProps<{
		// 侧滑按钮组（组件自渲染，宽度自适应文案）
		actions : SwipeAction[]
		// 禁用手势（按钮不可滑出）
		disabled ?: boolean
		// 行底分隔线（默认开；末行或组内单行显式 :divider="false"）
		divider ?: boolean
		// 行级加载态（两级通用）：确认链冻结二次确认现场（彩带不收回）、直点钮冻结
		// 展开档；被点钮文字前 spinner；期间全操作拒绝；撤离自动收起（删除走 remove()）
		loading ?: boolean
	}>()

	const emit = defineEmits<{
		// 按钮最终确认（唯一业务回调）：非 confirm 型点击即回传；confirm 型在行消失动画
		// 播完后回传（业务此时清数据动画不被截断）——回传整个按钮 item（event+data 均可读）
		(e : 'action', action : SwipeAction) : void
		// 展开完成（side='left'|'right'，含程序化 open）
		(e : 'open', side : string) : void
		// 收起完成（含互斥/程序化 close）
		(e : 'close') : void
	}>()

	const sideListOf = (s : string) => props.actions.filter((a : SwipeAction) => (a.side ?? 'right') === s)
	// 左组渲染序反转（完全镜像）：反转后数组序=贴行界→贴内容，与右组 DOM 层序语义一致——
	// 末位（标星）fan=自身在最上层盖行界端，首位（已读）fan=全组铺底——fan 公式两测统一
	const leftList = computed<SwipeAction[]>(() => sideListOf('left').slice().reverse())
	const rightList = computed<SwipeAction[]>(() => sideListOf('right'))

	// 元素引用（app/鸿蒙/H5 写层与量测用；MP 端为无 .style 的垫片，不读）
	const contentEl = ref<any>(null)
	const btnElsL = ref<any[]>([])
	const textElsL = ref<any[]>([])
	const btnElsR = ref<any[]>([])
	const textElsR = ref<any[]>([])
	// 响应式 style 载体（模板 :style 绑定）：MP 的写通道；app 只取首帧初值，运行期不写
	const btnStyleL = ref<any[]>([])
	const btnStyleR = ref<any[]>([])
	const textStyleL = ref<any[]>([])
	const textStyleR = ref<any[]>([])
	const contentStyle = ref<any>({})

	const platform = createPlatform({ contentEl, btnElsL, btnElsR, textElsL, textElsR, btnStyleL, btnStyleR, textStyleL, textStyleR, contentStyle })
	// 载体构建（声明期即建——首帧按钮带藏外 transform 无闪现）；actions 变化时重建
	const syncCarriers = () => {
		btnStyleL.value = leftList.value.map((a : SwipeAction) : any => platform.initBtnStyle(a.color ?? '', -1))
		btnStyleR.value = rightList.value.map((a : SwipeAction) : any => platform.initBtnStyle(a.color ?? '', 1))
		textStyleL.value = leftList.value.map((_a : SwipeAction) : any => platform.initTextStyle())
		textStyleR.value = rightList.value.map((_a : SwipeAction) : any => platform.initTextStyle())
		contentStyle.value = platform.initContentStyle()
	}
	syncCarriers()

	const confirmLabel = ref<string>('')
	const confirmIndex = ref<number>(-1)
	const confirmSide = ref<number>(SIDE_R)

	// loading spinner（常驻零销毁，显隐烘焙类）：贴被点钮文字左侧——absolute 不入流
	// （文字位只归 confirmM 管），left 随归心补间逐帧钉住；确认链/直点钮两级通用
	const SPIN_PAD = 22
	const directBusy = ref<boolean>(false)
	const directSide = ref<number>(SIDE_R)
	const directIndex = ref<number>(-1)
	// spinner 落点=被冻结的钮（确认链优先；与直点冻结互斥不并存）
	const spinnerTarget = (sideId : number) : number => {
		if (props.loading !== true) {
			return -1
		}
		if (confirming.value && confirmSide.value === sideId) {
			return confirmIndex.value
		}
		if (directBusy.value && directSide.value === sideId) {
			return directIndex.value
		}
		return -1
	}
	const spinnerAtL = computed<number>(() => spinnerTarget(SIDE_L))
	const spinnerAtR = computed<number>(() => spinnerTarget(SIDE_R))
	const spinnerLeft = ref<number>(0)
	const spinnerStyle = computed<any>(() => {
		return {
			left: `${spinnerLeft.value}px`
		}
	})

	// 几何（量测，打包）：Wi=各按钮自身宽、Wi'=叠塔宽（自身+右侧全部）、W=组宽、Rg=行宽；
	// margins=各彩带文字常规态左边距（确认态改写居中延长彩带，退出时复原）
	type SideGeom = { widths : number[], fan : number[], margins : number[], total : number }

	// 侧实体（SideController 雏形）：封装一侧的几何+驱动方法——共用的封装逻辑收敛于此，
	// 主状态机按逻辑调用对应方法；A2 单实例，B 阶段起按侧双实例
	const makeSide = (fixedSign : number) => {
		const g : SideGeom = { widths: [], fan: [], margins: [], total: 0 }
		// 该侧进过弹簧段才需在回程复位宽度（常态零 width setProperty）
		let springDirty = false
		// 侧标识（适配器寻址）
		const side = fixedSign < 0 ? SIDE_L : SIDE_R

		// 写层：经平台适配器（app/鸿蒙/H5=元素 setProperty，MP=style 载体）
		const wBtn = (i : number, prop : string, val : string) => {
			platform.btn(side, i, prop, val)
		}
		const wText = (i : number, prop : string, val : string) => {
			platform.text(side, i, prop, val)
		}

		// 彩带驱动：p∈[0,1] 线性跟手（缓动会中途越界盖 item）；p>1 弹簧平分阻尼
		const driveAt = (p : number) => {
			const n = g.fan.length
			for (let i = 0; i < n; i++) {
				let d = 0
				if (p > 1) {
					const over = (p - 1) * g.total
					const add = over * (n - i) / n
					wBtn(i, 'width', `${g.fan[i] + add}px`)
					if (fixedSign < 0) {
						// 左组橡皮筋：右缘延展（锚 left:0），文字随右缘同步右移——
						// 右组锚 right:0 左缘延展、ml 从左缘起算天然跟移，左组须显式补
						wText(i, 'margin-left', `${(g.margins[i] ?? 0) + add}px`)
					}
					springDirty = true
				} else {
					d = g.fan[i] * (1 - p)
					if (springDirty) {
						wBtn(i, 'width', `${g.fan[i]}px`)
						if (fixedSign < 0) {
							wText(i, 'margin-left', `${g.margins[i] ?? 0}px`)
						}
					}
				}
				wBtn(i, 'transform', `translateX(${fixedSign * d}px)`)
			}
			if (p <= 1) {
				springDirty = false
			}
		}

		// 宽度/文字位瞬回静态常量（确认残留清算/互斥收起共用）
		const resetStatic = () => {
			for (let i = 0; i < g.fan.length; i++) {
				wBtn(i, 'width', `${g.fan[i]}px`)
				wText(i, 'margin-left', `${g.margins[i] ?? 0}px`)
			}
		}

		// 量测+静态锁定（text 实宽+内距=按钮宽→fan→margins→初始全藏）
		// 可重入（actions 动态变化时重量测）；labels=各钮文案（量测经适配器：app 真量测，MP 估算）
		const measure = (labels : string[]) => {
			g.widths.splice(0, g.widths.length)
			g.fan.splice(0, g.fan.length)
			g.margins.splice(0, g.margins.length)
			g.total = 0
			const widths : number[] = []
			let acc = 0
			for (let i = 0; i < labels.length; i++) {
				const w = platform.textWidth(side, i, labels[i] ?? '') + 32
				widths.push(w)
				acc += w
			}
			g.total = acc
			// 叠塔宽=自身+靠内容侧全部：fan[i]=wi+Σ(j>i)（右组数组序大=贴行界；
			// 左组已反转渲染序，同公式成立）
			for (let i = 0; i < widths.length; i++) {
				g.widths.push(widths[i])
				let sum = widths[i]
				for (let j = i + 1; j < widths.length; j++) {
					sum += widths[j]
				}
				g.fan.push(sum)
			}
			for (let i = 0; i < widths.length; i++) {
				wBtn(i, 'width', `${g.fan[i]}px`)
				const tw = platform.textWidth(side, i, labels[i] ?? '')
				// 文字钉位=自身可见段中心：右组可见段在彩带左缘起（ml=(wi-tw)/2）；
				// 左组（反转序）可见段起点=上层总宽 Σ(j>i)w_j（上层盖左端）——镜像偏移
				let ml : number
				if (fixedSign > 0) {
					ml = Math.max(0, (widths[i] - tw) / 2)
				} else {
					let above = 0
					for (let j = i + 1; j < widths.length; j++) {
						above += widths[j]
					}
					ml = above + Math.max(0, (widths[i] - tw) / 2)
				}
				g.margins.push(ml)
				wText(i, 'margin-left', `${ml}px`)
			}
		}

		const isSpringDirty = () : boolean => springDirty
		const clearSpringDirty = () => { springDirty = false }

		return { g, fixedSign, driveAt, resetStatic, measure, isSpringDirty, clearSpringDirty, wBtn, wText }
	}
	// 双实例：左实体 fixedSign=-1（藏左外）/右实体 +1（藏右外）
	const sides = [makeSide(-1), makeSide(1)]
	// 状态：当前内容位移档（0 收起 / -W 展开）、确认/消失
	let currentX = 0
	const confirming = ref<boolean>(false)
	let confirmAction : SwipeAction | null = null
	const removing = ref<boolean>(false)
	// 手势
	let dragTouchId = -1
	// 拖拽被互斥打断（多指：本行拖拽中他行按下，closeSelf 归零本行）——后续 move/end
	// 全忽略直到抬手，否则手指未抬 move 又把行拖回来=没收
	let dragCancelled = false
	// S3 节流：上次驱动时间戳（16ms≈一帧，同帧多次 move 只驱动末次——降命令式写密度）
	let lastDriveT = 0
	let startX = 0
	let startY = 0
	let baseX = 0
	let horizontal : boolean | null = null
	// 末速度追踪（EMA 平滑——segmented 同款；松手前停顿>80ms 视为有意停住速度作废）
	let velMs = 0
	let trackX = 0
	let trackT = 0

	const clamp = (v : number, min : number, max : number) : number => v < min ? min : (v > max ? max : v)

	// 有限值守卫：NaN/Infinity 传进 setProperty 会让原生 CALayer position 变 NaN 直接崩溃
	const safe = (v : number, fallback : number) : number => (isFinite(v) ? v : fallback)

	const findTouch = (e : TouchEvent, id : number) : Touch | null => {
		for (let i = 0; i < e.changedTouches.length; i++) {
			if (e.changedTouches[i].identifier === id) {
				return e.changedTouches[i]
			}
		}
		for (let i = 0; i < e.touches.length; i++) {
			if (e.touches[i].identifier === id) {
				return e.touches[i]
			}
		}
		return null
	}

	// ---------- 位移驱动（单变量 p=展开进度，0=收起 1=展开 >1=橡皮筋段） ----------
	// 内容层位移统一口：x 直用（负=左移让右侧 / 正=右移让左侧，双向自然语义）
	const driveContent = (x : number) => {
		platform.content('transform', `translateX(${x}px)`)
	}

	// 橡皮筋（分式衰减，iOS rubber-band 同族）：视觉超出 = d×(1 - 1/(k0·x/d + 1))
	// —— 起点即有硬度 k0（到头瞬间手指:视觉≈0.4:1），斜率随位移平方递减=逐渐变硬到近乎拖不动，
	// 渐近线 d 永无硬墙
	// 橡皮筋（分式衰减）：d=该侧组宽的 0.25（下限 32）——由调用方传侧组宽
	const rubberOf = (total : number, excess : number) : number => {
		const d = total > 0 ? Math.max(32, total * 0.25) : 32
		const k0 = 0.4
		return d * (1 - 1 / (excess * k0 / d + 1))
	}

	// 补间引擎（公共函数）：300ms easeOutQuad setTimeout 链统一封装——代际 token（cancel 后
	// 已入队帧不执行）、cancel/run 收敛一处；spring/confirm 两个控制实例各持独立代际
	const createTweenControl = () => {
		let timer : number | null = null
		let gen = 0
		const cancel = () => {
			gen++
			if (timer != null) {
				clearTimeout(timer)
				timer = null
			}
		}
		// step 收缓动比例 e∈[0,1]；done=终帧回调（被 cancel 则不触发）；
		// duration/easeIn 可选（默认 300ms easeOut——惯性冲出段用短时长+easeIn 造动量感）
		const run = (step : (e : number) => void, done ?: () => void, duration ?: number, easeIn ?: boolean) => {
			cancel()
			const t0 = Date.now()
			const D = duration ?? 300
			const myGen = gen
			const tick = () => {
				if (myGen !== gen) {
					return
				}
				const k = clamp((Date.now() - t0) / D, 0, 1)
				const e = easeIn === true ? k * k : 1 - (1 - k) * (1 - k)
				step(e)
				if (k < 1) {
					timer = setTimeout(tick, 16)
				} else {
					timer = null
					done?.()
				}
			}
			tick()
		}
		return { cancel, run }
	}
	const springCtl = createTweenControl()
	const confirmCtl = createTweenControl()
	// 确认链弹簧（进度域 0→1）：k=冲刺速度（350≈176ms 到位）；c 每次按行程归一（弹幅 6px，见 confirmTweenDrive）
	const CONFIRM_K = 350
	const confirmSpring = createSpringControl(CONFIRM_K, 28, 0.008, 0.3)
	// 确认动画停表统一口（进/取消确认走弹簧、loading 归心走补间——两源齐停）
	const cancelConfirmAnim = () => {
		confirmSpring.cancel()
		confirmCtl.cancel()
	}

	// 确认补间状态（跟踪变量=当前值，打断后新补间从实际位起跳）
	let confirmW = 0
	let confirmM = 0
	// 进确认时的 item 顶开量（>0=确认时 item 被顶开过；loading 归心计算也用）
	let confirmExtra = 0
	// 确认形态滑出收起后的宽度残留侧（-1=无）：延展宽驻留按钮上，下次交互前复位（行已关、按钮在界外=不可见）
	let confirmResidueSide = -1

	const cancelConfirmTween = () => {
		cancelConfirmAnim()
		// 打断清算：双侧静态复位瞬设（防中间值残留复活开态=互斥失效）；confirmW 由起点兜底重取
		sides[SIDE_L].resetStatic()
		sides[SIDE_R].resetStatic()
		confirmW = -1
	}

	// toX 传 null = 不驱动 content（item 渲染态冻结——extra=0 时：按钮还在 item 就绝不动）
	// slideOut=进确认 j>idx 滑出插值（0→fan[j] 藏外）——JS 补间驱动（CSS 过渡已全面退役：
	// 摘 transition 对在途动画两端语义不同，App=在途免疫、MP/WebView=立即终止瞬跳）
	const confirmTweenDrive = (s : ReturnType<typeof makeSide>, index : number, toW : number, toX : number | null, toM : number, onDone ?: () => void, slideOut ?: boolean) => {
		// 只清旧动画不清算（纯停表）——起步前的清旧 ≠ 打断清算（见 cancelConfirmTween 注释）
		cancelConfirmAnim()
		const fromW = confirmW >= 0 ? confirmW : s.g.fan[index]
		const fromX = currentX
		const fromM = confirmM
		const n = s.g.fan.length
		const settled = Math.abs(toW - fromW) < 0.5 && Math.abs(toM - fromM) < 0.5
			&& (toX == null || Math.abs(toX - fromX) < 0.5)
		if (settled) {
			onDone?.()
			return
		}
			// 过冲幅度归一（每钮阻尼比）：目标 6px÷行程=过冲比例（封顶 12% 防小行程多周期晃），
			// 闭式换 ζ（k 不动=冲刺速度不变）——各钮回弹像素一致，全程单弹簧无映射接缝
			const range = Math.abs(toW - fromW)
			const ratio = Math.min(0.12, 6 / Math.max(range, 1))
			const lzi = Math.log(1 / ratio)
			const cRun = 2 * Math.sqrt(CONFIRM_K) * lzi / Math.sqrt(Math.PI * Math.PI + lzi * lzi)
			confirmSpring.run(0, 1, 0, (e : number) => {
				confirmW = safe(fromW + (toW - fromW) * e, toW)
				confirmM = safe(fromM + (toM - fromM) * e, toM)
				s.wBtn(index, 'width', `${confirmW}px`)
				if (toX != null) {
					currentX = safe(fromX + (toX - fromX) * e, toX)
					driveContent(currentX)
				}
				s.wText(index, 'margin-left', `${confirmM}px`)
				if (slideOut === true) {
					for (let j = index + 1; j < n; j++) {
						const d = safe(s.g.fan[j] * e, s.g.fan[j])
						s.wBtn(j, 'transform', `translateX(${s.fixedSign * d}px)`)
					}
				}
			}, onDone, cRun)
	}

	// 进确认：从按钮态延长到对接 item（extra=装不下时 item 顶开量）；
	// 入口把 currentX 归一 -W（任何路径的污染清零，extra=0 时 item 全程不动）
	const confirmExtend = (s : ReturnType<typeof makeSide>, index : number, tw : number, extra : number) => {
		// 掐行运动补间（开行 glide 可能在途——确认弹簧与它是两个控制实例，不互斥须显式停）
		cancelSpringTween()
		s.clearSpringDirty()
		confirmW = s.g.fan[index]
		confirmM = s.g.margins[index] ?? 0
		const toW = s.g.total + extra
		const openX = -s.fixedSign * s.g.total
		if (currentX !== openX) {
			currentX = openX
			driveContent(currentX)
		}
		confirmExtra = extra
		confirmTweenDrive(s, index, toW, extra > 0 ? -s.fixedSign * toW : null, Math.max(0, (toW - tw) / 2), null, true)
	}

	// 弹簧回位补间（引擎驱动）：内容+彩带 width 同帧，终态移交 openAt 就位
	const cancelSpringTween = () => { springCtl.cancel() }

	const springReturn = () => {
		cancelSpringTween()
		markOpen(closeSelf)
		// 发生侧=超界侧（currentX 符号）；起点=视觉 over（rubber 饱和后）
		const s = currentX < 0 ? sides[SIDE_R] : sides[SIDE_L]
		const g = s.g
		const raw = Math.abs(currentX) - g.total
		const startOver = raw > 0 ? rubberOf(g.total, raw) : 0
		if (startOver <= 0) {
			openAt(s)
			return
		}
		const n = g.fan.length
		const leftSide = s.fixedSign < 0
		springCtl.run((e : number) => {
			const over = safe(startOver * (1 - e), 0)
			for (let i = 0; i < n; i++) {
				const add = over * (n - i) / n
				s.wBtn(i, 'width', `${safe(g.fan[i] + add, g.fan[i])}px`)
				if (leftSide) {
					// 左组：文字随右缘延展同步平移（driveAt 弹簧分支同款——右组锚右缘天然跟移免补）
					s.wText(i, 'margin-left', `${safe((g.margins[i] ?? 0) + add, g.margins[i] ?? 0)}px`)
				}
			}
			currentX = safe(-s.fixedSign * (g.total + over), -s.fixedSign * g.total)
			driveContent(currentX)
		}, () => {
			s.clearSpringDirty()
			openAt(s)
		})
	}

	// 总驱动（currentX 双向语义：负=右组展开 / 正=左组展开 / 0=收起）：
	// content 直 x（负左移让右侧/正右移让左侧）；两侧进度各自换算（橡皮筋等效 p 交对应侧）
	// 双向符号过滤：x<0 只驱动右组（-x/W_r）、x>0 只驱动左组（x/W_l）——两组互斥随 currentX 符号
	const drive = (x : number) => {
		// content 位移=橡皮筋饱和后的有效值（原始 x 可到 ±6W——不限会把 item 拖飞）
		let effX = x
		const wr = sides[SIDE_R].g.total
		const wl = sides[SIDE_L].g.total
		if (x < 0 && wr > 0 && -x > wr) {
			effX = -(wr + rubberOf(wr, -x - wr))
		} else if (x > 0 && wl > 0 && x > wl) {
			effX = wl + rubberOf(wl, x - wl)
		}
		driveContent(effX)
		// p 不设上限（仅下限 0=对侧全藏）：effX 已被 rubberOf 渐近约束天然有界，
		// 按钮延展与 content 超出走同一曲线——曾用 1.3 封顶，单钮行 d 走 32 下限时
		// 渐近超出 32px > 封顶 0.3×total，两者脱节=露空隙+回弹起点跳变
		if (wr > 0) {
			const pr = Math.max(0, -effX / wr)
			sides[SIDE_R].driveAt(pr)
		}
		if (wl > 0) {
			const pl = Math.max(0, effX / wl)
			sides[SIDE_L].driveAt(pl)
		}
	}

	// 行运动补间（开/收共用，springCtl 承载）：从当前 currentX 到目标 300ms easeOut——
	// 动画全面 JS 化后 CSS 过渡退役（在途 CSS 动画×命令式写=CDOMThread 崩溃病理），
	// 所有写入同线程全序，闸与单拖拽限制随之拆除
	const glideTo = (target : number) => {
		const fromX = currentX
		if (Math.abs(target - fromX) < 0.5) {
			currentX = target
			drive(target)
			return
		}
		springCtl.run((e : number) => {
			currentX = fromX + (target - fromX) * e
			driveContent(currentX)
			// 进度钳 1（绕开 drive 的橡皮筋段：过界态起收会触发宽度拉伸写；两侧分调同款换算）
			sides[SIDE_R].driveAt(clamp(-currentX / Math.max(1, sides[SIDE_R].g.total), 0, 1))
			sides[SIDE_L].driveAt(clamp(currentX / Math.max(1, sides[SIDE_L].g.total), 0, 1))
		}, () => {
			currentX = target
			drive(target)
		})
	}

	// ---------- 手势 ----------
	// 彩带 touchstart：确认态下延长彩带（被点者）拦冒泡（x 端修饰符不可靠，官方姿势=回调内
	// 手动 stopPropagation）——点它=确认执行，不能被根级「触摸即退出确认」吞掉；
	// MP 上 stopPropagation 不可靠时另置命中标记让根级让行（适配器兜底，app 空实现）
	const onBtnTouchStart = (e : TouchEvent, sideId : number, index : number) => {
		if (confirming.value && confirmSide.value === sideId && confirmIndex.value === index) {
			e.stopPropagation()
			platform.markConfirmBarHit()
		}
	}

	const onTouchStart = (e : TouchEvent) => {
		dragCancelled = false
		lastDriveT = 0
		// 点中确认条的那次触摸不归根级（MP 兜底标记，见 onBtnTouchStart）
		if (platform.takeConfirmBarHit()) {
			return
		}
		if (removing.value || props.disabled === true || props.loading === true) {
			return
		}
		cancelSpringTween()
		cancelInertia()
		if (confirming.value) {
			// 确认态触摸=直接关闭（微信式）：与互斥收起同款全收——彩带静态复位+行收起一段完成
			closeOthers(closeSelf)
			closeSelf()
			return
		}
		// 非确认态=打断场景（如退出补间进行中再触摸转拖动）→ 全量清算防中间值残留
		cancelConfirmTween()
		closeOthers(closeSelf)
		const t = e.changedTouches.length > 0 ? e.changedTouches[0] : e.touches[0]
		if (t == null) {
			return
		}
		dragTouchId = t.identifier
		startX = t.screenX
		startY = t.screenY
		baseX = currentX
		horizontal = null
	}

	const onTouchMove = (e : TouchEvent) => {
		if (dragTouchId < 0 || dragCancelled) {
			return
		}
		const p = findTouch(e, dragTouchId)
		if (p == null) {
			return
		}
		const dx = p.screenX - startX
		const dy = p.screenY - startY
		if (horizontal == null) {
			// 方向判定：位移过 5px 才定（与轻扫展开阈值匹配），纵向意图让位滚动
			if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
				horizontal = Math.abs(dx) > Math.abs(dy)
				if (horizontal) {
					// 横滑接管：锁默认行为
					e.preventDefault()
					// 清确认文案驻留（滑出收起后文字保持确认态，按钮复见前还原）
					confirmIndex.value = -1
					// 认领互斥（markOpen 会收起持有者，含拖拽中的行→其 dragCancelled 冻结让位）
					markOpen(closeSelf)
				}
			}
			return
		}
		if (horizontal !== true) {
			return
		}
		e.preventDefault()
		// S3 节流：一帧内只驱动一次（方向判定不节流，claim/markOpen 时序不受影响）
		const throttleNow = Date.now()
		if (throttleNow - lastDriveT < 16) {
			return
		}
		lastDriveT = throttleNow
		// 双向界：两域各放宽 6 倍（橡皮筋自收敛，手指无硬墙）
		currentX = clamp(baseX + dx, -sides[SIDE_R].g.total * 6, sides[SIDE_L].g.total * 6)
		drive(currentX)
		const now = Date.now()
		const mdt = now - trackT
		if (mdt > 0) {
			velMs = velMs * 0.7 + ((currentX - trackX) / mdt) * 0.3
		}
		trackX = currentX
		trackT = now
	}

	const onTouchEnd = () => {
		platform.clearConfirmBarHit()
		if (dragTouchId < 0) {
			return
		}
		dragTouchId = -1
		// 被互斥打断的轮次：静默终结（不复位 horizontal 之外的任何手势态）
		if (dragCancelled) {
			dragCancelled = false
			horizontal = null
			return
		}
		if (horizontal !== true) {
			horizontal = null
			// 非横滑收尾（MP 纵滚抢走手势/纯点按）：touchstart 可能掐了在途补间、行停半途
			// ——按阈值归位，否则冻结在中间态（回退 CSS 时代的语义缺口，全 JS 化后位置真停中）
			if (-currentX > sides[SIDE_R].g.total / 2) {
				openAt(sides[SIDE_R])
			} else if (currentX > sides[SIDE_L].g.total / 2) {
				openAt(sides[SIDE_L])
			} else if (Math.abs(currentX) > 0.5) {
				closeSelf()
			}
			return
		}
		horizontal = null
		// 起拖域门禁（弹簧支路/阈值支路共用）：开态域起拖=只可回开本侧或收起，不接盘对侧
		// （total>0 守卫：单侧行对侧半宽 0 会把 fromL/R 恒真废掉本侧开启）
		const fromL = sides[SIDE_L].g.total > 0 && baseX >= sides[SIDE_L].g.total / 2
		const fromR = sides[SIDE_R].g.total > 0 && baseX <= -sides[SIDE_R].g.total / 2
		if (sides[SIDE_L].isSpringDirty() || sides[SIDE_R].isSpringDirty()) {
			// 弹簧回位=四元素一体补间（width 不可 CSS 过渡，与 transform 过渡必然不同步——
			// item 慢半拍根因；JS 同帧驱动全部元素=绝对同步整体复原）
			// 跨域橡皮筋例外（开态起拖过心压进对侧橡皮筋区）：springReturn 终态=openAt(对侧)
			// =串面主径，改走收起档物理回弹（与快扫关闭同款弹簧归 0，永不落开态）
			if ((currentX < 0 && fromL) || (currentX > 0 && fromR)) {
				closeWithInertia(baseX < 0 ? sides[SIDE_R] : sides[SIDE_L], (Date.now() - trackT < 80) ? velMs : 0)
				return
			}
			springReturn()
			return
		}
		// 分侧分向阈值：收起域起拖 5px 轻扫即开（灵敏）；开态域起拖回拖过半保持本侧开
		if (!fromL && -currentX > (fromR ? sides[SIDE_R].g.total / 2 : 5)) {
			openAt(sides[SIDE_R])
		} else if (!fromR && currentX > (fromL ? sides[SIDE_L].g.total / 2 : 5)) {
			openAt(sides[SIDE_L])
		} else {
			// 收起档：EMA 末速（停顿>80ms 作废=有意停住）；选侧=起拖域（baseX——松手 currentX
			// 已被 clamp 到界=0，按它选会选错侧致惯性量恒 0）
			const velocity = (Date.now() - trackT < 80) ? velMs : 0
			const closeSide = baseX < 0 ? sides[SIDE_R] : sides[SIDE_L]
			if (Math.abs(velocity) > 0.3) {
				closeWithInertia(closeSide, velocity)
			} else {
				closeSelf()
			}
		}
	}

	// ---------- 档位 ----------
	// 惯性收起（甩动关闭）：物理弹簧驱动（segmented 同款欠阻尼积分 k170/c18——初速承接
	// 松手末速度，冲出量与回弹振荡全由物理决定，无手动系数/上限/CSS 时长）
	const inertiaSpring = createSpringControl()
	const cancelInertia = () => { inertiaSpring.cancel() }

	const closeWithInertia = (s : ReturnType<typeof makeSide>, velocity : number) => {
		cancelInertia()
		cancelSpringTween()
		if (Math.abs(velocity) < 0.3) {
			closeSelf()
			return
		}
		markOpen(closeSelf)
		// 全元素同弹簧：onUpdate 完整 drive(x)（content+两侧彩带进度）——彩带与 item 共享
		// 同一条物理曲线（收回+过冲全同步=连贯）；过 0 冲出时对侧彩带随物理微露（真实抽屉感，
		// drive 符号过滤天然实现）——纯单侧行对侧 total=0 不受影响
		inertiaSpring.run(currentX, 0, velocity * 1000, (x : number) => {
			currentX = x
			drive(x)
		}, () => {
			currentX = 0
			clearOpen(closeSelf)
			emit('close')
		})
	}

	// 展开到指定实体侧（fixedSign 定 currentX 符号），另一侧彩带 p=0 自然收着
	const openAt = (s : ReturnType<typeof makeSide>) => {
		if (props.loading === true) {
			return
		}
		// 确认形态滑出后的残留清算（此时行必为关态，界外复位不可见；含确认文案驻留）
		if (confirmResidueSide >= 0) {
			sides[confirmResidueSide].resetStatic()
			confirmResidueSide = -1
			confirmIndex.value = -1
		}
		glideTo(-s.fixedSign * s.g.total)
		markOpen(closeSelf)
		emit('open', s === sides[SIDE_L] ? 'left' : 'right')
	}

	const closeSelf = () => {
		if (props.loading === true) {
			return
		}
		// 拖拽中被外部（互斥）收起=打断本轮流（见 dragCancelled 声明处注释）
		if (dragTouchId >= 0) {
			dragCancelled = true
		}
		cancelSpringTween()
		cancelInertia()
		if (confirming.value) {
			// 确认态收起=保持确认形态整体滑出（不走 cancelConfirmTween——resetStatic 会先
			// 还原为按钮堆再收=两段观感）：被点彩带按延展宽 toW 出界（drive(0) 按 fan 写它
			// =藏不完露条），内容归位与其同段补间；延展宽残留挂标记，下次交互前复位
			const idx = confirmIndex.value
			const cs = sides[confirmSide.value]
			const toW = cs.g.total + confirmExtra
			cancelConfirmAnim()
			confirming.value = false
			// confirmIndex 不清：滑出期间文字保持确认文案（以二次确认形态收起），
			// 下次按钮可复见前再清（拖拽横滑判定/open 时，界外不可见）
			confirmW = -1
			confirmResidueSide = confirmSide.value
			directBusy.value = false
			directIndex.value = -1
			const fromX = currentX
			springCtl.run((e : number) => {
				currentX = fromX * (1 - e)
				driveContent(currentX)
				// 逐钮直写出界位，勿走 drive——起点 |x|>total（extra 顶开段）会触发橡皮筋
				// 宽度写=毁确认形态，且 effX 橡皮封顶让内容瞬跳；j>idx 本就在界外保持
				for (let j = 0; j < cs.g.fan.length; j++) {
					const dj = j > idx ? cs.g.fan[j] : cs.g.fan[j] * e
					cs.wBtn(j, 'transform', `translateX(${cs.fixedSign * dj}px)`)
				}
				cs.wBtn(idx, 'transform', `translateX(${cs.fixedSign * toW * e}px)`)
			})
			clearOpen(closeSelf)
			emit('close')
			return
		}
		cancelConfirmTween()
		directBusy.value = false
		directIndex.value = -1
		glideTo(0)
		clearOpen(closeSelf)
		emit('close')
	}

	// ---------- 按钮点击 ----------
	// 确认态下延长彩带盖住全场（唯一可点=它自己）：再点=确认执行
	const onActionClick = (action : SwipeAction, sideId : number, index : number) => {
		if (props.loading === true) {
			return
		}
		if (confirming.value) {
			onConfirmExecute()
			return
		}
		if (action.confirm === true) {
			// 进确认态（彩带自延长）：被点彩带宽延至对接 item（装不下确认文案时 item 顺势左顶
			// 最小距离——nextTick 量文案实宽定 Δ）；左侧彩带不动（被盖住）、右侧滑出视野；
			// 文字切换为确认文案并平移到延长后彩带中心
			confirming.value = true
			confirmIndex.value = index
			confirmSide.value = sideId
			directBusy.value = false
			confirmAction = action
			confirmLabel.value = action.confirmText ?? '确认操作？'
			// 确认文案宽走字符估算（MP 同款）：getBoundingClientRect 量换文后的实宽须等
			// 渲染线程完成重排（强制布局屏障），老安卓上排队几十 ms=确认后彩带迟滞主因
			// 补间同步启动（估算零依赖不须等换文 flush——nextTick 等 flush 老安卓 30ms+、
			// 偶发 GC 秒级都会把彩带启动压后；文字换文晚一拍跟上可接受）
			const s = sides[sideId]
			const tw = estimateWidth(confirmLabel.value)
			const extra = safe(Math.max(0, tw + 24 + SPIN_PAD - s.g.total), 0)
			confirmExtend(s, index, tw, extra)
		} else {
			// 直点：记录钮位——handler 同步置 loading 则冻结展开档（spinner 钮上归心），
			// 未置则 nextTick 乐观即收（一帧差不可察）
			directSide.value = sideId
			directIndex.value = index
			directBusy.value = true
			emit('action', action)
			nextTick(() => {
				if (props.loading !== true) {
					closeSelf()
				}
			})
		}
	}

	// 确认执行：立即回传 @action + 确认现场冻结（纯停表——彩带延长/确认文案保留原值，
	// loading 抵达后 spinner 并入）。单条操作同步完成（handler 未置 loading）时 nextTick
	// 自动收起（pre-watch 先行，异步置 loading 的冻结时序不冲突）
	const onConfirmExecute = () => {
		const act = confirmAction
		confirmAction = null
		cancelSpringTween()
		cancelInertia()
		cancelConfirmAnim()
		if (act != null) {
			emit('action', act)
		}
		nextTick(() => {
			if (props.loading !== true && confirming.value) {
				closeSelf()
			}
		})
	}

	// loading 抵达冻结现场（确认链/直点冻结通用）：spinner+文字整组归心——彩带宽/item
	// 位不动，文字右移半个占位、spinner 贴其左侧同帧滑入（确认链目标为绝对值幂等，
	// 重触发不二次偏移）。loading 撤离仍冻结=操作终了未删行 → 自动收起
	watch(() => props.loading, (on : boolean) => {
		if (removing.value) {
			return
		}
		if (on !== true) {
			if (confirming.value || directBusy.value) {
				closeSelf()
			}
			return
		}
		let s = sides[SIDE_R]
		let idx = -1
		let fromM = 0
		let toM = 0
		if (confirming.value) {
			s = sides[confirmSide.value]
			idx = confirmIndex.value
			const tw = estimateWidth(confirmLabel.value)
			fromM = confirmM
			toM = Math.max(0, (s.g.total + confirmExtra - tw) / 2 + SPIN_PAD / 2)
		} else if (directBusy.value) {
			// 直点冻结：钮内 32px 内距恰纳 spinner 组（富余 10px），文字自钮内居中位归心
			s = sides[directSide.value]
			idx = directIndex.value
			fromM = s.g.margins[idx] ?? 0
			toM = fromM + SPIN_PAD / 2
		} else {
			return
		}
		cancelConfirmAnim()
		confirmCtl.run((e : number) => {
			confirmM = safe(fromM + (toM - fromM) * e, toM)
			s.wText(idx, 'margin-left', `${confirmM}px`)
			spinnerLeft.value = Math.max(0, confirmM - SPIN_PAD)
		})
	})

	// ---------- 量测与生命周期 ----------
	onMounted(() => {
		// 双侧各自量测+静态锁定+初始全藏行外（单侧组 total=0 自然跳过）
		for (let s = 0; s < 2; s++) {
			const labels = (s === SIDE_L ? leftList.value : rightList.value).map((a : SwipeAction) => a.text)
			sides[s].measure(labels)
			sides[s].driveAt(0)
		}
	})

	// actions 动态变化兜底（对标组件库健壮性）：掐断补间→摘过渡+载体重建（重建须先于渲染
	// flush——:style 重放的是初值，随后重量测/重驱动的写入才落在其上）→新按钮渲染完成后
	// 重量测+按当前档位重驱动
	watch(() => props.actions, () => {
		cancelSpringTween()
		cancelConfirmTween()
		syncCarriers()
		nextTick(() => {
			for (let s = 0; s < 2; s++) {
				const labels = (s === SIDE_L ? leftList.value : rightList.value).map((a : SwipeAction) => a.text)
				sides[s].measure(labels)
				sides[s].driveAt(0)
			}
			drive(clamp(currentX, -sides[SIDE_R].g.total, sides[SIDE_L].g.total))
		})
	})

	// 程序化控制（对标组件库 API 面）：open('left'|'right')，缺省 right
	const openBy = (openSide ?: string) => {
		openAt(openSide === 'left' ? sides[SIDE_L] : sides[SIDE_R])
	}
	// 行消失动画原语（控制反转）：业务完成数据侧准备后调此播视觉过渡；resolve 于动画
	// 播完——业务在 then 里 splice/刷新，元素销毁不截断动画
	const remove = () : Promise<void> => {
		return new Promise<void>((resolve) => {
			cancelSpringTween()
			cancelInertia()
			// 纯停表不清算：确认现场（延长彩带+spinner）原样带入收场动画——resetStatic
			// 会让彩带先瞬缩回按钮态再塌行=穿帮帧
			cancelConfirmAnim()
			removing.value = true
			setTimeout(() => {
				resolve()
			}, 300)
		})
	}
	defineExpose({
		open : openBy,
		close : closeSelf,
		remove
	})

	onUnmounted(() => {
		// 卸载掐断补间（死引用防线最后一环——v-for 行销毁、页面返回等全部路径）
		cancelSpringTween()
		cancelInertia()
		cancelConfirmTween()
		clearOpen(closeSelf)
	})
</script>

<style lang="scss">
	/* 按压三等级统一维护点（styles/press.scss，编译期合并） */
	@import '@/styles/press.scss';

	/* 根：消失动画时收口裁切（常态 visible 放行按钮容器上探/分隔线几何）；
	   relative 供线/裁切层/按钮定位 */
	.app-swipe-action {
		position: relative;
		flex-direction: column;
		overflow: visible;
	}

	.app-swipe-action-removing {
		overflow: hidden;
		animation: app-swipe-remove 300ms ease forwards;
	}

	/* 行收起动画（tree 同款 max-height 两档；首档 52=列表行高（行盒 22+留白 15×2），内容更高的消费场景届时按实高适配） */
	@keyframes app-swipe-remove {
		0% {
			max-height: 52px;
			opacity: 1;
		}

		100% {
			max-height: 0;
			opacity: 0;
		}
	}

	/* 裁切层：absolute 上探 1px 的纯按钮容器（top:-1=弹出色块盖上一行底线），裁掉初始
	   藏行外的按钮组；线/内容在其外不受裁切与位移影响 */
	.app-swipe-clip {
		position: absolute;
		top: -1px;
		left: 0;
		right: 0;
		bottom: 0;
		overflow: hidden;
	}

	/* 行底分隔线：色挂同名按压类（亮暗自动）；侧滑拖动期间按压保持（拍板允许），线随
	   按压底色同色隐形自然成立 */
	.app-swipe-line {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 1px;
	}

	/* 色块：右缘锚行右界，宽=叠塔宽（量测后设）；位移/拉伸由 JS 直驱（裁切层已上探
	   1px，按钮 top:0 即行顶-1） */
	.app-swipe-btn {
		position: absolute;
		top: 0;
		bottom: 0;
		right: 0;
		flex-direction: row;
		align-items: center;
		background-color: var(--std-primary);
	}

	.app-swipe-btn-danger {
		background-color: var(--std-danger);
	}

	/* 左向模式：锚行左缘（藏行左外，方向镜像） */
	.app-swipe-btn--left {
		left: 0;
		right: auto;
	}

	/* loading spinner：贴确认文案左侧并排——absolute 摘出流（流内占位会把文字再推一个
	   足迹=双倍位移），盒宽钉 20 防字体步进漂移，left 由归心补间逐帧设定（间距 2），
	   占位并入 extra 计算；0.8s 无限旋转。常驻零销毁：默认 display:none */
	.app-swipe-btn-spinner {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 20px;
		display: none;
		align-items: center;
		justify-content: center;
	}

	.app-swipe-btn-spinner--on {
		display: flex;
	}

	.app-swipe-btn-spinner-icon {
		font-size: 20px;
		color: #ffffff;
		animation: app-swipe-spin 0.8s linear infinite;
	}

	@keyframes app-swipe-spin {
		from {
			transform: rotate(0deg);
		}

		to {
			transform: rotate(360deg);
		}
	}

	.app-swipe-btn-text {
		font-size: 15px;
		color: #ffffff;
		white-space: nowrap;
	}

	/* 内容层：透明（按钮与内容空间互补，无遮盖依赖）；z-index 显式钉在彩带之上
	   （双方都带 transform，层序不可隐式依赖 DOM 序——返回动画重叠期彩带会盖住 item） */
	.app-swipe-content {
		position: relative;
		z-index: 10;
		flex: 1;
		flex-direction: column;
	}
</style>
