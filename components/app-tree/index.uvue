<template>
	<!-- 面板+筛选框+树整体封装：外部只传数据与开关（filterable 控制搜索框显隐） -->
	<view class="app-tree-panel">
		<view v-if="filterable" class="app-tree-search">
			<app-input shape="round" :size="searchSize" :height="searchHeight"
				:placeholder="searchPlaceholder ?? '请输入关键词'" clearable v-model="keyword" />
		</view>
		<scroll-view class="app-tree-scroll" :style="{height: scrollHeight + 'px'}">
			<!-- 节点全量常驻：过滤/收起只切 class，元素不销毁；缩进按层级内联 -->
			<view v-for="state in allStates" :key="state.item.key" :class="state.nodeCls"
				:style="{paddingLeft: (state.level * 20) + 'px'}">
				<view :class="state.hitCls"
					:hover-class="readonly ? 'none' : (themeStore.isDark ? 'app-pressed-row-dark' : 'app-pressed-row')"
					:hover-stay-time="100" @click="onSelect(state.item)">
					<!-- 箭头槽常驻（叶子隐藏占位，标题跨层级对齐）；过滤中命中子树视为展开 -->
					<view class="app-tree-arrow" @click.stop="toggleByItem(state.item)">
						<uni-icons v-if="hasChildren(state.item)" class="app-tree-arrow-icon" :class="state.arrowCls"
							type="right" />
					</view>
					<!-- 关键词高亮=三段常驻 text（空串零宽度，无元素增删） -->
					<text class="app-tree-title"><text class="app-tree-title-seg">{{ state.segBefore }}</text><text
							class="app-tree-title-hit">{{ state.segHit }}</text><text
							class="app-tree-title-seg">{{ state.segAfter }}</text></text>
					<!-- 行尾三态：loadingKey 行转圈（loading 态优先）→ 选中对勾 -->
					<app-loading v-if="loading && state.item.key === loadingKey" class="app-tree-loading" />
					<uni-icons v-else-if="state.item.key === current" class="app-tree-check"
						type="checkmarkempty" />
					<!-- 行底分隔线：色挂按压类（按压时同色隐形）；显隐烘焙 state.showLine -->
					<view v-show="state.showLine" class="app-tree-line app-pressed-row" />
				</view>
			</view>
			<view v-show="visibleCount === 0" class="app-tree-empty"><text class="app-tree-empty-text">无匹配数据</text></view>
		</scroll-view>
	</view>
</template>

<script setup lang="ts">
	// 通用树形组件：面板+可选筛选框+层级缩进+展开收起+单选（行尾对勾）+宽松过滤。
	// 渲染=全量常驻+可见性切换（不销毁元素）；整块点击=选中，箭头点击=展开收起
	// 文件分工：tree-context 共享状态；tree-model 数据拍平与展开选中；tree-filter 关键字与可见集；tree-bake 状态烘焙与容器高度。
	import AppInput from '@/components/app-input/app-input.uvue'
	import AppLoading from '@/components/app-loading/index.uvue'
	import { RESIZE_TRANSITION_NOTIFY } from '@/components/app-resize-transition/resize-transition-context'
	import { useThemeStore } from '@/stores/theme'
	import { createTreeContext } from './tree-context'
	import type { TreeItem, TreeState } from './tree-context'
	import { createTreeBake } from './tree-bake'
	import { createTreeFilter } from './tree-filter'
	import { createTreeModel } from './tree-model'

	const props = defineProps<{
		data: TreeItem[]
		// 默认展开全部节点
		defaultExpandAll?: boolean
		// 当前选中节点 key（v-model:current）
		current?: string
		// 显示内置筛选框（关键词宽松过滤+命中高亮）
		filterable?: boolean
		// 筛选框透传子集（转发给内置 app-input；缺省 default 档）
		searchPlaceholder?: string
		searchSize?: 'small' | 'default' | 'large'
		searchHeight?: number
		// 行内加载态：loadingKey 对应行尾显示转圈
		// 只读：整行点击不触发选中与按压反馈（箭头展开收起保留）
		readonly?: boolean
		loading?: boolean
		loadingKey?: string
		// 滚动区最大高度（px，缺省 210；可由外部按视口计算传入）
		maxHeight?: number
	}>()

	const emit = defineEmits<{
		(e: 'update:current', key: string): void
		(e: 'select', key: string, item: TreeItem): void
	}>()

	// 共享状态与各职责模块：模块之间只经 ctx 互调
	const ctx = createTreeContext(props, emit)
	ctx.model = createTreeModel(ctx)
	ctx.filter = createTreeFilter(ctx)
	// 数据先到，烘焙模块创建时首跑才有行可烘
	watch(() => props.data, (val) => {
		const states : TreeState[] = []
		ctx.model.buildStates(val, 0, states)
		ctx.allStates.value = states
		if (props.defaultExpandAll) {
			ctx.expandedKeys.value = ctx.model.collectParentKeys(val)
		}
	}, { immediate: true })
	ctx.bake = createTreeBake(ctx)

	// 外层包着 app-resize-transition 时，滚动区高度的每次变化都报给它；没有外层时注入值为 null
	const notifyResize = inject(RESIZE_TRANSITION_NOTIFY, null) as ((delta : number, duration : number) => void) | null
	if (notifyResize != null) {
		ctx.notifyResize = notifyResize
	}

	// 模板绑定：只别名模板要用的；普通状态一律经 ctx 读写
	const { allStates, keyword } = ctx
	const { hasChildren, toggleByItem, onSelect } = ctx.model
	const { visibleCount, scrollHeight } = ctx.bake

	// 容器行数跟随可见行数：收起方向在渲染提交后起步、与行的收起动画同时长补间，展开方向立即到位；
	// 行的动画类何时切回稳态类由烘焙模块自行安排（见 tree-bake）
	watch(ctx.bake.visibleCount, (rows) => {
		if (rows < ctx.bake.containerRows.value) {
			nextTick(() => {
				ctx.bake.tweenRows(ctx.bake.visibleCount.value)
			})
		} else {
			ctx.bake.setRowsNow(rows)
		}
	})

	onUnmounted(() => {
		ctx.bake.stopTween()
		ctx.bake.cancelRebake()
	})

	// 按压高亮亮暗感知（选 hover 亮/暗类）
	const themeStore = useThemeStore()
	themeStore.init()

	// filter 供调用方经组件 ref 置入关键词
	defineExpose({ filter : ctx.filter.filter })
</script>

<style lang="scss">
	/* 按压类（styles/press.scss） */
	@import '@/styles/press.scss';

	/* 面板壳：底色/圆角走 token；上下内距 8px（scroll-view 的 css padding 在 x 端不生效） */
	.app-tree-panel {
		flex-direction: column;
		width: 100%;
		padding-top: 8px;
		padding-bottom: 8px;
		background-color: var(--std-emphasis-bg);
		border-radius: var(--std-radius);
		overflow: hidden;
	}

	/* 搜索区内距：上下 8px（下内距与首行按压高亮留出间隙），左右=行内距 */
	.app-tree-search {
		padding: var(--std-gap-sm) var(--std-list-pad-x);
	}

	/* 滚动区高度由 scrollHeight 显式驱动 */

	/* 行基准：高度=行高 token；缩进 20px/级，箭头 16px 旋 90°，选中=行尾对勾 */
	.app-tree-node {
		/* 高度权威源=max-height 单属性：展开=行高，收起=0，由动画过渡 */
		max-height: var(--std-row-height);
		/* max-height 与 opacity 由收展动画以 forwards 驱动：各状态类都显式声明这两个属性，动画类撤掉后才有值还原 */
		opacity: 1;
		position: relative;
		/* 允许按压块上探 1px 渲染 */
		overflow: visible;
		/* max-height 过渡：App 端不生效（走下方 keyframes），仅 Web/微信端用于被打断时的平滑收尾 */
		transition-property: max-height;
		transition-duration: 180ms;
		transition-timing-function: ease;
	}

	/* 收起稳态：静态无 animation（常驻动画切后台恢复时会被重置） */
	.app-tree-node-collapsed {
		max-height: 0px;
		opacity: 0;
		overflow: hidden;
	}

	/* 刚收起行的动画变体：静态值取起始值（行高、不透明），forwards 保持终值到重烘焙切回静态类 */
	.app-tree-node-collapsed-anim {
		max-height: var(--std-row-height);
		opacity: 1;
		overflow: hidden;
		/* 内容贴底：行高变化时内容随底边滑动 */
		justify-content: flex-end;
		animation-name: app-tree-shrink;
		animation-duration: 180ms;
		/* 快起缓收，与展开同曲线；容器的补间曲线须不快于它 */
		animation-timing-function: ease-out;
		animation-fill-mode: forwards;
	}

	/* 收起动画动 max-height 与透明度；这两个属性各状态类都须显式声明（见 .app-tree-node），新增动画属性同此。
	   透明度只占前 15%（约 27ms）先淡完：行在位移最大的头两帧已经看不见；高度仍是整段 180ms */
	@keyframes app-tree-shrink {
		from {
			/* 字面量须与 --std-row-height 同值（keyframes 不支持 var） */
			max-height: 52px;
			opacity: 1;
		}

		15% {
			opacity: 0;
		}

		to {
			max-height: 0px;
			opacity: 0;
		}
	}

	/* 刚展开行的动画变体：与收起同构（起始 0 高、全透明，forwards 保持终值到重烘焙） */
	.app-tree-node-entering {
		max-height: 0px;
		opacity: 0;
		overflow: hidden;
		/* 内容贴底，同收起动画类 */
		justify-content: flex-end;
		animation-name: app-tree-grow;
		animation-duration: 180ms;
		animation-timing-function: ease-out;
		animation-fill-mode: forwards;
	}

	@keyframes app-tree-grow {
		from {
			max-height: 0px;
			opacity: 0;
		}
		to {
			/* 字面量须与 --std-row-height 同值（keyframes 不支持 var） */
			max-height: 52px;
			opacity: 1;
		}
	}

	/* 按压块：高=行高+1，配 margin-top -1px 上探 1px（行距恒=行高，可盖住上一行底线）；左右内缩 8px */
	.app-tree-hit {
		flex-direction: row;
		align-items: center;
		height: 53px;
		margin-top: -1px;
		margin-left: 8px;
		margin-right: 8px;
		border-radius: 8px;
		padding-left: 6px;
		padding-right: 8px;
		position: relative;
	}

	/* 首个可见行不上探（满行高，上方无线可盖） */
	.app-tree-hit-first {
		height: var(--std-row-height);
		margin-top: 0;
	}

	/* 分隔线挂行底：左端 40=箭头槽右缘+2，右端 8；色挂按压类 */
	.app-tree-line {
		position: absolute;
		left: 40px;
		right: 8px;
		bottom: 0;
		height: 1px;
	}

	/* 箭头触区：宽 32×满行高（视觉图标 16 居中）；标题起点与分隔线 left 随之联动 */
	.app-tree-arrow {
		width: 32px;
		height: var(--std-row-height);
		justify-content: center;
		align-items: center;
	}

	.app-tree-arrow-icon {
		font-size: 16px;
		color: var(--std-tertiary-color);
		transition-property: transform;
		transition-duration: 0.2s;
	}

	.app-tree-arrow-open {
		transform: rotate(90deg);
	}

	/* 标题单行省略（挂外层容器） */
	.app-tree-title {
		flex: 1;
		white-space: nowrap;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	/* 标题分段（text 样式不继承，字号/行高/颜色逐段显式） */
	.app-tree-title-seg {
		font-size: var(--std-text-lg);
		line-height: var(--std-leading-lg);
		color: var(--std-emphasis-color);
	}

	/* 过滤命中的关键词段 */
	.app-tree-title-hit {
		font-size: var(--std-text-lg);
		line-height: var(--std-leading-lg);
		color: var(--std-primary);
	}

	/* 选中态=行尾对勾（标题不高亮） */
	.app-tree-check {
		font-size: 16px;
		color: var(--std-primary);
		margin-left: 8px;
	}

	/* 行内加载（与对勾同位） */
	.app-tree-loading {
		margin-left: 8px;
	}

	/* 空态：外包 view 承载居中；v-show 常驻不销毁 */
	.app-tree-empty {
		justify-content: center;
		padding: 8px 0;
	}

	.app-tree-empty-text {
		font-size: var(--std-text-sm);
		line-height: var(--std-leading-sm);
		color: var(--std-tertiary-color);
	}
</style>
