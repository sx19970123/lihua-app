<template>
	<!-- 面板+筛选框+树整体封装：外部只传数据与开关（filterable 控制搜索框显隐） -->
	<view class="app-tree-panel">
		<view v-if="filterable" class="app-tree-search">
			<app-input shape="round" :size="searchSize" :height="searchHeight"
				:placeholder="searchPlaceholder ?? '请输入关键词'" clearable v-model="keyword" />
		</view>
		<scroll-view class="app-tree-scroll" :style="{height: scrollHeight + 'px'}">
			<!-- 节点全量常驻：过滤/收起只切 class，元素不销毁；缩进按层级内联 -->
			<view v-for="state in allStates" :key="state.item.key" :class="state.nodeCls"
				:style="{paddingLeft: (state.level * 20) + 'px'}">
				<view :class="state.hitCls"
					:hover-class="readonly ? 'none' : (themeStore.isDark ? 'app-pressed-row-dark' : 'app-pressed-row')"
					:hover-stay-time="100" @click="onSelect(state.item)">
					<!-- 箭头槽常驻（叶子隐藏占位，标题跨层级对齐）；过滤中命中子树视为展开 -->
					<view class="app-tree-arrow" @click.stop="toggleByItem(state.item)">
						<uni-icons v-if="hasChildren(state.item)" class="app-tree-arrow-icon" :class="state.arrowCls"
							type="right" />
					</view>
					<!-- 关键词高亮=三段常驻 text（空串零宽度，无元素增删） -->
					<text class="app-tree-title"><text class="app-tree-title-seg">{{ state.segBefore }}</text><text
							class="app-tree-title-hit">{{ state.segHit }}</text><text
							class="app-tree-title-seg">{{ state.segAfter }}</text></text>
					<!-- 行尾三态：loadingKey 行转圈（loading 态优先）→ 选中对勾 -->
					<loading v-if="loading && state.item.key === loadingKey" class="app-tree-loading" />
					<uni-icons v-else-if="state.item.key === current" class="app-tree-check"
						type="checkmarkempty" />
					<!-- 行底分隔线：色挂按压类（按压时同色隐形）；显隐烘焙 state.showLine -->
					<view v-show="state.showLine" class="app-tree-line app-pressed-row" />
				</view>
			</view>
			<view v-show="visibleCount === 0" class="app-tree-empty"><text class="app-tree-empty-text">无匹配数据</text></view>
		</scroll-view>
	</view>
</template>

<script setup lang="ts">
	// 通用树形组件：面板+可选筛选框+层级缩进+展开收起+单选（行尾对勾）+宽松过滤。
	// 渲染=全量常驻+可见性切换（不销毁元素）；整块点击=选中，箭头点击=展开收起
	import AppInput from '@/components/app-input/app-input.uvue'
	import { useThemeStore } from '@/stores/theme'
	import { STD_ROW_HEIGHT, STD_TREE_EMPTY_HEIGHT } from '@/utils/tokens-std'

	interface TreeItem {
		// key 必须全树唯一（显隐集合/v-for 复用以其为身份）
		key: string
		title: string
		children?: TreeItem[]
		// 业务负载字段随行携带（如部门 code），select 事件原样回传
		[prop: string]: any
	}

	interface TreeState {
		item: TreeItem
		level: number
		// 行可见性（烘焙中间量：cls/showLine/firstVisible 都由它派生）与箭头朝向类
		shown: boolean
		arrowCls: string
		// 行底分隔线显隐（末个可见行下方无线，含过滤态；同样烘焙）
		showLine: boolean
		// 首个可见行（上方无线，hit 不上探；过滤态重算）
		firstVisible: boolean
		// 行/按压块的完整 class（模板纯读；x 端仅单类选择器）
		nodeCls: string
		hitCls: string
		// 标题三段（命中段高亮；非过滤态 segBefore=整段、其余空串）
		segBefore: string
		segHit: string
		segAfter: string
	}

	const props = defineProps<{
		data: TreeItem[]
		// 默认展开全部节点
		defaultExpandAll?: boolean
		// 当前选中节点 key（v-model:current）
		current?: string
		// 显示内置筛选框（关键词宽松过滤+命中高亮）
		filterable?: boolean
		// 筛选框透传子集（转发给内置 app-input；缺省 default 档）
		searchPlaceholder?: string
		searchSize?: 'small' | 'default' | 'large'
		searchHeight?: number
		// 行内加载态：loadingKey 对应行尾显示转圈
		// 只读：整行点击不触发选中与按压反馈（箭头展开收起保留）
		readonly?: boolean
		loading?: boolean
		loadingKey?: string
		// 滚动区最大高度（px，缺省 210；可由外部按视口计算传入）
		maxHeight?: number
	}>()

	const emit = defineEmits<{
		(e: 'update:current', key: string): void
		(e: 'select', key: string, item: TreeItem): void
	}>()

	// 全量状态列表：深度优先一次拍平，此后长度与顺序永不再变（保证元素不增删）
	const allStates = ref<TreeState[]>([])

	const buildStates = (items : TreeItem[], level : number, out : TreeState[]) => {
		items.forEach(item => {
			out.push({item, level, shown: true, arrowCls: '', showLine: false, firstVisible: false,
				nodeCls: 'app-tree-node', hitCls: 'app-tree-hit', segBefore: '', segHit: '', segAfter: ''})
			if (item.children && item.children.length > 0) {
				buildStates(item.children, level + 1, out)
			}
		})
	}

	// 展开态（key 集合；树规模小，数组 includes 足够）
	const expandedKeys = ref<string[]>([])

	const collectParentKeys = (items : TreeItem[]) : string[] => {
		const keys : string[] = []
		items.forEach(item => {
			if (item.children && item.children.length > 0) {
				keys.push(item.key)
				keys.push(...collectParentKeys(item.children))
			}
		})
		return keys
	}

	watch(() => props.data, (val) => {
		const states : TreeState[] = []
		buildStates(val, 0, states)
		allStates.value = states
		if (props.defaultExpandAll) {
			expandedKeys.value = collectParentKeys(val)
		}
	}, { immediate: true })

	// 过滤关键字（经 filter 方法置入）
	const keyword = ref<string>('')
	const filtering = computed(() : boolean => keyword.value !== '')

	const hasChildren = (item : TreeItem) : boolean => !!item.children && item.children.length > 0

	const toggleByItem = (item : TreeItem) => {
		if (!hasChildren(item) || filtering.value) {
			return
		}
		const index = expandedKeys.value.indexOf(item.key)
		if (index >= 0) {
			expandedKeys.value.splice(index, 1)
		} else {
			expandedKeys.value.push(item.key)
		}
	}

	// 行内 loading 兼任操作锁：loading 期间拒绝新选中
	const onSelect = (item : TreeItem) => {
		if (props.readonly || props.loading) {
			return
		}
		emit('update:current', item.key)
		emit('select', item.key, item)
	}

	// 可见 key 集（非过滤=祖先全展开；过滤=宽松语义：自身命中→整棵子树全显、后代命中→可见并下探）
	const visibleKeySet = computed(() : Set<string> => {
		const set = new Set<string>()
		if (filtering.value) {
			walkFilter(props.data, set)
		} else {
			walk(props.data, set)
		}
		return set
	})

	const walk = (items : TreeItem[], set : Set<string>) => {
		items.forEach(item => {
			set.add(item.key)
			if (hasChildren(item) && expandedKeys.value.includes(item.key)) {
				walk(item.children!, set)
			}
		})
	}

	const matchSelf = (item : TreeItem) : boolean => item.title.includes(keyword.value)

	const matchTree = (item : TreeItem) : boolean => {
		if (matchSelf(item)) {
			return true
		}
		if (item.children) {
			for (let i = 0; i < item.children.length; i++) {
				if (matchTree(item.children[i])) {
					return true
				}
			}
		}
		return false
	}

	const pushAll = (item : TreeItem, set : Set<string>) => {
		set.add(item.key)
		if (item.children) {
			item.children.forEach(child => pushAll(child, set))
		}
	}

	const walkFilter = (items : TreeItem[], set : Set<string>) => {
		items.forEach(item => {
			if (matchSelf(item)) {
				pushAll(item, set)
			} else if (item.children && item.children.some(child => matchTree(child))) {
				set.add(item.key)
				walkFilter(item.children, set)
			}
		})
	}

	// 状态烘焙：写入 state 字段，模板纯属性读。
	// prevShownMap 为上次的可见快照：与快照相反的行挂动画变体类，稳态不挂 animation
	const prevShownMap = new Map<string, boolean>()

	// 动画收尾重烘焙触发器：收起/展开动画播完后自增，把动画变体切回静态类
	const animEpoch = ref(0)

	watchEffect(() => {
		animEpoch.value // 仅登记依赖
		const set = visibleKeySet.value
		const isFiltering = filtering.value
		const kw = keyword.value
		// 第一遍（正序）：可见性/箭头/标题分段 + 首可见行 + class 烘焙
		let seenBefore = false
		allStates.value.forEach(state => {
			state.shown = set.has(state.item.key)
			state.arrowCls = hasChildren(state.item) && (isFiltering || expandedKeys.value.includes(state.item.key))
				? 'app-tree-arrow-open' : ''
			// 标题分段：首命中三段式（多命中只点亮第一处；未命中=整段）
			const idx = kw ? state.item.title.indexOf(kw) : -1
			if (idx >= 0) {
				state.segBefore = idx > 0 ? state.item.title.slice(0, idx) : ''
				state.segHit = kw
				state.segAfter = state.item.title.slice(idx + kw.length)
			} else {
				state.segBefore = state.item.title
				state.segHit = ''
				state.segAfter = ''
			}
			// 首可见行不上探（上探会伸出滚动区顶被裁）
			state.firstVisible = !seenBefore && state.shown
			if (state.shown) {
				seenBefore = true
			}
		// class：刚变化的行挂动画变体（180ms），稳态挂无动画静态类
		const wasShown = prevShownMap.get(state.item.key) ?? state.shown
		let nodeCls = 'app-tree-node'
		if (!state.shown) {
			nodeCls += wasShown ? ' app-tree-node-collapsed-anim' : ' app-tree-node-collapsed'
		} else if (!wasShown) {
			nodeCls += ' app-tree-node-entering'
		}
		state.nodeCls = nodeCls
			state.hitCls = 'app-tree-hit' + (state.firstVisible ? ' app-tree-hit-first' : '')
			prevShownMap.set(state.item.key, state.shown)
		})
		// 第二遍（倒序）：底线——本行可见且之后仍存在可见行才显示（末个可见行下方无线；过滤态同样成立）
		let seenAfter = false
		for (let i = allStates.value.length - 1; i >= 0; i--) {
			const state = allStates.value[i]
			state.showLine = seenAfter
			if (state.shown) {
				seenAfter = true
			}
		}
	})

	const visibleCount = computed(() : number => visibleKeySet.value.size)

	// 行高/空态高度：std token 的 JS 镜像（utils/tokens-std.ts）
	const ROW_HEIGHT = STD_ROW_HEIGHT
	const EMPTY_HEIGHT = STD_TREE_EMPTY_HEIGHT

	// 容器行数延迟跟随（收起方向）：动画播完容器再收终值，否则渐收中的末尾行会被裁在视口外；
	// 展开/收起后 200ms 重烘焙一次，把播完的动画变体切回稳态类
	const deferredRows = ref<number>(visibleCount.value)
	watch(visibleCount, (rows) => {
		const collapsing = rows < deferredRows.value
		if (!collapsing) {
			deferredRows.value = rows
		}
		setTimeout(() => {
			if (collapsing) {
				deferredRows.value = visibleCount.value
			}
			animEpoch.value++
		}, 200)
	})

	// 滚动区显式高度：行数×行高（空态给 empty 高度），超 maxHeight 截断
	const scrollHeight = computed(() : number => {
		return deferredRows.value === 0 ? EMPTY_HEIGHT : Math.min(deferredRows.value * ROW_HEIGHT, props.maxHeight ?? 210)
	})

	// 过滤入口（空串=清除过滤，恢复展开态视图）
	const filter = (value : string) => {
		keyword.value = value
	}

	// 按压高亮亮暗感知（选 hover 亮/暗类）
	const themeStore = useThemeStore()
	themeStore.init()

	defineExpose({ filter })
</script>

<style lang="scss">
	/* 按压类（styles/press.scss） */
	@import '@/styles/press.scss';

	/* 面板壳：底色/圆角走 token；上下内距 8px（scroll-view 的 css padding 在 x 端不生效） */
	.app-tree-panel {
		flex-direction: column;
		width: 100%;
		padding-top: 8px;
		padding-bottom: 8px;
		background-color: var(--std-emphasis-bg);
		border-radius: var(--std-radius);
		overflow: hidden;
	}

	/* 搜索区内距：上下 8px（下内距与首行按压高亮留出间隙），左右=行内距 */
	.app-tree-search {
		padding: var(--std-gap-sm) var(--std-list-pad-x);
	}

	/* 滚动区高度由 scrollHeight 显式驱动 */

	/* 行基准：高度=行高 token；缩进 20px/级，箭头 16px 旋 90°，选中=行尾对勾 */
	.app-tree-node {
		/* 高度权威源=max-height 单属性：展开=行高，收起=0，由动画过渡 */
		max-height: var(--std-row-height);
		position: relative;
		/* 允许按压块上探 1px 渲染 */
		overflow: visible;
		/* max-height 过渡：App 端不生效（走下方 keyframes），仅 Web/微信端用于被打断时的平滑收尾 */
		transition-property: max-height;
		transition-duration: 180ms;
		transition-timing-function: ease;
	}

	/* 收起稳态：静态无 animation（常驻动画切后台恢复时会被重置） */
	.app-tree-node-collapsed {
		max-height: 0px;
		overflow: hidden;
	}

	/* 刚收起行的动画变体：静态值取起始高，forwards 保持终值到重烘焙切回静态类 */
	.app-tree-node-collapsed-anim {
		max-height: var(--std-row-height);
		overflow: hidden;
		/* 内容贴底：行高变化时内容随底边滑动 */
		justify-content: flex-end;
		animation-name: app-tree-shrink;
		animation-duration: 180ms;
		/* 缓起快收，与展开的 ease-out 互为时间镜像 */
		animation-timing-function: ease-in;
		animation-fill-mode: forwards;
	}

	/* 收起动画只动 max-height（各状态类都显式声明它，类切换后有值可还原）；勿加 opacity */
	@keyframes app-tree-shrink {
		from {
			/* 字面量须与 --std-row-height 同值（keyframes 不支持 var） */
			max-height: 52px;
		}
		to {
			max-height: 0px;
		}
	}

	/* 刚展开行的动画变体：与收起同构（起始 0、forwards 保持终值到重烘焙） */
	.app-tree-node-entering {
		max-height: 0px;
		overflow: hidden;
		justify-content: flex-end; // 同收起动画类：内容贴底
		animation-name: app-tree-grow;
		animation-duration: 180ms;
		animation-timing-function: ease-out;
		animation-fill-mode: forwards;
	}

	@keyframes app-tree-grow {
		from {
			max-height: 0px;
		}
		to {
			/* 字面量须与 --std-row-height 同值（keyframes 不支持 var） */
			max-height: 52px;
		}
	}

	/* 按压块：高=行高+1，配 margin-top -1px 上探 1px（行距恒=行高，可盖住上一行底线）；左右内缩 8px */
	.app-tree-hit {
		flex-direction: row;
		align-items: center;
		height: 53px;
		margin-top: -1px;
		margin-left: 8px;
		margin-right: 8px;
		border-radius: 8px;
		padding-left: 6px;
		padding-right: 8px;
		position: relative;
	}

	/* 首个可见行不上探（满行高，上方无线可盖） */
	.app-tree-hit-first {
		height: var(--std-row-height);
		margin-top: 0;
	}

	/* 分隔线挂行底：左端 40=箭头槽右缘+2，右端 8；色挂按压类 */
	.app-tree-line {
		position: absolute;
		left: 40px;
		right: 8px;
		bottom: 0;
		height: 1px;
	}

	/* 箭头触区：宽 32×满行高（视觉图标 16 居中）；标题起点与分隔线 left 随之联动 */
	.app-tree-arrow {
		width: 32px;
		height: var(--std-row-height);
		justify-content: center;
		align-items: center;
	}

	.app-tree-arrow-icon {
		font-size: 16px;
		color: var(--std-tertiary-color);
		transition-property: transform;
		transition-duration: 0.2s;
	}

	.app-tree-arrow-open {
		transform: rotate(90deg);
	}

	/* 标题单行省略（挂外层容器） */
	.app-tree-title {
		flex: 1;
		white-space: nowrap;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	/* 标题分段（text 样式不继承，字号/行高/颜色逐段显式） */
	.app-tree-title-seg {
		font-size: var(--std-text-lg);
		line-height: var(--std-leading-lg);
		color: var(--std-emphasis-color);
	}

	/* 过滤命中的关键词段 */
	.app-tree-title-hit {
		font-size: var(--std-text-lg);
		line-height: var(--std-leading-lg);
		color: var(--std-primary);
	}

	/* 选中态=行尾对勾（标题不高亮） */
	.app-tree-check {
		font-size: 16px;
		color: var(--std-primary);
		margin-left: 8px;
	}

	/* 行内加载转圈（与对勾同位） */
	.app-tree-loading {
		width: 16px;
		height: 16px;
		border-color: var(--std-primary);
		margin-left: 8px;
	}

	/* 空态：外包 view 承载居中；v-show 常驻不销毁 */
	.app-tree-empty {
		justify-content: center;
		padding: 8px 0;
	}

	.app-tree-empty-text {
		font-size: var(--std-text-sm);
		line-height: var(--std-leading-sm);
		color: var(--std-tertiary-color);
	}
</style>
