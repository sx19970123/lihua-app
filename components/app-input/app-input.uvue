<template>
	<view class="app-input">
		<!-- 卡片层：height prop 显式定高（缺省自然高），输入行垂直居中。
		     聚焦不染色：对齐原生 App 输入框习惯（光标即反馈），web design system 的 primary 边框不做 -->
		<view class="app-input-card" :style="cardStyle" :class="{
			'app-input-round': shape === 'round',
			'app-input-sm': size === 'small',
			'app-input-lg': size === 'large',
			'app-input-disabled': disabled
		}">
			<view v-if="slots.prepend" class="app-input-prepend">
				<slot name="prepend" />
			</view>
			<input class="app-input-control" :class="{
				'app-input-control-readonly': readonly,
				'app-input-control-disabled': disabled,
				'app-input-control-sm': size === 'small',
				'app-input-control-lg': size === 'large'
			}" :value="modelValue"
				:password="password && !showPassword" :placeholder="placeholder" :disabled="disabled"
				:maxlength="maxlength ?? -1" placeholder-class="app-input-placeholder" @input="onInput"
				@focus="onFocus" @blur="onBlur" />
			<view v-if="clearable && !disabled && !readonly && modelValue" class="app-input-tool" @click="onClear">
				<uni-icons class="app-input-tool-clear" type="clear" />
			</view>
			<view v-if="password && !disabled" class="app-input-tool" @click="togglePassword">
				<uni-icons class="app-input-tool-eye" :type="showPassword ? 'eye' : 'eye-slash'" />
			</view>
			<text v-if="showCount && validMaxlength" class="app-input-count">{{ (modelValue?.length ?? 0) }}/{{ maxlength }}</text>
			<view v-if="slots.append" class="app-input-append">
				<slot name="append" />
			</view>
		</view>
		<!-- 密码强度条（password + showStrength）：fixed 提升到页面根级布局（官方语义：不参与父节点
		     布局），逃离组件盒边界（x 端盒外内容被裁切的实证），坐标由卡片层量测直驱（对象 style）；
		     完全脱流组件对外高度恒等于卡片高。显隐=常驻节点 class 切换（值非空=下滑+淡入） -->
		<view v-if="password && showStrength" class="app-input-strength" :style="strengthPos"
			:class="modelValue ? 'app-input-strength-show' : ''">
			<view class="app-input-strength-seg">
				<view class="app-input-strength-fill app-input-strength-red"
					:class="strengthLevel >= 1 ? 'app-input-strength-lit' : ''" />
			</view>
			<view class="app-input-strength-seg">
				<view class="app-input-strength-fill app-input-strength-orange"
					:class="strengthLevel >= 2 ? 'app-input-strength-lit' : ''" />
			</view>
			<view class="app-input-strength-seg">
				<view class="app-input-strength-fill app-input-strength-green"
					:class="strengthLevel >= 3 ? 'app-input-strength-lit' : ''" />
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
// 视觉对齐 sard-uniapp Input（白底卡片+灰边框；聚焦不染色对齐原生 App 习惯，ucss 无伪类）
import { getPasswordStrength } from '@/helpers/password-strength'

const props = defineProps<{
	// 输入值（v-model）
	modelValue: string
	// 密码模式
	password?: boolean
	placeholder?: string
	// value 非空即显示清除钮
	clearable?: boolean
	// 形状：default 圆角卡片 / round 胶囊
	shape?: 'default' | 'round'
	// 尺寸
	size?: 'small' | 'default' | 'large'
	// 禁用（透传内置 input，含置灰样式）
	disabled?: boolean
	// 只读：pointer-events none（内置 input 无 readonly，x 原生支持该 css）
	readonly?: boolean
	// 最大输入长度（透传内置 input）
	maxlength?: number
	// 显示字数统计（maxlength 有效时生效）
	showCount?: boolean
	// 显式卡片高度（px，可选；缺省按内容自然高）
	height?: number
	// 密码强度条（仅 password 模式生效：fixed 定位三段指示，量测坐标悬浮于卡片下方，不占组件对外高度）
	showStrength?: boolean
}>()

const emit = defineEmits<{
	(e: 'update:modelValue', value: string): void
	(e: 'focus'): void
	(e: 'blur'): void
}>()

const slots = useSlots()

// 密码明文切换（默认隐藏）
const showPassword = ref<boolean>(false)

// maxlength 有效值（>0 才启用 count）
const validMaxlength = computed(() => props.maxlength !== undefined && props.maxlength > 0)

// 显式卡片高度：对象语法 style 绑定（Vapor 端字符串 style 不解析，项目先例 captcha themeBg）
const cardStyle = computed(() : any => props.height !== undefined ? { height: props.height + 'px' } : {})

// 组件实例（量测用）：onMounted 内缓存（异步上下文 getCurrentInstance 为 null，captcha 同坑）
let ownerInstance : any = null

// 强度条 fixed 坐标（卡片量测直驱；键盘覆盖不推挤、auth 页禁滚，坐标静态无需重测）
const strengthPos = ref<any>({})

// 量测卡片层位置，驱动强度条 fixed 坐标（top=卡片底缘+4px，左右内缩 12px 对齐卡片 padding 内缘）
const measureStrength = () => {
	uni.createSelectorQuery().in(ownerInstance ?? getCurrentInstance()?.proxy)?.select('.app-input-card')?.boundingClientRect()?.exec((ret) => {
		const rect = ret[0] as { left : number, top : number, width : number, height : number } | null
		if (rect) {
			strengthPos.value = {
				top: (rect.top + rect.height + 4) + 'px',
				left: (rect.left + 12) + 'px',
				width: (rect.width - 24) + 'px'
			}
		}
	})
}

// 强度等级：0 未达弱 / 1 弱 / 2 中 / 3 强（阈值与 web/master 同源，见 helpers/password-strength）
const strengthLevel = computed(() : number => getPasswordStrength(props.modelValue))

const onInput = (e: InputEvent) => {
	emit('update:modelValue', e.detail.value)
}

// 焦点事件透传（组件不自带重量测——屏外挂载等场景的坐标补偿由消费方经 @focus + remeasure() 自行触发）
const onFocus = () => {
	emit('focus')
}

const onBlur = () => {
	emit('blur')
}

const onClear = () => {
	emit('update:modelValue', '')
}

const togglePassword = () => {
	showPassword.value = !showPassword.value
}

onMounted(() => {
	ownerInstance = getCurrentInstance()?.proxy ?? null
	if (props.password && props.showStrength) {
		// 首帧渲染完成后量测（挂载即量可能拿到零尺寸；屏外挂载的坐标无效，消费方可调 remeasure()）
		nextTick(() => measureStrength())
	}
})

defineExpose({ remeasure: measureStrength })
</script>

<style>
/* 壳：仅纵向堆叠容器（卡片 + fixed 强度条挂载点）；对外高度=卡片高度，强度条脱流不参与 */
.app-input {
	flex-direction: column;
	width: 100%;
}

/* 卡片层：height prop 显式定高（对象 style 绑定），缺省按内容自然高；row 布局输入行垂直居中。
   勿加 flex:1——不定高壳内 flex-basis 0% 会抢占 height 的主轴尺寸 */
.app-input-card {
	flex-direction: row;
	align-items: center;
	width: 100%;
	/* 卡片底色：亮=sar-white 面 / 暗=sar gray-900（dark emphasis-bg surface）；组件级 token 可被主题覆盖 */
	background-color: var(--lh-input-bg, #ffffff);
	padding: 5px 12px;
	border: 1px solid var(--lh-border-color, #e2e3e4);
	border-radius: var(--lh-radius);
}

@media (prefers-color-scheme: dark) {
	.app-input-card {
		background-color: var(--lh-input-bg, #242628);
	}
}

.app-input-round {
	border-radius: var(--lh-radius-full);
}

.app-input-sm {
	padding-top: 3px;
	padding-bottom: 3px;
}

.app-input-lg {
	padding-top: 6px;
	padding-bottom: 6px;
}

.app-input-disabled {
	background-color: var(--lh-disabled-shallow-bg, #ecedee);
}

@media (prefers-color-scheme: dark) {
	.app-input-disabled {
		background-color: var(--lh-disabled-shallow-bg, #505457);
	}
}

.app-input-prepend {
	margin-right: 8px;
}

/* 内置 input 透明底融入根容器，根壳负责底色与边框 */
.app-input-control {
	flex: 1;
	height: 24px;
	font-size: 14px;
	color: var(--lh-emphasis-color);
	background-color: transparent;
	padding: 0;
}

/* placeholder 走 fourth token（亮 gray-500/暗 gray-600），placeholder-class App 端原生支持（Web/小程序 x，S6 再议） */
.app-input-placeholder {
	color: var(--lh-fourth-color);
}

/* size 三档=完整视觉档位（control 高度+字号，根高由 padding+control 自然撑，页面可用 class 定死） */
.app-input-control-sm {
	height: 20px;
	font-size: 12px;
}

.app-input-control-lg {
	height: 28px;
	font-size: 16px;
}

.app-input-control-readonly {
	/* x 内置 input 无 readonly，pointer-events none 实现只读（点不进、不弹键盘） */
	pointer-events: none;
}

.app-input-control-disabled {
	color: var(--lh-disabled-color, #b5b9bd);
}

.app-input-tool {
	padding: 0 4px;
}

/* 图标色走语义 token（uni-icons 单 text 根，外部 class 落根）：clear 更醒目用 tertiary、eye 次要语义用 fourth */
.app-input-tool-clear {
	font-size: 18px;
	color: var(--lh-tertiary-color, #74787c);
}

.app-input-tool-eye {
	font-size: 18px;
	color: var(--lh-fourth-color, #b5b9bd);
}

.app-input-count {
	font-size: 12px;
	color: var(--lh-tertiary-color, #74787c);
	margin-left: 6px;
}

.app-input-append {
	margin-left: 8px;
}

/* 密码强度条：fixed 提升到页面根级（官方语义：不参与父节点布局），top/left/width 由卡片量测
   运行时直驱（对象 style），此处只定形态与动画。显隐=常驻节点 class 切换（v-if 卸载无过渡）：
   值非空下滑+淡入，退场反向；轨道灰底常驻 */
.app-input-strength {
	position: fixed;
	flex-direction: row;
	align-items: center;
	height: 3px;
	opacity: 0;
	transform: translateY(-4px);
	transition-property: transform, opacity;
	transition-duration: 0.3s;
	transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
}

.app-input-strength-show {
	opacity: 1;
	transform: translateY(0);
}

/* 轨道层：未点亮底色，亮 gray-200 / 暗 gray-700 */
.app-input-strength-seg {
	flex: 1;
	height: 3px;
	border-radius: 2px;
	margin-left: 2px;
	margin-right: 2px;
	background-color: var(--lh-gray-200);
}

@media (prefers-color-scheme: dark) {
	.app-input-strength-seg {
		background-color: var(--lh-gray-700);
	}
}

/* 彩色填充层：默认收起隐形，lit 从左向右展开覆盖轨道、退回时露出灰底（origin left 双向同轴） */
.app-input-strength-fill {
	width: 100%;
	height: 3px;
	border-radius: 2px;
	transform: scaleX(0);
	transform-origin: left;
	transition-property: transform;
	transition-duration: 0.4s;
	transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
}

.app-input-strength-lit {
	transform: scaleX(1);
}

/* 三段点亮色与 web/master 三端一致（红/橙/绿） */
.app-input-strength-red {
	background-color: #ff4d4f;
}

.app-input-strength-orange {
	background-color: #faad14;
}

.app-input-strength-green {
	background-color: #52c41a;
}
</style>
