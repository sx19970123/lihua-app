<template>
	<view class="app-segmented" :class="rootCls" @touchstart="onTouchStart" @touchmove="onTouchMove"
		@touchend="onTouchEnd" @touchcancel="onTouchEnd">
		<view ref="groupEl" class="app-segmented-group">
			<!-- 按压高亮：与滑块同形同位，层序在滑块下 -->
			<view class="app-segmented-ghost" :class="ghostCls" :style="ghostStyle" />
			<!-- 滑块：纯色块无文案（选中态=段内文字/图标变色，落下后才高亮） -->
			<view :class="pointerCls" :style="pointerStyle" />
			<!-- 内容层：层序在滑块上，兼触区 -->
			<view class="app-segmented-row" :class="rowCls">
				<view v-for="(opt, i) in items" :key="opt.value" class="app-segmented-item" :class="itemCls"
					:style="cellStyle" @touchstart="onItemTouchStart(i)" @click="onItemTap(i)">
					<!-- 图标槽：icon 字段兜底，或 #icon 插槽按段自定义 -->
					<view v-if="hasIcon" class="app-segmented-icon" :class="iconCls">
						<slot name="icon" :item="opt" :index="i" :selected="index === i">
							<uni-icons v-if="opt.icon !== ''" class="app-segmented-icon-glyph" :class="glyphCls[i]"
								:type="opt.icon" />
						</slot>
					</view>
					<text v-if="opt.label !== ''" class="app-segmented-label" :class="labelCls[i]">{{ opt.label }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	// 分段器：等分滑块，点选切换、按住滑块拖动切换；三档外高同 app-input，拖动到位轻震，
	// 滑块到头压缩自身不越界。滑块位移走 :style 绑定：拖动跟手，松手弹簧落位（utils/spring）

	import { useThemeStore } from '@/stores/theme'
	import { haptic } from '@/utils/haptic'
	import { createSpringControl } from '@/utils/spring'

	type SegmentedOption = {
		label : string
		value : string
		disabled ?: boolean
		// uni-icons 字形名（或用 #icon 插槽）
		icon ?: string
	}

	// 选项归一后的形态（icon 空串=无图标）
	type SegItem = { label : string, value : string, disabled : boolean, icon : string }

	// 可选布尔属性不传即为 false，默认开的开关须在 withDefaults 里显式给
	const props = withDefaults(defineProps<{
		// 选项：裸字符串=值即标签；对象可单项禁用/带图标（label 空串=纯图标段）
		options : (string | SegmentedOption)[]
		// 当前值（v-model）
		modelValue ?: string
		// 三档：small / default（默认）/ large
		size ?: 'small' | 'default' | 'large'
		// default=主圆角（默认）；round=胶囊
		shape ?: 'default' | 'round'
		// 全局禁用
		disabled ?: boolean
		// 是否占满父容器宽度；false=宽度随内容并靠左，段位取最宽者等分
		block ?: boolean
		// 按压高亮
		hover ?: boolean
	}>(), {
		block : true,
		hover : true
	})

	const emit = defineEmits<{
		(e : 'update:modelValue', value : string) : void
		(e : 'change', value : string) : void
	}>()

	// #icon 作用域插槽（item/index/selected）；内容与文字的间距由消费方自管
	defineSlots<{
		icon(props : { item : SegItem, index : number, selected : boolean }) : any
	}>()

	// 滑块越过两端时，越界量转成自身宽度压缩的比例（越小越硬）；压缩量封顶段宽的 14%
	const SQUASH = 0.32
	// 拖过尽头时越界量的阻尼
	const OVER_DRAG = 0.3

	const themeStore = useThemeStore()
	themeStore.init()

	const slots = useSlots()

	// 选项归一（烘焙源）
	const items = computed<SegItem[]>(() => {
		return (props.options ?? []).map((o : string | SegmentedOption) : SegItem => {
			if (typeof o === 'string') {
				return { label: o, value: o, disabled: false, icon: '' }
			}
			return { label: o.label, value: o.value, disabled: o.disabled === true, icon: o.icon ?? '' }
		})
	})

	const valueAt = (i : number) : string => {
		const arr = items.value
		return i >= 0 && i < arr.length ? arr[i].value : ''
	}

	const indexOfValue = (v : string) : number => {
		const arr = items.value
		for (let i = 0; i < arr.length; i++) {
			if (arr[i].value === v) {
				return i
			}
		}
		return -1
	}

	// 选中索引（单一响应式真源：滑块位移/段文字变色同源）
	const index = ref<number>(0)

	// 烘焙类（纯属性读）
	const isRound = computed<boolean>(() => props.shape === 'round')
	const isDisabledAll = computed<boolean>(() => props.disabled === true)
	const isSmall = computed<boolean>(() => props.size === 'small')
	const isBlock = computed<boolean>(() => props.block)

	// 内容宽模式：段位先按自然宽排版，量到最宽者后统一等宽；量到之前滑块不显示
	const cellW = ref<number>(0)
	const ready = computed<boolean>(() => isBlock.value || cellW.value > 0)
	const cellStyle = computed<any>(() => {
		return (!isBlock.value && cellW.value > 0) ? { width: cellW.value + 'px' } : {}
	})

	const rootCls = computed<string>(() => (isRound.value ? 'app-segmented--round' : '')
		+ (isBlock.value ? '' : ' app-segmented--hug'))
	const rowCls = computed<string>(() => (isBlock.value ? '' : 'app-segmented-row--hug'))
	// 尺寸档落段位（内距直构；default 档走基类）
	const itemCls = computed<string>(() => {
		let cls = props.size === 'small' ? 'app-segmented-item--small'
			: (props.size === 'large' ? 'app-segmented-item--large' : '')
		if (!isBlock.value) {
			cls += (cls === '' ? '' : ' ') + 'app-segmented-item--hug'
		}
		return cls
	})
	const iconCls = computed<string>(() => (isSmall.value ? 'app-segmented-icon-sm' : ''))
	// 图标槽渲染条件：任一段带 icon，或提供了 #icon 插槽
	const hasIcon = computed<boolean>(() => !!slots.icon || items.value.some((o : SegItem) : boolean => o.icon !== ''))
	const pointerCls = computed<string>(() => 'app-segmented-pointer'
		+ (isRound.value ? ' app-segmented-pointer--round' : '')
		+ (ready.value ? '' : ' app-segmented-pointer-hide'))

	// 滑块位移：拖动 dragX 1:1 跟手 / 弹簧 animX 逐帧 / 稳态=index×segW（全 JS 驱动，走 :style 绑定）；
	// 越过两端时外缘钉在端点，越界量转成宽度压缩（缩放原点居中，平移量=压缩量的一半）
	const segW = ref<number>(0)
	const dragX = ref<number | null>(null)
	const animX = ref<number | null>(null)
	const pointerStyle = computed<any>(() => {
		const n = items.value.length
		const x = dragX.value != null ? dragX.value : (animX.value != null ? animX.value : index.value * segW.value)
		const width = n > 0 ? (100 / n) + '%' : '0px'
		const max = (n - 1) * segW.value
		let dir = 0
		if (segW.value > 0 && x > max) {
			dir = 1
		} else if (segW.value > 0 && x < 0) {
			dir = -1
		}
		if (dir === 0) {
			return { width, transform: `translateX(${x}px)` }
		}
		const over = dir > 0 ? x - max : -x
		const sq = Math.min(over * SQUASH, segW.value * 0.14)
		return {
			width,
			transform: `translateX(${(dir > 0 ? max : 0) + dir * sq / 2}px) scaleX(${(segW.value - sq) / segW.value})`
		}
	})

	// 按压高亮（hover 可关）：按下的段显示与滑块同形同位的影子（层序在滑块下，底色取按压类）；
	// 位移超 5px（滑动/纵滚）或松手即收起
	const pressIdx = ref<number>(-1)
	const ghostCls = computed<string>(() => 'app-segmented-ghost'
		+ (isRound.value ? ' app-segmented-ghost--round' : '')
		+ (themeStore.isDark ? ' app-pressed-inset-dark' : ' app-pressed-inset')
		+ (pressIdx.value < 0 || !ready.value ? ' app-segmented-ghost-hide' : ''))
	const ghostStyle = computed<any>(() => {
		const n = items.value.length
		return {
			width: n > 0 ? (100 / n) + '%' : '0px',
			transform: `translateX(${Math.max(0, pressIdx.value) * segW.value}px)`
		}
	})

	// 状态色类（文字与图标共用）：禁用灰 / 选中强调（落下后才高亮，拖动中不变色）
	const stateCls = computed<string[]>(() => items.value.map((o : SegItem, i : number) : string => {
		if (o.disabled || isDisabledAll.value) {
			return 'app-segmented-disabled'
		}
		return index.value === i ? 'app-segmented-selected' : ''
	}))
	// 文本档同 app-input：small 挂 sm 修饰类，其余用基类
	const labelCls = computed<string[]>(() => items.value.map((_o : SegItem, i : number) : string => {
		return (isSmall.value ? 'app-segmented-label-sm ' : '') + stateCls.value[i]
	}))
	// 图标字形：small 缩一号，带文字时留间距
	const glyphCls = computed<string[]>(() => items.value.map((o : SegItem, i : number) : string => {
		let cls = isSmall.value ? 'app-segmented-icon-glyph-sm ' : ''
		if (o.label !== '') {
			cls += 'app-segmented-icon-gap '
		}
		return cls + stateCls.value[i]
	}))

	// ---------- 量测与弹簧 ----------
	const groupEl = ref<any>(null)
	// 组件实例（段位量测用），onMounted 内缓存
	let ownerInstance : any = null
	// 组左缘（页面可显示区域坐标），判触点是否落在滑块上
	let groupLeft = -1

	// 段宽=组实宽/段数（拖动开始时重量测）；Async 版跨端通吃（MP 端无同步 getBoundingClientRect）
	const measure = () : void => {
		groupEl.value?.getBoundingClientRectAsync().then((r : any) => {
			const n = items.value.length
			if (r != null && r.width > 0 && n > 0) {
				segW.value = r.width / n
				groupLeft = r.left
			}
		})
	}

	// 内容宽模式：量各段自然宽，取最宽者为统一段宽
	const fitCells = () : void => {
		cellW.value = 0
		nextTick(() => {
			uni.createSelectorQuery().in(ownerInstance)?.selectAll('.app-segmented-item')?.boundingClientRect()?.exec((ret) => {
				const rects = ret[0] as Array<{ width : number }> | null
				if (rects == null || rects.length == 0) {
					return
				}
				let w = 0
				for (let i = 0; i < rects.length; i++) {
					if (rects[i].width > w) {
						w = rects[i].width
					}
				}
				cellW.value = Math.ceil(w)
				nextTick(() => { measure() })
			})
		})
	}

	const springCtl = createSpringControl()

	// 当前视觉位置（手势抢断/弹簧起点取值用）
	const visualX = () : number => dragX.value != null ? dragX.value : (animX.value != null ? animX.value : index.value * segW.value)

	const springDone = () : void => { animX.value = null }

	// 提交选中：弹簧滑到位 + 对外回传（值未变不 emit）
	const commit = (idx : number, velPxPerS : number = 0) => {
		springCtl.cancel()
		const from = visualX()
		const to = idx * segW.value
		index.value = idx
		dragX.value = null
		if (segW.value > 0 && Math.abs(to - from) >= 0.5) {
			animX.value = from
			springCtl.run(from, to, velPxPerS, (x : number) => { animX.value = x }, springDone)
		} else {
			animX.value = null
		}
		const v = valueAt(idx)
		if (v !== '' && v !== (props.modelValue ?? '')) {
			emit('update:modelValue', v)
			emit('change', v)
		}
	}

	const onItemTouchStart = (i : number) => {
		const arr = items.value
		pressIdx.value = (props.hover && !isDisabledAll.value && i >= 0 && i < arr.length && !arr[i].disabled) ? i : -1
	}

	const onItemTap = (i : number) => {
		if (isDisabledAll.value || i === index.value) {
			return
		}
		const arr = items.value
		if (i < 0 || i >= arr.length || arr[i].disabled) {
			return
		}
		commit(i)
	}

	// ---------- 拖动手势 ----------
	let dragTouchId = -1
	let startX = 0
	let startY = 0
	let lockX = 0
	let baseX = 0
	let horizontal : boolean | null = null
	let onThumb = true
	// fling 末速度追踪（EMA 平滑；松手前停顿>80ms 视为有意停住，速度作废）
	let velMs = 0
	let trackX = 0
	let trackT = 0

	// 到位轻震：滑块最近段每变一下；松手目标不同于已震位置再补一下（fling 越段）。点选不震
	let tickIndex = -1
	const tick = () : void => {
		haptic('light')
	}

	const findTouch = (e : TouchEvent, id : number) : Touch | null => {
		for (let i = 0; i < e.changedTouches.length; i++) {
			if (e.changedTouches[i].identifier === id) {
				return e.changedTouches[i]
			}
		}
		for (let i = 0; i < e.touches.length; i++) {
			if (e.touches[i].identifier === id) {
				return e.touches[i]
			}
		}
		return null
	}

	// 松手目标段回避禁用段：按与落点距离向外扫描最近可用段
	const resolveTarget = (target : number) : number => {
		const arr = items.value
		for (let d = 0; d < arr.length; d++) {
			const lo = target - d
			if (lo >= 0 && lo < arr.length && !arr[lo].disabled) {
				return lo
			}
			const hi = target + d
			if (d > 0 && hi >= 0 && hi < arr.length && !arr[hi].disabled) {
				return hi
			}
		}
		return index.value
	}

	const clampIndex = (i : number) : number => {
		const n = items.value.length
		return Math.max(0, Math.min(n - 1, i))
	}

	// 按下不冻结动画：确认是拖动滑块（见 onTouchMove 的方向判定）才冻结，轻点/纵滚时动画照常走完
	const onTouchStart = (e : TouchEvent) => {
		if (isDisabledAll.value || items.value.length < 2) {
			return
		}
		const t = e.changedTouches.length > 0 ? e.changedTouches[0] : e.touches[0]
		if (t == null) {
			return
		}
		dragTouchId = t.identifier
		startX = t.screenX
		startY = t.screenY
		horizontal = null
		velMs = 0
		trackT = Date.now()
		// 触点落在滑块上（左右各放宽 4px）才可拖动；位置未知时不限制
		const x0 = visualX()
		if (segW.value <= 0 || !(groupLeft >= 0)) {
			onThumb = true
		} else {
			onThumb = t.clientX >= groupLeft + x0 - 4 && t.clientX <= groupLeft + x0 + segW.value + 4
		}
		tickIndex = segW.value > 0 ? Math.round(Math.max(0, Math.min((items.value.length - 1) * segW.value, x0)) / segW.value) : index.value
		measure()
	}

	const onTouchMove = (e : TouchEvent) => {
		if (dragTouchId < 0 || segW.value <= 0) {
			return
		}
		const p = findTouch(e, dragTouchId)
		if (p == null) {
			return
		}
		if (horizontal == null) {
			const dx = p.screenX - startX
			const dy = p.screenY - startY
			// 位移过 5px 才定方向，纵向意图让位页面滚动
			if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
				pressIdx.value = -1
				horizontal = Math.abs(dx) > Math.abs(dy) && onThumb
				if (horizontal) {
					e.preventDefault()
					// 锁定拖动这一刻才冻结动画，冻结位即起拖点
					springCtl.cancel()
					const cur = visualX()
					animX.value = null
					dragX.value = cur
					baseX = cur
					trackX = cur
					trackT = Date.now()
					lockX = p.screenX
				}
			}
			return
		}
		if (horizontal !== true) {
			return
		}
		e.preventDefault()
		const maxX = (items.value.length - 1) * segW.value
		const raw = baseX + (p.screenX - lockX)
		// 拖过尽头：越界量按阻尼计入，渲染时转成滑块压缩
		const x = raw > maxX ? maxX + (raw - maxX) * OVER_DRAG : (raw < 0 ? raw * OVER_DRAG : raw)
		dragX.value = x
		// 末速度 EMA（px/ms）
		const now = Date.now()
		const dt = now - trackT
		if (dt > 0) {
			velMs = velMs * 0.7 + ((x - trackX) / dt) * 0.3
		}
		trackX = x
		trackT = now
		// 到位轻震（排在最后：震动异常不影响手势）
		const near = Math.round(Math.max(0, Math.min(maxX, x)) / segW.value)
		if (near !== tickIndex) {
			tickIndex = near
			tick()
		}
	}

	const onTouchEnd = () => {
		pressIdx.value = -1
		if (dragTouchId < 0) {
			return
		}
		dragTouchId = -1
		// 未成拖动（轻点/纵向让位/没按在滑块上）：动画没停过，无需复位
		if (horizontal !== true) {
			horizontal = null
			return
		}
		horizontal = null
		if (segW.value <= 0) {
			return
		}
		const cur = dragX.value != null ? dragX.value : index.value * segW.value
		// fling：末速够猛→目标至少推进到方向上的下一分界（快甩飞段）；否则落最近段
		const vel = (Date.now() - trackT < 80) ? velMs : 0
		let idx : number
		if (Math.abs(vel) > 0.5) {
			const pos = cur / segW.value
			idx = clampIndex(vel > 0 ? Math.ceil(pos + 0.001) : Math.floor(pos - 0.001))
		} else {
			idx = clampIndex(Math.round(cur / segW.value))
		}
		const target = resolveTarget(idx)
		commit(target, vel * 1000)
		if (target !== tickIndex) {
			tickIndex = target
			tick()
		}
	}

	// ---------- 联动与生命周期 ----------
	// 外部值变化 → 滑块跟进（拖动中不抢）
	watch(() => props.modelValue, (v : string | null) => {
		if (dragTouchId >= 0) {
			return
		}
		const idx = indexOfValue(v ?? '')
		if (idx >= 0 && idx !== index.value) {
			commit(idx)
		}
	})

	// 选项/尺寸/宽度模式变化 → 重排后重量测重就位（就位不弹簧）
	const resettle = () => {
		nextTick(() => {
			springCtl.cancel()
			dragX.value = null
			animX.value = null
			index.value = Math.max(0, indexOfValue(props.modelValue ?? ''))
			if (isBlock.value) {
				cellW.value = 0
				measure()
			} else {
				fitCells()
			}
		})
	}
	watch(() => props.options, resettle)
	watch(() => props.size, resettle)
	watch(() => props.block, resettle)

	onMounted(() => {
		ownerInstance = getCurrentInstance()?.proxy ?? null
		resettle()
	})

	onUnmounted(() => {
		springCtl.cancel()
	})
</script>

<style lang="scss">
	/* 按压类（styles/press.scss）：影子高亮的底色 */
	@import '@/styles/press.scss';

	/* 根=轨道：灰底圆角；水平内距即滑块侧边内缩 */
	.app-segmented {
		flex-direction: column;
		padding: 0 var(--std-gap-xs);
		border-radius: var(--std-radius);
		background-color: var(--std-secondary-bg);
	}

	.app-segmented--round {
		border-radius: var(--std-radius-full);
	}

	/* 内容宽模式：不拉伸占满，宽度随内容 */
	.app-segmented--hug {
		align-self: flex-start;
	}

	/* 组：高亮、滑块、内容三层同父，按 z-index 排层序（层序只在同父兄弟间可靠） */
	.app-segmented-group {
		position: relative;
		z-index: 1;
		flex-direction: row;
		align-items: stretch;
	}

	/* 按压高亮：几何与滑块一致 */
	.app-segmented-ghost {
		position: absolute;
		top: var(--std-gap-xs);
		bottom: var(--std-gap-xs);
		left: 0;
		z-index: 0;
		border-radius: 8px;
	}

	.app-segmented-ghost--round {
		border-radius: var(--std-radius-full);
	}

	.app-segmented-ghost-hide {
		opacity: 0;
	}

	/* 内容层：段位的父容器，兼触区 */
	.app-segmented-row {
		position: relative;
		z-index: 2;
		flex: 1;
		flex-direction: row;
	}

	.app-segmented-row--hug {
		flex: 0 0 auto;
	}

	/* 段位：高度由内距撑出（外高同 app-input）；内距必须挂段位，不挂根/组 */
	.app-segmented-item {
		flex: 1;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		min-width: 0;
		padding: var(--std-control-pad-y) var(--std-gap-md);
	}

	.app-segmented-item--hug {
		flex: 0 0 auto;
	}

	.app-segmented-item--small {
		padding-top: var(--std-control-pad-y-sm);
		padding-bottom: var(--std-control-pad-y-sm);
	}

	.app-segmented-item--large {
		padding-top: var(--std-control-pad-y-lg);
		padding-bottom: var(--std-control-pad-y-lg);
	}

	/* 文本档同 app-input：small 走修饰类 */
	.app-segmented-label {
		font-size: var(--std-text-lg);
		line-height: var(--std-leading-lg);
		color: var(--std-secondary-color);
	}

	.app-segmented-label-sm {
		font-size: var(--std-text-sm);
		line-height: var(--std-leading-sm);
	}

	/* 图标槽：行盒钉为文字行高，防 uni-icons 默认行盒撑高段位 */
	.app-segmented-icon {
		flex-direction: row;
		align-items: center;
		height: var(--std-leading-lg);
		overflow: visible;
	}

	.app-segmented-icon-sm {
		height: var(--std-leading-sm);
	}

	.app-segmented-icon-glyph {
		font-size: 18px;
		color: var(--std-secondary-color);
	}

	.app-segmented-icon-glyph-sm {
		font-size: 16px;
	}

	.app-segmented-icon-gap {
		margin-right: var(--std-gap-xs);
	}

	/* 状态色（文字与图标共用）：选中强调 / 禁用灰；须排在各自基类之后 */
	.app-segmented-selected {
		color: var(--std-emphasis-color);
	}

	.app-segmented-disabled {
		color: var(--std-disabled-color);
	}

	/* 滑块：实色；圆角=主圆角减内缩量（同心）；宽=1/n，位移由 JS 驱动 */
	.app-segmented-pointer {
		position: absolute;
		top: var(--std-gap-xs);
		bottom: var(--std-gap-xs);
		left: 0;
		z-index: 1;
		border-radius: 8px;
		background-color: var(--std-emphasis-bg);
	}

	.app-segmented-pointer--round {
		border-radius: var(--std-radius-full);
	}

	.app-segmented-pointer-hide {
		opacity: 0;
	}
</style>
