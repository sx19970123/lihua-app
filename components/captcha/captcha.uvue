<template>
	<view class="lh-cap">
		<!-- 遮罩与浮层同父兄弟、同为 fixed，层序靠显式 z-index（浮层高于 app-mask 的 999） -->
		<app-mask :visible="visible" @backpress="close()" />
		<view v-if="visible" class="lh-cap-mask" :class="{ 'lh-cap-mask--in': entered }" @touchmove="onMaskTouchMove">
			<view class="lh-cap-card" :class="sizeClass">
				<!-- 右上操作区：App/Web 常驻节点 opacity 过渡淡入淡出；微信端 v-if 挂卸 -->
				<!-- 点击挂外层 view（uni-icons 的 click 转发在微信端不可靠） -->
				<!-- #ifndef MP-WEIXIN -->
				<view class="lh-cap-opts" :class="{ 'lh-cap-opts--show': optsVisible }">
					<view class="lh-cap-opts-btn" hover-class="app-pressed-text" :hover-stay-time="100"
						@click="refresh(false)">
						<uni-icons class="lh-cap-opts-icon" type="refreshempty" />
					</view>
					<view class="lh-cap-opts-btn lh-cap-opts-btn--end" hover-class="app-pressed-text" :hover-stay-time="100"
						@click="close()">
						<uni-icons class="lh-cap-opts-icon" type="closeempty" />
					</view>
				</view>
				<!-- #endif -->
				<!-- #ifdef MP-WEIXIN -->
				<view v-if="optsVisible" class="lh-cap-opts lh-cap-opts--show">
					<view class="lh-cap-opts-btn" hover-class="app-pressed-text" :hover-stay-time="100"
						@click="refresh(false)">
						<uni-icons class="lh-cap-opts-icon" type="refreshempty" />
					</view>
					<view class="lh-cap-opts-btn lh-cap-opts-btn--end" hover-class="app-pressed-text" :hover-stay-time="100"
						@click="close()">
						<uni-icons class="lh-cap-opts-icon" type="closeempty" />
					</view>
				</view>
				<!-- #endif -->

				<!-- 切换期间中央 loading：滑出完成且响应未到才显示，数据到进 in 相位即藏 -->
				<view v-if="slidePhase === 'waiting'" class="lh-cap-switch-loading">
					<view class="lh-cap-spinner"></view>
					<text class="lh-cap-zone-text">正在加载...</text>
				</view>

				<!-- 内容裁切层：overflow 收在 padding 内缘，滑出/滑入的内容碰边即消失 -->
				<view class="lh-cap-clip">
					<!-- 加载 / 错误 -->
					<view v-if="captchaLoading" class="lh-cap-zone">
						<view class="lh-cap-spinner"></view>
						<text class="lh-cap-zone-text">加载中...</text>
					</view>
					<!-- view 承担居中，点击挂外层 -->
					<view v-else-if="loadingError" class="lh-cap-error" @click="refresh(false)">
						<text class="lh-cap-error-text">{{ loadingError }}，点击重试</text>
					</view>

					<!-- 工作量证明（POW）：滑动→挖矿（钮变 spinner）→彩带结果；:key 换码重建 -->
					<!-- 静态 style 起点 -288：App/Web 由 setProperty 直驱；微信端由 :style 三态覆盖（见 slideStyleMp） -->
					<view v-else-if="type === 'POW'" :key="'pow-' + captchaId" class="lh-cap-pow"
						style="transform: translateX(-288px)" :class="slideStyleMp" ref="contentEl">
						<text class="lh-cap-tip">安全校验</text>
						<view class="lh-cap-track">
							<text class="lh-cap-track-text">{{ powTrackText }}</text>
							<!-- 结果彩带：从左向右铺满轨道，文案铺满后淡入 -->
							<view v-if="powPhase === 'success' || powPhase === 'fail'"
								class="lh-cap-ribbon" :class="powPhase === 'success' ? 'lh-cap-ribbon-ok' : 'lh-cap-ribbon-no'">
								<text class="lh-cap-ribbon-text">{{ powPhase === 'success' ? powSuccessMsg : powFailMsg }}</text>
							</view>
							<view class="lh-cap-unit" ref="powUnitEl" @touchstart="onPowTouchStart"
								@touchmove="onPowTouchMove" @touchend="onPowTouchEnd" @touchcancel="onPowTouchCancel">
								<view v-if="powPhase !== 'success' && powPhase !== 'fail'" class="lh-cap-unit-fill" :style="themeBg"></view>
								<!-- 结果期彩带铺满轨道，滑块随之隐藏 -->
								<view v-if="powPhase !== 'success' && powPhase !== 'fail'" class="lh-cap-unit-thumb" :style="themeBg">
									<view v-if="powPhase === 'mining'" class="lh-cap-thumb-spinner"></view>
									<uni-icons v-else class="lh-cap-unit-thumb-icon" type="arrow-right" />
								</view>
							</view>
						</view>
					</view>

						<!-- 图形四类型；:key 换码重建防 transform 残留 -->
						<view v-else :key="'graphic-' + captchaId" class="lh-cap-graphic"
							style="transform: translateX(-288px)" :class="slideStyleMp" ref="contentEl">
						<text class="lh-cap-tip">{{ type === 'WORD_IMAGE_CLICK' ? '请依次点击文字' : '拖动滑块完成拼图' }}</text>
						<view v-if="type === 'WORD_IMAGE_CLICK'" class="lh-cap-click-tips">
							<image class="lh-cap-click-hint" :src="sliderImage" mode="scaleToFill" />
						</view>
						<view class="lh-cap-image-wrap">
							<image class="lh-cap-image" :src="backgroundImage" mode="scaleToFill" />
							<!-- 拼接：overflow hidden 窗口 + 整图平移 -->
							<view v-if="type === 'CONCAT'" key="concat" class="lh-cap-concat" :style="{ height: concatHeight + 'px' }">
								<view class="lh-cap-concat-strip" ref="sliderEl">
									<image class="lh-cap-concat-img" :src="backgroundImage" mode="scaleToFill" />
									<image class="lh-cap-concat-img" :src="backgroundImage" mode="scaleToFill" />
								</view>
							</view>
							<view v-else-if="type === 'ROTATE'" key="rotate" class="lh-cap-rotate-box">
								<image class="lh-cap-rotate-img" ref="sliderEl" :style="{ width: (pieceWidth || 180) + 'px' }"
									:src="sliderImage" mode="scaleToFill" @load="onPieceLoad" />
							</view>
							<view v-else-if="type === 'SLIDER'" key="slider" class="lh-cap-slider" ref="sliderEl">
								<image class="lh-cap-slider-img" :style="{ width: (pieceWidth || 180) + 'px' }"
									:src="sliderImage" mode="scaleToFill" @load="onPieceLoad" />
							</view>
							<!-- 结果横条：仅点选（无轨道）沿用图片底部滑入形态 -->
							<view v-if="showResult && type === 'WORD_IMAGE_CLICK'" class="lh-cap-status"
								:class="resultOk ? 'lh-cap-status-ok' : 'lh-cap-status-no'">
								<text class="lh-cap-status-text">{{ resultMsg }}</text>
							</view>
							<!-- 点选蒙层：touchend 取坐标（click 事件无可靠坐标） -->
							<view v-if="type === 'WORD_IMAGE_CLICK'" id="lh-cap-click-mask" class="lh-cap-click-mask" @touchend="onMaskTap">
								<view v-for="(item, index) in trackArr" :key="index" class="lh-cap-click-dot"
									:style="{ left: item.x - 13 + 'px', top: item.y - 13 + 'px', backgroundColor: capTheme || '' }">
									<text class="lh-cap-click-dot-text">{{ index + 1 }}</text>
								</view>
							</view>
						</view>
						<view v-if="type !== 'WORD_IMAGE_CLICK'" class="lh-cap-track">
							<text class="lh-cap-track-text">{{ verifying ? '正在验证...' : '向右拖动完成验证' }}</text>
							<!-- 结果彩带：从左向右铺满轨道，文案铺满后淡入 -->
							<view v-if="showResult" class="lh-cap-ribbon" :class="resultOk ? 'lh-cap-ribbon-ok' : 'lh-cap-ribbon-no'">
								<text class="lh-cap-ribbon-text">{{ resultMsg }}</text>
							</view>
							<view class="lh-cap-unit" ref="dragUnitEl" @touchstart="onDragStart"
								@touchmove="onDragMove" @touchend="onDragEnd" @touchcancel="onDragCancel">
								<view v-if="!showResult" class="lh-cap-unit-fill" :style="themeBg"></view>
								<!-- 结果期彩带铺满轨道，滑块随之隐藏 -->
								<view v-if="!showResult" class="lh-cap-unit-thumb" :style="themeBg">
									<view v-if="verifying" class="lh-cap-thumb-spinner"></view>
									<uni-icons v-else class="lh-cap-unit-thumb-icon" type="arrow-right" />
								</view>
							</view>
						</view>
					</view>
				</view>

				<!-- 校验期间透明阻断层 -->
				<view v-if="verifying" class="lh-cap-freeze" @touchmove="onFreezeTouchMove"></view>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	// 验证码组件：业务页直接挂载，<Captcha ref @success> + captchaRef.open()，四端同一条路径。
	// 压暗交给 app-mask（页面内层 + 导航栏/tabBar 原生条带）；本组件只出全屏浮层与卡片。
	import { getCaptchaData, check } from '@/api/system/captcha/captcha'
	import { solvePow } from './pow/index'

	import type { CaptchaRequestData, CaptchaResponseData } from '@/api/system/captcha/type/captcha-type'
	import { useThemeStore } from '@/stores/theme'
	import AppMask from '@/components/app-mask/app-mask.uvue'

	type TrackItem = { x : number, y : number, type : string, t : number }

	const props = defineProps<{
		// 主题色覆盖双值（css color）：亮色态/暗色态各一，缺省该态回落全局 token var(--std-primary)
		themeLight ?: string
		themeDark ?: string
	}>()

	// 主题覆盖当前值：按亮暗取对应 prop，未传回落空串（class 内 token 接管）
	const themeStore = useThemeStore()
	themeStore.init()
	const capTheme = computed(() : string => {
		return themeStore.isDark ? (props.themeDark ?? '') : (props.themeLight ?? '')
	})
	// 对象语法 style 绑定
	const themeBg = computed(() : any => capTheme.value ? { backgroundColor: capTheme.value } : {})

	const emit = defineEmits<{
		(e : 'success', id : string) : void
	}>()

	// 布局常量（提交后端的轨迹坐标系同源）：卡片 320、内容 288、图区高 180、轨道/滑块钮 40
	const CARD_PADDING = 16
	const CARD_WIDTH = 320
	const CONTENT_WIDTH = CARD_WIDTH - CARD_PADDING * 2
	const IMAGE_HEIGHT = 180
	const THUMB_SIZE = 40
	const DRAG_END = CONTENT_WIDTH - THUMB_SIZE

	const visible = ref<boolean>(false)
	// 内容容器（pow/graphic 二选一存在）：滑切位移 setProperty 直驱用
	const contentEl = ref<any>(null)
	// 进场态：初始即起点，class 切换过渡
	const entered = ref<boolean>(false)
	// POW↔图形高度动画 class（a/b 交替，见 getCaptcha），并入 sizeClass 输出
	const heightAnim = ref<string>('')
	const heightFlip = ref<boolean>(false)
	// 刷新切换相位：out=旧内容右滑出，waiting=滑出完成等响应（loading 唯一显示窗），
	// in=新容器（:key 重建）首帧停左侧待滑入
	const slidePhase = ref<'idle' | 'out' | 'waiting' | 'in'>('idle')
	// 滑入动画放行标志：容器渲染稳定后再挂动画 class
	const contentAnim = ref<boolean>(false)
	// 按钮扣住标志：滑切/打开全程扣住，滑入动画播完（sleep 300 后）放行——按钮与滑入完成同步现身
	const optsHold = ref<boolean>(false)
	const captchaLoading = ref<boolean>(false)
	const loadingError = ref<string>()
	const type = ref<CaptchaResponseData['type']>()
	const captchaId = ref<string>('')
	const backgroundImage = ref<string>('')
	const sliderImage = ref<string>('')
	const powParam = ref<number[]>()
	const concatHeight = ref<number>(0)
	// 图块渲染宽（高恒 180，宽按原图比例计算）
	const pieceWidth = ref<number>(0)

	const startTime = ref<number>(0)
	const stopTime = ref<number>(0)
	const trackArr = ref<TrackItem[]>([])
	const clickCount = ref<number>(0)
	const maskRect = { left : 0, top : 0 }

	const dragX = ref<number>(0)
	const powX = ref<number>(0)
	const dragging = ref<boolean>(false)
	const powPhase = ref<'slide' | 'mining' | 'success' | 'fail'>('slide')
	const powFailMsg = ref<string>('验证失败，请重试')
	// 挖矿进度（onProgress 百分比）与超时显示标志：>1s 才在「正在验证...」后追加括号进度
	const powProgress = ref<number>(0)
	const powShowProgress = ref<boolean>(false)
	const powSuccessMsg = ref<string>('验证成功')

	const showResult = ref<boolean>(false)
	const resultOk = ref<boolean>(false)
	const resultMsg = ref<string>('')
	const verifying = ref<boolean>(false)

	let verifyTimer : ReturnType<typeof setTimeout> | undefined
	let cancelPowMining : (() => void) | undefined

	// 所属页面实例：挂载期缓存，点选题量测取蒙层元素用
	let ownerPage : any = null
	// 微信端：挂载期缓存的组件实例，量测用
	let ownerInstance : any = null

	const clamp = (v : number, min : number, max : number) : number => v < min ? min : v > max ? max : v

	const sleep = (ms : number) : Promise<void> => new Promise(resolve => setTimeout(resolve, ms))

	// 图块宽度兜底：响应缺 templateImageWidth/Height 时（部分类型不返回），用加载后自然比例算
	const onPieceLoad = (e : ImageLoadEvent) => {
		if (pieceWidth.value > 0) {
			return
		}
		const d = e.detail
		if (d && d.width > 0 && d.height > 0) {
			pieceWidth.value = Math.round(IMAGE_HEIGHT * d.width / d.height)
		}
	}

	// ---------- 打开 / 关闭 ----------

	// 打开：已打开则忽略；收起键盘后渲染出起点态（浮层透明/卡片缩小），下一拍再切进场态触发过渡
	const open = () => {
		if (visible.value) {
			return
		}
		// uni.hideKeyboard 属内置模块 uni-keyboard：旧自定义基座未编入时抛错，此时键盘不自动收起，不阻断打开
		try {
			uni.hideKeyboard()
		} catch (err) {
			console.warn('uni.hideKeyboard 不可用：需重打含 uni-keyboard 模块的自定义基座')
		}
		visible.value = true
		nextTick(() => {
			entered.value = true
		})
		getCaptcha()
	}

	const close = (emitId ?: string) => {
		stopJobs()
		if (emitId !== undefined) {
			emit('success', emitId)
		}
		visible.value = false
		resetState()
	}

	const resetState = () => {
		entered.value = false
		slidePhase.value = 'idle'
		contentAnim.value = false
		optsHold.value = false
		heightAnim.value = ''
		type.value = undefined
		captchaId.value = ''
		trackArr.value = []
		clickCount.value = 0
		dragX.value = 0
		powX.value = 0
		showResult.value = false
		verifying.value = false
		powPhase.value = 'slide'
		loadingError.value = undefined
	}

	const stopJobs = () => {
		if (verifyTimer !== undefined) {
			clearTimeout(verifyTimer)
			verifyTimer = undefined
		}
		cancelPowMining?.()
		cancelPowMining = undefined
	}

	// ---------- 取码 ----------

	// slide=true 走滑切流：旧内容右滑出与请求并行 → 换数据（:key 重建容器）→ 新内容从左滑入
	const getCaptcha = async (slide : boolean = false) => {
		const prevHeight = (captchaLoading.value || loadingError.value) ? 298 : (type.value === 'POW' ? 136 : 298)
		optsHold.value = true
		if (slide) {
			slidePhase.value = 'out'
			// #ifndef MP-WEIXIN
			// 滑出直驱（class 切换驱动的 transform 过渡在 Vapor 端跳变）
			contentEl.value?.style.setProperty('transform', 'translateX(288px)')
			// #endif
			// 新容器以无动画 class 出生（渲染稳定后滑切尾再放行）
			contentAnim.value = false
		} else {
			captchaLoading.value = true
		}
		loadingError.value = undefined
		try {
			const job = getCaptchaData()
			let resp
			if (slide) {
				// 滑出动画（300ms）与请求竞速：响应先到=无 loading；滑出先完成=waiting 相位显示 loading
				const slideDone = sleep(300)
				const first = await Promise.race([job.then(() => 'job'), slideDone.then(() => 'slide')])
				if (first === 'slide') {
					slidePhase.value = 'waiting'
					await slideDone
				} else {
					await slideDone
				}
				resp = await job
			} else {
				resp = await job
			}
			if (resp.code !== 200 || !resp.data) {
				throw new Error(`code=${resp.code}`)
			}
			const d = resp.data
			// POW↔图形跨高：高度动画在空窗期独占播放（a/b 交替 class），播完摘除；滑入期间 card 须无活跃 animation
			const targetHeight = (d.type === 'POW') ? 136 : 298
			const crossHeight = slide && targetHeight !== prevHeight
			if (crossHeight) {
				heightFlip.value = !heightFlip.value
				heightAnim.value = targetHeight > prevHeight
					? (heightFlip.value ? 'lh-cap-h-grow-a' : 'lh-cap-h-grow-b')
					: (heightFlip.value ? 'lh-cap-h-shrink-a' : 'lh-cap-h-shrink-b')
				await sleep(120)
			}
			// 赋值前切 in：容器首渲染即 prep 左外态，统一左滑入场
			slidePhase.value = 'in'
			type.value = d.type
			if (crossHeight) {
				await nextTick()
				heightAnim.value = ''
			}
			captchaId.value = d.id
			backgroundImage.value = d.backgroundImage ?? ''
			sliderImage.value = d.templateImage ?? ''
			powParam.value = d.type === 'POW' ? d.data?.POW : undefined
			// CONCAT 窗口高 =（原图高 - randomY）/ 原图高 × 图区高
			if (d.type === 'CONCAT' && d.backgroundImageHeight && d.data?.randomY != null) {
				concatHeight.value = Math.round((d.backgroundImageHeight - d.data.randomY) / d.backgroundImageHeight * IMAGE_HEIGHT)
			} else {
				concatHeight.value = 0
			}
			pieceWidth.value = d.templateImageWidth && d.templateImageHeight
				? Math.round(IMAGE_HEIGHT * d.templateImageWidth / d.templateImageHeight) : 0
			startTime.value = Date.now()
			trackArr.value = []
			clickCount.value = 0
			dragX.value = 0
			powX.value = 0
			powPhase.value = 'slide'
			powProgress.value = 0
			powShowProgress.value = false
			showResult.value = false
			resultOk.value = false
			resultMsg.value = ''
			powFailMsg.value = '验证失败，请重试'
			verifying.value = false
		} catch (err) {
			console.error('验证码取码失败', err)
			loadingError.value = '验证码加载失败'
		} finally {
			captchaLoading.value = false
		}
		// 同类型刷新时轨道节点不重建，直驱位移显式归位
		resetVisual()
		if (slide) {
			// 失败直接回 idle 露错误态（error 分支替换容器，无过渡残留）
			if (loadingError.value) {
				slidePhase.value = 'idle'
				return
			}
			// 滑入：容器以静态起点渲染稳定后，再挂动画 class 播放；idle 沿用不摘（forwards 终态 0）。勿换 requestAnimationFrame
			// #ifndef MP-WEIXIN
			await nextTick()
			await sleep(32)
			contentAnim.value = true
			// #endif
			slidePhase.value = 'idle'
			await sleep(300)
			optsHold.value = false
			// 点选：滑入静止后量蒙层（动画中量绝对坐标带偏移必错）
			if (type.value === 'WORD_IMAGE_CLICK') {
				await nextTick()
				await measureMask()
			}
			return
		}
		// 打开流：内容左滑入场，静止后补点选量测
		if (!loadingError.value) {
			// 滑入：容器以静态起点渲染稳定后，再挂动画 class 播放；idle 沿用不摘（forwards 终态 0）。勿换 requestAnimationFrame
			// #ifndef MP-WEIXIN
			await nextTick()
			await sleep(32)
			contentAnim.value = true
			// #endif
			slidePhase.value = 'idle'
			await sleep(300)
			optsHold.value = false
		}
		// 点选：内容渲染完成后量蒙层绝对位置（轨迹换算基准），失败按 0 兜底（轨迹偏移可容忍一次刷新）
		if (!loadingError.value && type.value === 'WORD_IMAGE_CLICK') {
			await nextTick()
			await measureMask()
		}
	}

	const measureMask = () : Promise<void> => {
		return new Promise(resolve => {
			// App/Web 经缓存的页面实例 getElementById 取；微信端回退 selectorQuery
			const el = ownerPage?.getElementById('lh-cap-click-mask')
			if (el) {
				// Async 版跨端（MP 端无同步 getBoundingClientRect）
				el.getBoundingClientRectAsync().then((rect : any) => {
					maskRect.left = rect.left
					maskRect.top = rect.top
					resolve()
				})
				return
			}
			uni.createSelectorQuery().in(ownerInstance ?? getCurrentInstance()?.proxy).select('.lh-cap-click-mask').boundingClientRect().exec(ret => {
				const r = ret[0] as { left : number, top : number } | null
				if (r) {
					maskRect.left = r.left
					maskRect.top = r.top
				}
				resolve()
			})
		})
	}

	// 遮罩/阻断层滚动拦截（x 端 touch 修饰符不可靠，须回调内手动调用）
	const onMaskTouchMove = (e : TouchEvent) => {
		e.stopPropagation()
		e.preventDefault()
	}

	const onFreezeTouchMove = (e : TouchEvent) => {
		e.stopPropagation()
		e.preventDefault()
	}

	// ---------- 拖动直驱 ----------
	// 蒸汽端 :style 响应式链路逐帧更新滞后，位移经元素引用 setProperty 直驱；
	// 色带+圆钮为一体元素（单元素单次 setProperty），transition 的摘除/恢复同样直驱
	const powUnitEl = ref<UniElement | null>(null)
	const dragUnitEl = ref<UniElement | null>(null)
	const sliderEl = ref<UniElement | null>(null)

	// identifier 跟踪：多指下锁定拖动起始指
	let dragTouchId = -1
	const findTouchByIdentifier = (touches : Touch[], identifier : number) : Touch | null => {
		for (let i = 0; i < touches.length; i++) {
			if (touches[i].identifier == identifier) {
				return touches[i]
			}
		}
		return null
	}

	const unitEl = () : UniElement | null => type.value === 'POW' ? powUnitEl.value : dragUnitEl.value

	// 一体元素位移 = 拖动量 - 内容宽（色带段 288 在轨道外，thumb 落位 x）；图形类拼图块联动
	const driveVisual = (x : number) => {
		unitEl()?.style?.setProperty('transform', `translateX(${x - CONTENT_WIDTH}px)`)
		if (type.value === 'SLIDER') {
			sliderEl.value?.style?.setProperty('transform', `translateX(${x}px)`)
		} else if (type.value === 'ROTATE') {
			const angle = x / (DRAG_END / 360)
			sliderEl.value?.style?.setProperty('transform', `rotate(${angle}deg)`)
		} else if (type.value === 'CONCAT') {
			sliderEl.value?.style?.setProperty('transform', `translateX(${x - CONTENT_WIDTH}px)`)
		}
	}

	// 拖动开始：摘过渡（直驱，不经 class patch）
	const disableUnitTransition = () => {
		unitEl()?.style?.setProperty('transition', 'none')
	}

	// 松手回弹：恢复过渡后直驱归零（连续 setProperty 按序生效）
	const springBack = () => {
		const el = unitEl()
		if (el) {
			el.style.setProperty('transition', 'transform 200ms ease')
			el.style.setProperty('transform', `translateX(${-CONTENT_WIDTH}px)`)
		}
		powX.value = 0
		dragX.value = 0
	}

	// 同类型刷新时轨道节点不重建，直驱位移显式归位（瞬时，无动画）
	const resetVisual = () => {
		nextTick(() => {
			powUnitEl.value?.style?.setProperty('transition', 'none')
			powUnitEl.value?.style?.setProperty('transform', `translateX(${-CONTENT_WIDTH}px)`)
			dragUnitEl.value?.style?.setProperty('transition', 'none')
			dragUnitEl.value?.style?.setProperty('transform', `translateX(${-CONTENT_WIDTH}px)`)
			if (type.value === 'ROTATE') {
				sliderEl.value?.style?.setProperty('transform', 'rotate(0deg)')
			} else if (type.value === 'CONCAT') {
				sliderEl.value?.style?.setProperty('transform', `translateX(${-CONTENT_WIDTH}px)`)
			} else {
				sliderEl.value?.style?.setProperty('transform', 'translateX(0px)')
			}
		})
	}

	// ---------- POW：滑动触发挖矿 ----------

	let powStartX = 0
	const onPowTouchStart = (e : TouchEvent) => {
		if (powPhase.value !== 'slide') {
			return
		}
		const startTouch = e.changedTouches.length > 0 ? e.changedTouches[0] : e.touches[0]
		if (startTouch == null) {
			return
		}
		dragging.value = true
		dragTouchId = startTouch.identifier
		powStartX = startTouch.screenX
		disableUnitTransition()
	}
	const onPowTouchMove = (e : TouchEvent) => {
		if (!dragging.value) {
			return
		}
		const p = findTouchByIdentifier(e.changedTouches, dragTouchId) ?? findTouchByIdentifier(e.touches, dragTouchId)
		if (p == null) {
			return
		}
		powX.value = clamp(p.screenX - powStartX, 0, DRAG_END)
		driveVisual(powX.value)
	}
	const onPowTouchEnd = () => {
		if (!dragging.value) {
			return
		}
		dragging.value = false
		if (powX.value >= DRAG_END) {
			startPowMining()
		} else {
			springBack()
		}
	}

	// 系统打断（来电/手势冲突）：纯回弹，不触发挖矿/校验
	const onPowTouchCancel = () => {
		if (dragging.value) {
			dragging.value = false
			springBack()
		}
	}

	// 滑到最右才触发计算（滑动为纯前端感知层，后端只校验 nonce）
	const startPowMining = async () => {
		const id = captchaId.value
		const param = powParam.value
		if (!id || !param) {
			loadingError.value = '验证码配置缺失'
			return
		}
		powPhase.value = 'mining'
		startTime.value = Date.now()
		// 挖矿超 1s 才显示进度括号（快路径零打扰）；timer 走 verifyTimer 由 stopJobs 统一清理
		verifyTimer = setTimeout(() => {
			verifyTimer = undefined
			powShowProgress.value = true
		}, 1000)
		try {
			const handle = solvePow(id, param, (solved, total) => {
				powProgress.value = Math.round(solved / total * 100)
			})
			cancelPowMining = handle.cancel
			const customData = await handle.result
			cancelPowMining = undefined
			// 快路径（<1s）时超时显示 timer 尚未触发，先清防与结果倒计时互覆
			if (verifyTimer !== undefined) {
				clearTimeout(verifyTimer)
				verifyTimer = undefined
			}
			// 空解=取消；代际不符=已刷新换码，丢弃过期解
			if (!customData || captchaId.value !== id) {
				return
			}
			stopTime.value = Date.now()
			submitCaptcha(id, {
				bgImageWidth : CONTENT_WIDTH,
				bgImageHeight : IMAGE_HEIGHT,
				startTime : startTime.value,
				stopTime : stopTime.value,
				trackList : [{ x : 0, y : 0, type : '', t : 0 }],
				data : customData
			}, stopTime.value - startTime.value, true)
		} catch (err) {
			console.error(err)
			cancelPowMining = undefined
			if (captchaId.value === id) {
				refresh(false)
			}
		}
	}

	// ---------- 图形类：拖动 / 点选 ----------

	let dragStartX = 0
	const onDragStart = (e : TouchEvent) => {
		const startTouch = e.changedTouches.length > 0 ? e.changedTouches[0] : e.touches[0]
		if (startTouch == null) {
			return
		}
		dragging.value = true
		dragTouchId = startTouch.identifier
		dragStartX = startTouch.screenX
		disableUnitTransition()
		startTime.value = Date.now()
		trackArr.value.push({ x : 0, y : 0, type : 'down', t : 0 })
	}
	const onDragMove = (e : TouchEvent) => {
		if (!dragging.value) {
			return
		}
		const p = findTouchByIdentifier(e.changedTouches, dragTouchId) ?? findTouchByIdentifier(e.touches, dragTouchId)
		if (p == null) {
			return
		}
		dragX.value = clamp(p.screenX - dragStartX, 0, DRAG_END)
		driveVisual(dragX.value)
		trackArr.value.push({ x : dragX.value, y : 0, type : 'move', t : Date.now() - startTime.value })
	}
	const onDragEnd = () => {
		if (!dragging.value) {
			return
		}
		dragging.value = false
		stopTime.value = Date.now()
		trackArr.value.push({ x : dragX.value, y : 0, type : 'up', t : stopTime.value - startTime.value })
		verifyGraphic()
	}

	// 系统打断：纯回弹，不记录 up 轨迹不提交
	const onDragCancel = () => {
		if (dragging.value) {
			dragging.value = false
			springBack()
		}
	}

	// 点选：坐标换算到图片容器系（蒙层位置打开时量测）
	const onMaskTap = (e : TouchEvent) => {
		e.stopPropagation()
		const point = e.changedTouches[0]
		if (!point) {
			return
		}
		if (clickCount.value === 0) {
			startTime.value = Date.now()
		}
		clickCount.value++
		if (clickCount.value > 4) {
			return
		}
		stopTime.value = Date.now()
		trackArr.value.push({
			x : Math.round(point.clientX - maskRect.left),
			y : Math.round(point.clientY - maskRect.top),
			type : 'click',
			t : stopTime.value - startTime.value
		})
		if (clickCount.value === 4) {
			verifyGraphic()
		}
	}

	const verifyGraphic = () => {
		const id = captchaId.value
		if (!id) {
			return
		}
		// 旋转以拖满量程为分母（与显示角度同坐标系），其余类型以背景宽为分母
		const bgWidth = type.value === 'ROTATE' ? DRAG_END : CONTENT_WIDTH
		submitCaptcha(id, {
			bgImageWidth : bgWidth,
			bgImageHeight : IMAGE_HEIGHT,
			startTime : startTime.value,
			stopTime : stopTime.value,
			trackList : trackArr.value
		}, stopTime.value - startTime.value, false)
	}

	// ---------- 提交与结果编排 ----------

	const submitCaptcha = (id : string, data : CaptchaRequestData['data'], durationMs : number, isPow : boolean) => {
		verifying.value = true
		check({ id, data }).then(resp => {
			if (resp.code === 200 && resp.success) {
				if (isPow) {
					powSuccessMsg.value = `验证成功，耗时${(durationMs / 1000).toFixed(1)}秒`
					powPhase.value = 'success'
					// 填充 400ms + 驻留 1000ms 后关闭
					verifyTimer = setTimeout(() => {
						verifyTimer = undefined
						close(resp.data?.id ?? id)
					}, 1400)
				} else {
					showResult.value = true
					resultOk.value = true
					resultMsg.value = `验证成功，耗时${(durationMs / 1000).toFixed(1)}秒`
					verifyTimer = setTimeout(() => {
						verifyTimer = undefined
						close(resp.data?.id ?? id)
					}, 1000)
				}
			} else {
				const msg = resp.code === 4001 ? '验证失败，请重新尝试！' : resp.code === 4000 ? '验证码被黑洞吸走了！' : resp.msg
				if (isPow) {
					powFailMsg.value = msg ?? '验证失败，请重试'
					powPhase.value = 'fail'
					verifyTimer = setTimeout(() => {
						verifyTimer = undefined
						refresh(false)
					}, 1600)
				} else {
					showResult.value = true
					resultOk.value = false
					resultMsg.value = msg ?? '验证失败'
					verifyTimer = setTimeout(() => {
						verifyTimer = undefined
						refresh(false)
					}, 750)
				}
			}
		}).catch(err => {
			console.error(err)
			verifying.value = false
			refresh(false)
		})
	}

	const refresh = (isClose : boolean) => {
		stopJobs()
		verifying.value = false
		// 视觉态不清：失败红态保持滑出，由 getCaptcha 换码赋值段统一清；
		// 切换动画进行中不重入；已有内容时走滑切流，首开/错误重试走全卡 loading
		if (!isClose && !captchaLoading.value && slidePhase.value === 'idle') {
			getCaptcha(type.value !== undefined && !loadingError.value)
		}
	}

	// ---------- 视图派生 ----------

	const sizeClass = computed(() : string => {
		let cls = ''
		if (captchaLoading.value || loadingError.value) {
			cls = 'lh-cap-card--loading'
		} else {
			cls = type.value === 'POW' ? 'lh-cap-card--pow' : 'lh-cap-card--graphic'
		}
		if (entered.value) {
			cls += ' lh-cap-card--in'
		}
		if (heightAnim.value) {
			cls += ' ' + heightAnim.value
		}
		return cls
	})

	const optsVisible = computed(() : boolean => !captchaLoading.value && !loadingError.value && slidePhase.value === 'idle' && !optsHold.value)

	// POW 轨道文案：待滑/挖矿（超 1s 追加括号进度）/结果（文案已由彩带层接管，此层不显示）
	const powTrackText = computed(() : string => {
		if (powPhase.value === 'slide') {
			return '按住滑块，拖到最右'
		}
		if (powPhase.value === 'mining' && powShowProgress.value) {
			return `正在验证...（${powProgress.value}%）`
		}
		return '正在验证...'
	})

	// 微信端滑切位移：keyframes class 驱动（声明即播）；idle 沿用 mp-in；App/Web 恒空串走 setProperty 直驱
	const slideStyleMp = computed(() : string => {
		// #ifdef MP-WEIXIN
		// out+waiting=mp-out；in+idle=mp-in（idle 须沿用 mp-in，勿翻转语义）
		if (slidePhase.value === 'out' || slidePhase.value === 'waiting') {
			return 'lh-cap-mp-out'
		}
		return 'lh-cap-mp-in'
		// #endif
		// #ifndef MP-WEIXIN
		// App：滑入 keyframes（from -288=静态起点）；动画 class 由 contentAnim 延后挂载；idle/滑切全程沿用不摘
		if (slidePhase.value === 'out' || slidePhase.value === 'waiting') {
			return ''
		}
		return contentAnim.value ? 'lh-cap-slide-in' : ''
		// #endif
	})

	// ---------- 生命周期 ----------

	onMounted(() => {
		// #ifdef APP || WEB
		ownerPage = getCurrentInstance()?.proxy?.$page ?? null
		// #endif
		// #ifdef MP-WEIXIN
		// 组件挂业务页：缓存组件实例供量测
		ownerInstance = getCurrentInstance()?.proxy ?? null
		// #endif
	})

	onUnmounted(() => {
		stopJobs()
	})

	defineExpose({ open, close })
</script>

<style lang="scss">
	/* 按压类（styles/press.scss） */
	@import '@/styles/press.scss';

	/* 全屏浮层：拦截触摸、居中卡片；压暗交给 app-mask，本层不画背景 */
	.lh-cap-mask {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1000;
		justify-content: center;
		align-items: center;
		opacity: 0;
		transition: opacity 200ms ease-out;
	}

	.lh-cap-mask--in {
		opacity: 1;
	}

	.lh-cap-card {
		position: relative;
		width: 320px;
		border-radius: var(--std-radius);
		background-color: var(--std-emphasis-bg);
		/* 浮层软影 */
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
		padding: var(--std-gap-lg);
		overflow: hidden;
		transform: scale(0.92);
		transition: height 300ms ease, transform 250ms ease-out;
	}

	.lh-cap-card--in {
		transform: scale(1);
	}

	.lh-cap-card--loading {
		height: 298px;
	}

	.lh-cap-card--graphic {
		height: 298px;
	}

	.lh-cap-card--pow {
		height: 136px;
	}

	/* POW↔图形高度过渡：keyframes 显式起止，a/b 双 class 交替保证每次必变；播完摘除 */
	.lh-cap-h-shrink-a {
		animation: lh-cap-h-shrink-a 100ms ease forwards;
	}

	.lh-cap-h-shrink-b {
		animation: lh-cap-h-shrink-b 100ms ease forwards;
	}

	.lh-cap-h-grow-a {
		animation: lh-cap-h-grow-a 100ms ease forwards;
	}

	.lh-cap-h-grow-b {
		animation: lh-cap-h-grow-b 100ms ease forwards;
	}

	@keyframes lh-cap-h-shrink-a {
		from {
			height: 298px;
		}

		to {
			height: 136px;
		}
	}

	@keyframes lh-cap-h-shrink-b {
		from {
			height: 298px;
		}

		to {
			height: 136px;
		}
	}

	@keyframes lh-cap-h-grow-a {
		from {
			height: 136px;
		}

		to {
			height: 298px;
		}
	}

	@keyframes lh-cap-h-grow-b {
		from {
			height: 136px;
		}

		to {
			height: 298px;
		}
	}

	/* 右上操作区：显式置顶（高于阻断层 z10），校验期间刷新/关闭仍可点 */
	.lh-cap-opts {
		position: absolute;
		/* 36px 热区盒中心与 title 行中心对齐；icon 距卡片右缘 16px */
		top: 8px;
		right: 4px;
		z-index: 20;
		flex-direction: row;
		align-items: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 200ms ease;
	}

	.lh-cap-opts--show {
		opacity: 1;
		pointer-events: auto;
	}

	/* App/Web 滑入：keyframes 插入即播（from 与静态 style 起点一致） */
	.lh-cap-slide-in {
		animation: lh-cap-slide-in 300ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	@keyframes lh-cap-slide-in {
		from {
			transform: translateX(-288px);
		}

		to {
			transform: translateX(0);
		}
	}

	/* #ifdef MP-WEIXIN */
	/* 微信端滑切位移：keyframes 声明即播（见 slideStyleMp）；from=静态起点，forwards 保终态 */
	.lh-cap-mp-out {
		animation: lh-cap-mp-out 300ms ease-out forwards;
	}

	.lh-cap-mp-in {
		animation: lh-cap-mp-in 300ms ease-out forwards;
	}

	@keyframes lh-cap-mp-out {
		from {
			transform: translateX(0);
		}

		to {
			transform: translateX(288px);
		}
	}

	@keyframes lh-cap-mp-in {
		from {
			transform: translateX(-288px);
		}

		to {
			transform: translateX(0);
		}
	}
	/* #endif */

	/* 点击热区容器（icon 本体不带事件） */
	.lh-cap-opts-btn {
		width: 36px;
		height: 36px;
		/* uvue view 默认 flex-direction: column，水平偏移须显式 row */
		flex-direction: row;
		align-items: center;
		/* 热区紧贴零死区；icon 非对称居中：刷新钮偏右 4px、关闭钮偏左 4px（--end） */
		justify-content: flex-end;
		padding-right: var(--std-gap-xs);
	}

	.lh-cap-opts-btn--end {
		justify-content: flex-start;
		padding-left: var(--std-gap-xs);
		padding-right: 0;
	}

	.lh-cap-opts-icon {
		font-size: 20px;
		color: var(--std-fourth-color);
	}

	/* 中央区（loading / POW 结果） */
	.lh-cap-zone {
		flex: 1;
		justify-content: center;
		align-items: center;
	}

	.lh-cap-zone-text {
		margin-top: var(--std-gap-sm);
		font-size: 14px;
		color: var(--std-secondary-color);
	}

	.lh-cap-error {
		flex: 1;
		justify-content: center;
		align-items: center;
	}

	.lh-cap-error-text {
		font-size: 14px;
		color: #f56c6c;
	}

	.lh-cap-spinner {
		width: 24px;
		height: 24px;
		border: 2px solid var(--std-active-bg);
		border-top-color: var(--std-primary);
		border-radius: 50%;
		animation: lh-cap-rotate 0.8s linear infinite;
	}

	@keyframes lh-cap-rotate {
		to {
			transform: rotate(360deg);
		}
	}

	/* POW */
	/* 内容裁切层：padding 内缘裁切，层级高于切换 loading(z1) */
	.lh-cap-clip {
		flex: 1;
		position: relative;
		z-index: 2;
		overflow: hidden;
	}

	.lh-cap-pow {
		flex: 1;
		transition: transform 300ms ease-out;
	}

	/* 轨道结果彩带：从左向右铺满，文案铺满后淡入；右端 20px 圆头与轨道右端圆弧贴合 */
	.lh-cap-ribbon {
		position: absolute;
		top: 0;
		left: 0;
		height: 40px;
		width: 0;
		border-radius: 0 20px 20px 0;
		justify-content: center;
		align-items: center;
		animation: lh-cap-ribbon 250ms ease-out forwards;
	}

	.lh-cap-ribbon-ok {
		background-color: #5ac725;
	}

	.lh-cap-ribbon-no {
		background-color: #f56c6c;
	}

	.lh-cap-ribbon-text {
		font-size: var(--std-text-sm);
		color: #ffffff;
		opacity: 0;
		animation: lh-cap-ribbon-text 300ms ease 250ms forwards;
	}

	@keyframes lh-cap-ribbon {
		from {
			width: 0;
		}

		to {
			width: 288px;
		}
	}

	@keyframes lh-cap-ribbon-text {
		to {
			opacity: 1;
		}
	}

	/* 滑块钮验证态：挖矿中白圈 spinner（结果期滑块整体隐藏，见 template） */
	.lh-cap-thumb-spinner {
		width: 20px;
		height: 20px;
		border: 2px solid rgba(255, 255, 255, 0.35);
		border-top-color: #ffffff;
		border-radius: 50%;
		animation: lh-cap-rotate 0.8s linear infinite;
	}

	/* 图形类 */
	.lh-cap-graphic {
		flex: 1;
		transition: transform 300ms ease-out;
	}

	/* 刷新滑切：位移全程 setProperty 直驱+transition；起点=容器静态 style 属性 -288 */

	/* 层级（低→高）：卡片背景 < 切换 loading(z1) < 验证码内容模块(z2)——滑出/滑入的内容从 loading 上层划过 */
	.lh-cap-switch-loading {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		flex-direction: column;
		z-index: 1;
		justify-content: center;
		align-items: center;
		z-index: 15;
	}

	.lh-cap-tip {
		font-size: 15px;
		font-weight: bold;
		color: var(--std-secondary-color);
		/* 上与左右=padding 16，下 12（内容总高不变） */
		margin: 0 0 var(--std-gap-md) var(--std-gap-xs);
	}

	.lh-cap-click-tips {
		flex-direction: row;
		align-items: center;
		margin-bottom: var(--std-gap-sm);
