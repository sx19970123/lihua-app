		top: 0;
		left: 0;
		width: 288px;
		overflow: hidden;
	}

	/* 平铺条：双图并排首尾相接，translateX(x-288) 滚动 */
	.lh-cap-concat-strip {
		flex-direction: row;
		width: 576px;
		height: 180px;
		transform: translateX(-288px);
	}

	.lh-cap-concat-img {
		width: 288px;
		height: 180px;
	}

	/* SLIDER 拼图块：absolute 左起，高 180 宽自然（heightFix），拖动 translateX 驱动 */
	.lh-cap-slider {
		position: absolute;
		top: 0;
		left: 0;
		height: 180px;
	}

	.lh-cap-slider-img {
		height: 180px;
	}

	/* ROTATE 圆盘：容器铺满图片区双向居中，rotate 绕背景缺口中心 */
	.lh-cap-rotate-box {
		position: absolute;
		top: 0;
		left: 0;
		width: 288px;
		height: 180px;
		justify-content: center;
		align-items: center;
	}

	.lh-cap-rotate-img {
		height: 180px;
	}



	/* 结果横条（图形类，图片区底部）：层级高于点选序号/蒙层与阻断层；自然态=上滑动画起点 */
	.lh-cap-status {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 288px;
		height: 24px;
		justify-content: center;
		align-items: center;
		z-index: 11;
		transform: translateY(24px);
		animation: lh-cap-status-up 200ms ease-out forwards;
	}

	@keyframes lh-cap-status-up {
