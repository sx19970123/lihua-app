<template>
	<view class="lh-cap">
		<!-- 遮罩与浮层同父兄弟、同为 fixed，层序靠显式 z-index（浮层高于 app-mask 的 999） -->
		<app-mask :visible="visible" @backpress="close()" />
		<view v-if="visible" class="lh-cap-mask" :class="{ 'lh-cap-mask--in': entered }" @touchmove="onMaskTouchMove">
			<view class="lh-cap-card" :class="sizeClass">
				<!-- 右上操作区：App/Web 常驻节点 opacity 过渡淡入淡出；微信端 v-if 挂卸 -->
				<!-- 点击挂外层 view（uni-icons 的 click 转发在微信端不可靠） -->
				<!-- #ifndef MP-WEIXIN -->
				<view class="lh-cap-opts" :class="{ 'lh-cap-opts--show': optsVisible }">
					<view class="lh-cap-opts-btn" hover-class="app-pressed-text" :hover-stay-time="100"
						@click="refresh(false)">
						<uni-icons class="lh-cap-opts-icon" type="refreshempty" />
					</view>
					<view class="lh-cap-opts-btn lh-cap-opts-btn--end" hover-class="app-pressed-text" :hover-stay-time="100"
						@click="close()">
						<uni-icons class="lh-cap-opts-icon" type="closeempty" />
					</view>
				</view>
				<!-- #endif -->
				<!-- #ifdef MP-WEIXIN -->
				<view v-if="optsVisible" class="lh-cap-opts lh-cap-opts--show">
					<view class="lh-cap-opts-btn" hover-class="app-pressed-text" :hover-stay-time="100"
						@click="refresh(false)">
						<uni-icons class="lh-cap-opts-icon" type="refreshempty" />
					</view>
					<view class="lh-cap-opts-btn lh-cap-opts-btn--end" hover-class="app-pressed-text" :hover-stay-time="100"
						@click="close()">
						<uni-icons class="lh-cap-opts-icon" type="closeempty" />
					</view>
				</view>
				<!-- #endif -->

				<!-- 切换期间中央 loading：滑出完成且响应未到才显示，数据到进 in 相位即藏 -->
				<view v-if="slidePhase === 'waiting'" class="lh-cap-switch-loading">
					<app-loading :size="24" />
					<text class="lh-cap-zone-text">正在加载...</text>
				</view>

				<!-- 内容裁切层：overflow 收在 padding 内缘，滑出/滑入的内容碰边即消失 -->
				<view class="lh-cap-clip">
					<!-- 加载 / 错误 -->
					<view v-if="captchaLoading" class="lh-cap-zone">
						<app-loading :size="24" />
						<text class="lh-cap-zone-text">加载中...</text>
					</view>
					<!-- view 承担居中，点击挂外层 -->
					<view v-else-if="loadingError" class="lh-cap-error" @click="refresh(false)">
						<text class="lh-cap-error-text">{{ loadingError }}，点击重试</text>
					</view>

					<!-- 工作量证明（POW）：滑动→挖矿（钮变 spinner）→彩带结果；:key 换码重建 -->
					<!-- 静态 style 起点 -288：App/Web 由 setProperty 直驱；微信端由 :style 三态覆盖（见 slideStyleMp） -->
					<view v-else-if="type === 'POW'" :key="'pow-' + captchaId" class="lh-cap-pow"
						style="transform: translateX(-288px)" :class="slideStyleMp" ref="contentEl">
						<text class="lh-cap-tip">安全校验</text>
						<view class="lh-cap-track">
							<!-- 层序（低→高）：色带 < 轨道文案 < 圆钮，按 DOM 序定层级；色带与圆钮同值直驱 -->
							<view v-if="powPhase !== 'success' && powPhase !== 'fail'" class="lh-cap-track-fill" ref="powFillEl" :style="themeBg"></view>
							<text class="lh-cap-track-text">{{ powTrackText }}</text>
							<!-- 结果彩带：从左向右铺满轨道，文案铺满后淡入 -->
							<view v-if="powPhase === 'success' || powPhase === 'fail'"
								class="lh-cap-ribbon" :class="powPhase === 'success' ? 'lh-cap-ribbon-ok' : 'lh-cap-ribbon-no'">
								<text class="lh-cap-ribbon-text">{{ powPhase === 'success' ? powSuccessMsg : powFailMsg }}</text>
							</view>
							<view class="lh-cap-unit" ref="powUnitEl" @touchstart="onPowTouchStart"
								@touchmove="onPowTouchMove" @touchend="onPowTouchEnd" @touchcancel="onPowTouchCancel">
								<!-- 结果期彩带铺满轨道，滑块随之隐藏 -->
								<view v-if="powPhase !== 'success' && powPhase !== 'fail'" class="lh-cap-unit-thumb" :style="themeBg">
									<app-loading v-if="powPhase === 'mining'" :size="20" color="#ffffff" />
									<uni-icons v-else class="lh-cap-unit-thumb-icon" type="arrow-right" />
								</view>
							</view>
						</view>
					</view>

						<!-- 图形四类型；:key 换码重建防 transform 残留 -->
						<view v-else :key="'graphic-' + captchaId" class="lh-cap-graphic"
							style="transform: translateX(-288px)" :class="slideStyleMp" ref="contentEl">
						<text class="lh-cap-tip">{{ type === 'WORD_IMAGE_CLICK' ? '请依次点击文字' : '拖动滑块完成拼图' }}</text>
						<view v-if="type === 'WORD_IMAGE_CLICK'" class="lh-cap-click-tips">
							<image class="lh-cap-click-hint" :src="sliderImage" mode="scaleToFill" />
						</view>
						<view class="lh-cap-image-wrap">
							<image class="lh-cap-image" :src="backgroundImage" mode="scaleToFill" />
							<!-- 拼接：overflow hidden 窗口 + 整图平移 -->
							<view v-if="type === 'CONCAT'" key="concat" class="lh-cap-concat" :style="{ height: concatHeight + 'px' }">
								<view class="lh-cap-concat-strip" ref="sliderEl">
									<image class="lh-cap-concat-img" :src="backgroundImage" mode="scaleToFill" />
									<image class="lh-cap-concat-img" :src="backgroundImage" mode="scaleToFill" />
								</view>
							</view>
							<view v-else-if="type === 'ROTATE'" key="rotate" class="lh-cap-rotate-box">
								<image class="lh-cap-rotate-img" ref="sliderEl" :style="{ width: (pieceWidth || 180) + 'px' }"
									:src="sliderImage" mode="scaleToFill" @load="onPieceLoad" />
							</view>
							<view v-else-if="type === 'SLIDER'" key="slider" class="lh-cap-slider" ref="sliderEl">
								<image class="lh-cap-slider-img" :style="{ width: (pieceWidth || 180) + 'px' }"
									:src="sliderImage" mode="scaleToFill" @load="onPieceLoad" />
							</view>
							<!-- 结果横条：仅点选（无轨道）沿用图片底部滑入形态 -->
							<view v-if="showResult && type === 'WORD_IMAGE_CLICK'" class="lh-cap-status"
								:class="resultOk ? 'lh-cap-status-ok' : 'lh-cap-status-no'">
								<text class="lh-cap-status-text">{{ resultMsg }}</text>
							</view>
							<!-- 点选蒙层：touchend 取坐标（click 事件无可靠坐标） -->
							<view v-if="type === 'WORD_IMAGE_CLICK'" id="lh-cap-click-mask" class="lh-cap-click-mask" @touchend="onMaskTap">
								<view v-for="(item, index) in trackArr" :key="index" class="lh-cap-click-dot"
									:style="{ left: item.x - 13 + 'px', top: item.y - 13 + 'px', backgroundColor: capTheme || '' }">
									<text class="lh-cap-click-dot-text">{{ index + 1 }}</text>
								</view>
							</view>
						</view>
						<view v-if="type !== 'WORD_IMAGE_CLICK'" class="lh-cap-track">
							<view v-if="!showResult" class="lh-cap-track-fill" ref="dragFillEl" :style="themeBg"></view>
							<text class="lh-cap-track-text">{{ verifying ? '正在验证...' : TRACK_PLACEHOLDER }}</text>
							<!-- 结果彩带：从左向右铺满轨道，文案铺满后淡入 -->
							<view v-if="showResult" class="lh-cap-ribbon" :class="resultOk ? 'lh-cap-ribbon-ok' : 'lh-cap-ribbon-no'">
								<text class="lh-cap-ribbon-text">{{ resultMsg }}</text>
							</view>
							<view class="lh-cap-unit" ref="dragUnitEl" @touchstart="onDragStart"
								@touchmove="onDragMove" @touchend="onDragEnd" @touchcancel="onDragCancel">
								<!-- 结果期彩带铺满轨道，滑块随之隐藏 -->
								<view v-if="!showResult" class="lh-cap-unit-thumb" :style="themeBg">
									<app-loading v-if="verifying" :size="20" color="#ffffff" />
									<uni-icons v-else class="lh-cap-unit-thumb-icon" type="arrow-right" />
								</view>
							</view>
						</view>
					</view>
				</view>

				<!-- 校验期间透明阻断层 -->
				<view v-if="verifying" class="lh-cap-freeze" @touchmove="onFreezeTouchMove"></view>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	// 验证码组件：业务页直接挂载，<Captcha ref @success> + captchaRef.open()，四端同一条路径。
	// 压暗交给 app-mask（页面内层 + 导航栏/tabBar 原生条带）；本组件只出全屏浮层与卡片。
	// 文件分工：captcha-context 共享状态；captcha-platform 与 platform/ 滑切写层；captcha-card 开关与任务清理；captcha-flow 取码滑切、提交与刷新；captcha-measure 量测；captcha-drag 触摸与直驱。
	import AppMask from '@/components/app-mask/index.uvue'
	import AppLoading from '@/components/app-loading/index.uvue'
	import { useThemeStore } from '@/stores/theme'
	// #ifdef MP-WEIXIN
	import { createPlatform } from './platform/mp'
	// #endif
	// #ifndef MP-WEIXIN
	import { createPlatform } from './platform/app'
	// #endif
	import { createCaptchaCard } from './captcha-card'
	import { createCaptchaContext } from './captcha-context'
	import { createCaptchaDrag } from './captcha-drag'
	import { createCaptchaFlow } from './captcha-flow'
	import { createCaptchaMeasure } from './captcha-measure'

	const props = defineProps<{
		// 主题色覆盖双值（css color）：亮色态/暗色态各一，缺省该态回落全局 token var(--std-primary)
		themeLight ?: string
		themeDark ?: string
	}>()

	// 主题覆盖当前值：按亮暗取对应 prop，未传回落空串（class 内 token 接管）
	const themeStore = useThemeStore()
	themeStore.init()
	const capTheme = computed(() : string => {
		return themeStore.isDark ? (props.themeDark ?? '') : (props.themeLight ?? '')
	})
	// 对象语法 style 绑定
	const themeBg = computed(() : any => capTheme.value ? { backgroundColor: capTheme.value } : {})

	const emit = defineEmits<{
		(e : 'success', id : string) : void
	}>()

	// 共享状态与各职责模块：模块之间只经 ctx 互调
	const ctx = createCaptchaContext(props, emit)
	ctx.platform = createPlatform(ctx)
	ctx.card = createCaptchaCard(ctx)
	ctx.measure = createCaptchaMeasure(ctx)
	ctx.drag = createCaptchaDrag(ctx)
	ctx.flow = createCaptchaFlow(ctx)

	// 模板绑定：只别名模板要用的；普通状态一律经 ctx 读写
	const { visible, entered, slidePhase, captchaLoading, loadingError, type, captchaId, backgroundImage, sliderImage, concatHeight, pieceWidth, powPhase, powSuccessMsg, powFailMsg, showResult, resultOk, resultMsg, trackArr, verifying, sizeClass, optsVisible, powTrackText, TRACK_PLACEHOLDER, contentEl, powUnitEl, powFillEl, dragUnitEl, dragFillEl, sliderEl } = ctx
	const { slideStyleMp } = ctx.platform
	const { open, close } = ctx.card
	const { refresh } = ctx.flow
	const { onPieceLoad } = ctx.measure
	const { onPowTouchStart, onPowTouchMove, onPowTouchEnd, onPowTouchCancel, onDragStart, onDragMove, onDragEnd, onDragCancel, onMaskTap } = ctx.drag

	// 遮罩/阻断层滚动拦截（x 端 touch 修饰符不可靠，须回调内手动调用）
	const onMaskTouchMove = (e : TouchEvent) => {
		e.stopPropagation()
		e.preventDefault()
	}

	const onFreezeTouchMove = (e : TouchEvent) => {
		e.stopPropagation()
		e.preventDefault()
	}

	onMounted(() => {
		// #ifdef APP || WEB
		ctx.ownerPage = getCurrentInstance()?.proxy?.$page ?? null
		// #endif
		// #ifdef MP-WEIXIN
		// 组件挂业务页：缓存组件实例供量测
		ctx.ownerInstance = getCurrentInstance()?.proxy ?? null
		// #endif
	})

	onUnmounted(() => {
		ctx.card.stopJobs()
	})

	defineExpose({ open, close })
</script>

<style lang="scss">
	/* 按压类（styles/press.scss） */
	@import '@/styles/press.scss';

	/* 全屏浮层：拦截触摸、居中卡片；压暗交给 app-mask，本层不画背景 */
	.lh-cap-mask {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1000;
		justify-content: center;
		align-items: center;
		opacity: 0;
		transition: opacity 200ms ease-out;
	}

	.lh-cap-mask--in {
		opacity: 1;
	}

	.lh-cap-card {
		position: relative;
		width: 320px;
		border-radius: var(--std-radius);
		background-color: var(--std-emphasis-bg);
		/* 浮层软影 */
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
		padding: var(--std-gap-lg);
		overflow: hidden;
		transform: scale(0.92);
		transition: height 300ms ease, transform 250ms ease-out;
	}

	.lh-cap-card--in {
		transform: scale(1);
	}

	.lh-cap-card--loading {
		height: 298px;
	}

	.lh-cap-card--graphic {
		height: 298px;
	}

	.lh-cap-card--pow {
		height: 136px;
	}

	/* POW↔图形高度过渡：keyframes 显式起止，a/b 双 class 交替保证每次必变；播完摘除 */
	.lh-cap-h-shrink-a {
		animation: lh-cap-h-shrink-a 100ms ease forwards;
	}

	.lh-cap-h-shrink-b {
		animation: lh-cap-h-shrink-b 100ms ease forwards;
	}

	.lh-cap-h-grow-a {
		animation: lh-cap-h-grow-a 100ms ease forwards;
	}

	.lh-cap-h-grow-b {
		animation: lh-cap-h-grow-b 100ms ease forwards;
	}

	@keyframes lh-cap-h-shrink-a {
		from {
			height: 298px;
		}

		to {
			height: 136px;
		}
	}

	@keyframes lh-cap-h-shrink-b {
		from {
			height: 298px;
		}

		to {
			height: 136px;
		}
	}

	@keyframes lh-cap-h-grow-a {
		from {
			height: 136px;
		}

		to {
			height: 298px;
		}
	}

	@keyframes lh-cap-h-grow-b {
		from {
			height: 136px;
		}

		to {
			height: 298px;
		}
	}

	/* 右上操作区：显式置顶（高于阻断层 z10），校验期间刷新/关闭仍可点 */
	.lh-cap-opts {
		position: absolute;
		/* 44px 热区盒中心与 title 行中心对齐；icon 距卡片右缘 16px */
		top: 4px;
		right: 4px;
		z-index: 20;
		flex-direction: row;
		align-items: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 200ms ease;
	}

	.lh-cap-opts--show {
		opacity: 1;
		pointer-events: auto;
	}

	/* App/Web 滑入：keyframes 插入即播（from 与静态 style 起点一致） */
	.lh-cap-slide-in {
		animation: lh-cap-slide-in 300ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	@keyframes lh-cap-slide-in {
		from {
			transform: translateX(-288px);
		}

		to {
			transform: translateX(0);
		}
	}

	/* #ifdef MP-WEIXIN */
	/* 微信端滑切位移：keyframes 声明即播（见 slideStyleMp）；from=静态起点，forwards 保终态 */
	.lh-cap-mp-out {
		animation: lh-cap-mp-out 300ms ease-out forwards;
	}

	.lh-cap-mp-in {
		animation: lh-cap-mp-in 300ms ease-out forwards;
	}

	@keyframes lh-cap-mp-out {
		from {
			transform: translateX(0);
		}

		to {
			transform: translateX(288px);
		}
	}

	@keyframes lh-cap-mp-in {
		from {
			transform: translateX(-288px);
		}

		to {
			transform: translateX(0);
		}
	}
	/* #endif */

	/* 点击热区容器（icon 本体不带事件） */
	.lh-cap-opts-btn {
		width: 44px;
		height: 44px;
		/* uvue view 默认 flex-direction: column，水平偏移须显式 row */
		flex-direction: row;
		align-items: center;
		/* 44px 热区盒重叠 12px，重叠带按刷新处理（z 序刷新在上）；icon 盒内居中 */
		justify-content: center;
		margin-right: -12px;
		z-index: 1;
	}

	.lh-cap-opts-btn--end {
		margin-right: 0;
		z-index: 0;
	}

	.lh-cap-opts-icon {
		font-size: 20px;
		color: var(--std-fourth-color);
	}

	/* 中央区（loading / POW 结果） */
	.lh-cap-zone {
		flex: 1;
		justify-content: center;
		align-items: center;
	}

	.lh-cap-zone-text {
		margin-top: var(--std-gap-sm);
		font-size: 14px;
		color: var(--std-secondary-color);
	}

	.lh-cap-error {
		flex: 1;
		justify-content: center;
		align-items: center;
	}

	.lh-cap-error-text {
		font-size: 14px;
		color: #f56c6c;
	}

	/* POW */
	/* 内容裁切层：padding 内缘裁切，层级高于切换 loading(z1) */
	.lh-cap-clip {
		flex: 1;
		position: relative;
		z-index: 2;
		overflow: hidden;
	}

	.lh-cap-pow {
		flex: 1;
		transition: transform 300ms ease-out;
	}

	/* 轨道结果彩带：从左向右铺满，文案铺满后淡入；右端 20px 圆头与轨道右端圆弧贴合 */
	.lh-cap-ribbon {
		position: absolute;
		top: 0;
		left: 0;
		height: 40px;
		width: 0;
		border-radius: 0 20px 20px 0;
		justify-content: center;
		align-items: center;
		animation: lh-cap-ribbon 250ms ease-out forwards;
	}

	.lh-cap-ribbon-ok {
		background-color: #5ac725;
	}

	.lh-cap-ribbon-no {
		background-color: #f56c6c;
	}

	.lh-cap-ribbon-text {
		font-size: var(--std-text-sm);
		color: #ffffff;
		opacity: 0;
		animation: lh-cap-ribbon-text 300ms ease 250ms forwards;
	}

	@keyframes lh-cap-ribbon {
		from {
			width: 0;
		}

		to {
			width: 288px;
		}
	}

	@keyframes lh-cap-ribbon-text {
		to {
			opacity: 1;
		}
	}

	/* 图形类 */
	.lh-cap-graphic {
		flex: 1;
		transition: transform 300ms ease-out;
	}

	/* 刷新滑切：位移全程 setProperty 直驱+transition；起点=容器静态 style 属性 -288 */

	/* 层级（低→高）：卡片背景 < 切换 loading(z1) < 验证码内容模块(z2)——滑出/滑入的内容从 loading 上层划过 */
	.lh-cap-switch-loading {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		flex-direction: column;
		z-index: 1;
		justify-content: center;
		align-items: center;
		z-index: 15;
	}

	.lh-cap-tip {
		font-size: 15px;
		font-weight: bold;
		color: var(--std-secondary-color);
		/* 上与左右=padding 16，下 12（内容总高不变） */
		margin: 0 0 var(--std-gap-md) var(--std-gap-xs);
	}

	.lh-cap-click-tips {
		flex-direction: row;
		align-items: center;
		margin-bottom: var(--std-gap-sm);
	}

	.lh-cap-click-hint {
		width: 168px;
		height: 32px;
	}

	.lh-cap-image-wrap {
		width: 288px;
		height: 180px;
		border-radius: 6px;
		overflow: hidden;
		position: relative;
	}

	.lh-cap-image {
		width: 288px;
		height: 180px;
	}

	.lh-cap-concat {
		position: absolute;
		top: 0;
		left: 0;
		width: 288px;
		overflow: hidden;
	}

	/* 平铺条：双图并排首尾相接，translateX(x-288) 滚动 */
	.lh-cap-concat-strip {
		flex-direction: row;
		width: 576px;
		height: 180px;
		transform: translateX(-288px);
	}

	.lh-cap-concat-img {
		width: 288px;
		height: 180px;
	}

	/* SLIDER 拼图块：absolute 左起，高 180 宽自然（heightFix），拖动 translateX 驱动 */
	.lh-cap-slider {
		position: absolute;
		top: 0;
		left: 0;
		height: 180px;
	}

	.lh-cap-slider-img {
		height: 180px;
	}

	/* ROTATE 圆盘：容器铺满图片区双向居中，rotate 绕背景缺口中心 */
	.lh-cap-rotate-box {
		position: absolute;
		top: 0;
		left: 0;
		width: 288px;
		height: 180px;
		justify-content: center;
		align-items: center;
	}

	.lh-cap-rotate-img {
		height: 180px;
	}



	/* 结果横条（图形类，图片区底部）：层级高于点选序号/蒙层与阻断层；自然态=上滑动画起点 */
	.lh-cap-status {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 288px;
		height: 24px;
		justify-content: center;
		align-items: center;
		z-index: 11;
		transform: translateY(24px);
		animation: lh-cap-status-up 200ms ease-out forwards;
	}

	@keyframes lh-cap-status-up {
		to {
			transform: translateY(0);
		}
	}

	.lh-cap-status-ok {
		background-color: #5ac725;
	}

	.lh-cap-status-no {
		background-color: #f56c6c;
	}

	.lh-cap-status-text {
		font-size: 12px;
		color: #ffffff;
	}

	/* 点选蒙层与序号气泡 */
	.lh-cap-click-mask {
		position: absolute;
		top: 0;
		left: 0;
		width: 288px;
		height: 180px;
	}

	.lh-cap-click-dot {
		position: absolute;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background-color: var(--std-primary);
		border: 2px solid rgba(255, 255, 255, 0.6);
		justify-content: center;
		align-items: center;
	}

	.lh-cap-click-dot-text {
		font-size: 14px;
		color: #ffffff;
	}

	/* 拖动轨道 */
	.lh-cap-track {
		width: 288px;
		height: 40px;
		margin-top: var(--std-gap-md);
		border-radius: var(--std-radius-full);
		background-color: var(--std-active-bg);
		position: relative;
		overflow: hidden;
	}

	/* 一体拖动元素：圆钮容器兼触摸热区（色带已分层到文案下），translateX 与色带同值直驱 */
	.lh-cap-unit {
		position: absolute;
		top: 0;
		left: 0;
		width: 328px;
		height: 40px;
		transform: translateX(-288px);
	}

	/* 色带层：轨道直接子节点、文案下层，延伸至圆钮右缘下；初始藏轨道左外，与圆钮同值直驱 */
	.lh-cap-track-fill {
		position: absolute;
		top: 0;
		left: 0;
		width: 328px;
		height: 40px;
		background-color: var(--std-primary);
		opacity: 0.5;
		border-radius: 0 20px 20px 0;
		transform: translateX(-288px);
	}

	.lh-cap-unit-thumb {
		position: absolute;
		top: 0;
		left: 288px;
		width: 40px;
		height: 40px;
		border-radius: var(--std-radius-full);
		background-color: var(--std-primary);
		justify-content: center;
		align-items: center;
	}

	.lh-cap-unit-thumb-icon {
		font-size: 18px;
		color: rgba(255, 255, 255, 0.9);
	}

	.lh-cap-track-text {
		position: absolute;
		top: 0;
		left: 0;
		width: 288px;
		height: 40px;
		line-height: 40px;
		text-align: center;
		font-size: var(--std-text-sm);
		/* 色带划过时文字压在半透明主题色上，用次级灰保对比（fourth 灰叠色带上对比度 1.03 近隐形） */
		color: var(--std-secondary-color);
	}

	/* 校验阻断层 */
	.lh-cap-freeze {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 10;
	}

	/* 暗色：token 引用自动适配，验证码专属色双值覆盖 */
	@media (prefers-color-scheme: dark) {
	.lh-cap-status-ok {
		background-color: #306317;
	}

	.lh-cap-status-no {
		background-color: #7e2e2f;
	}

	.lh-cap-ribbon-ok {
		background-color: #306317;
	}

	.lh-cap-ribbon-no {
		background-color: #7e2e2f;
	}

	/* 点选圈描边：暗色换中性灰阶且半透明 */
	.lh-cap-click-dot {
		border-color: rgba(74, 77, 82, 0.6);
	}


	}
