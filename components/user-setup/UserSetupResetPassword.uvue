<template>
	<view class="setup-step">
		<view class="setup-step-header">
			<uni-icons class="setup-icon" type="locked" />
			<text class="setup-title">安全</text>
			<text class="setup-desc">为了确保您的账号安全，请修改密码</text>
		</view>
		<scroll-view class="setup-step-body" :bounces="false" :show-scrollbar="false">
			<view class="setup-form">
			<view class="setup-field">
				<app-input shape="round" :height="45" placeholder="请输入旧密码" password :maxlength="30" clearable
					v-model="password.oldPassword" />
			</view>
			<view class="setup-field">
				<app-input ref="pwdInputRef" shape="round" :height="45" placeholder="请输入新密码" password showStrength
					:maxlength="30" clearable v-model="password.newPassword" @focus="remeasureStrength" />
			</view>
			<view class="setup-field">
				<app-input shape="round" :height="45" placeholder="请再次输入密码" password :maxlength="30" clearable
					v-model="password.confirmPassword" />
			</view>
		</view>
		</scroll-view>
		<view class="setup-step-footer">
			<view class="setup-btns">
				<button class="setup-btn" type="primary" :loading="saveLoading" @click="handleNext">下一步</button>
				<view class="setup-sub-btns">
					<text class="setup-ghost-btn" @click="handlePrev">上一步</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	// 安全步：改密（旧密码校验 + 新密码强度条 + 两次一致），成功同步记住的密码
	import { toast, toastRequestError } from '@/utils/toast'
	import { updateRememberedPassword } from '@/helpers/remember'
	import { updatePassword } from '@/api/system/profile/profile'
	import type { passwordType } from '@/api/system/profile/type/password-type'
	import AppInput from '@/components/app-input/app-input.uvue'

	const emit = defineEmits<{next: [], prev: []}>()

	const password = reactive<passwordType>({
		oldPassword: '',
		newPassword: '',
		confirmPassword: ''
	})

	const saveLoading = ref<boolean>(false)

	// 强度条 fixed 定位坐标在挂载时量测；步进轨道常驻挂载下本步彼时在屏外（坐标无效），
	// 聚焦（输入前置动作）时该步必在屏内，触发重量测
	const pwdInputRef = ref()
	const remeasureStrength = () => {
		pwdInputRef.value?.remeasure()
	}

	const handleNext = async () => {
		if (!checkPasswordData()) {
			return
		}
		try {
			saveLoading.value = true
			const resp = await updatePassword(password)
			if (resp.code === 200) {
				// 改密成功后同步记住的密码，避免下次自动填充旧密码
				updateRememberedPassword(password.newPassword)
				resetForm()
				emit('next')
			} else {
				toast(resp.msg)
			}
		} catch (err) {
			console.error(err)
			toastRequestError(err)
		} finally {
			saveLoading.value = false
		}
	}

	// 离开本步前清空表单：强度条是 fixed 页面根级定位（不随步进轨道滑动），值清空才会隐藏；
	// 改密成功后旧密码已失效，密码步不留存输入
	const resetForm = () => {
		password.oldPassword = ''
		password.newPassword = ''
		password.confirmPassword = ''
	}

	const handlePrev = () => {
		resetForm()
		emit('prev')
	}

	// 密码完整性校验（规则与设置页改密一致）
	const checkPasswordData = () => {
		const {oldPassword, newPassword, confirmPassword} = password

		if (!oldPassword) {
			toast("请输入旧密码")
			return false
		}

		if (!newPassword) {
			toast("请输入新密码")
			return false
		}

		if (!(newPassword.length >= 6 && newPassword.length <= 30)) {
			toast("密码长度6-30位")
			return false
		}

		if (newPassword !== confirmPassword) {
			toast("两次密码不一致")
			return false
		}
		return true
	}
</script>

<style lang="scss">
@import "@/styles/user-setup.scss";
</style>
