<template>
	<view class="app-steps-viewport">
		<!-- 内容经插槽常驻挂载（状态保留），槽宽由调用方按 1/count 给定 -->
		<view class="app-steps-track" :style="trackStyle" ref="trackEl">
			<slot />
		</view>
	</view>
</template>

<script setup lang="ts">
	// 通用步进容器：translateX 驱动的横向轨道，current 受控，按钮是唯一驱动方式（无手势翻页）
	const props = defineProps<{
		current: number
		count: number
	}>()

	const trackEl = ref<UniElement | null>(null)
	const windowWidth = uni.getWindowInfo().windowWidth

	// 轨道 :style：MP 端由此驱动位移；蒸汽端 transform 走 setProperty 直驱，此处只出宽度
	const trackStyle = computed(() : any => {
		// #ifndef APP || WEB
		return { width: (windowWidth * props.count) + 'px', transform: 'translateX(' + -(props.current * windowWidth) + 'px)' }
		// #endif
		// #ifdef APP || WEB
		return { width: (windowWidth * props.count) + 'px' }
		// #endif
	})

	// 蒸汽端直驱（transition 挂 CSS）
	// #ifdef APP || WEB
	watch(() => props.current, (val) => {
		trackEl.value?.style.setProperty('transform', `translateX(${-(val * windowWidth)}px)`)
	})
	// #endif
</script>

<style lang="scss">
	.app-steps-viewport {
		flex: 1;
		overflow: hidden;
	}

	.app-steps-track {
		flex-direction: row;
		height: 100%;
		transition-property: transform;
		transition-duration: 300ms;
		transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
	}
</style>
